load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
)

rust_library(
    name = "serviceradar_media_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "serviceradar_media_core",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ),
)

rust_test(
    name = "serviceradar_media_core_test",
    crate = ":serviceradar_media_core",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ),
)
