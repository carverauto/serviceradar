load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//third_party/crates:defs.bzl", "all_crate_deps")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "metrics_delta_writer_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "serviceradar_metrics_delta_writer",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//rust/metric-proto:serviceradar_metric_proto",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "metrics_delta_writer_bin",
    srcs = ["src/main.rs"],
    crate_name = "serviceradar_metrics_delta_writer",
    edition = "2024",
    deps = [
        ":metrics_delta_writer_lib",
        "//rust/metric-proto:serviceradar_metric_proto",
    ] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "metrics_protobuf_bench_bin",
    srcs = ["src/bin/metrics_protobuf_bench.rs"],
    crate_name = "metrics_protobuf_bench",
    edition = "2024",
    deps = [
        ":metrics_delta_writer_lib",
        "//rust/metric-proto:serviceradar_metric_proto",
    ] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "metrics_delta_writer_test",
    crate = ":metrics_delta_writer_lib",
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//rust/metric-proto:serviceradar_metric_proto",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)
