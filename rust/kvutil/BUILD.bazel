load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//third_party/crates:defs.bzl", "all_crate_deps", "crate_deps")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    deps = crate_deps(["tonic-prost-build"]),
    data = [
        "//proto:kv_proto_src",
    ],
    build_script_env = {
        "PROTOC": "$(execpath @bazel_tools//tools/proto:protoc)",
    },
    tools = ["@bazel_tools//tools/proto:protoc"],
)

rust_library(
    name = "kvutil",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True) + [":build_script"],
    data = ["//proto:kv_proto_src"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "kvutil_test",
    crate = ":kvutil",
)
