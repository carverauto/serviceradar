load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//third_party/crates:defs.bzl", "all_crate_deps")

package(default_visibility = ["//visibility:public"])

# Built as a hermetic Bazel target on the locally vendored crates (//third_party/crates)
# — replaces the former cargo-in-genrule, which invoked `cargo build` and failed under
# Bazel's sandbox trying to download crates into ~/.cargo.
rust_binary(
    name = "serviceradar-bmp-collector",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Back-compat alias: docker/images + build/packaging reference
# //rust/bmp-collector:bmp-collector.
alias(
    name = "bmp-collector",
    actual = ":serviceradar-bmp-collector",
)

rust_test(
    name = "bmp_collector_test",
    crate = ":serviceradar-bmp-collector",
)
