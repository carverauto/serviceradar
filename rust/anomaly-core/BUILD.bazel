load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rust_crates//:defs.bzl", "all_crate_deps")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "serviceradar_anomaly_core",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    crate_name = "serviceradar_anomaly_core",
    crate_root = "src/lib.rs",
    edition = "2024",
    # deep_causality_core + deep_causality_data_structures. The `rustler` feature is
    # off by default, so its optional proc-macro dep is not pulled into this target.
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "anomaly-backtest",
    srcs = ["src/bin/anomaly-backtest.rs"],
    crate_root = "src/bin/anomaly-backtest.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [":serviceradar_anomaly_core"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "serviceradar_anomaly_core_test",
    crate = ":serviceradar_anomaly_core",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)
