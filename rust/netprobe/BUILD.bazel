load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rust_crates//:defs.bzl", "crate_deps")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    edition = "2021",
    deps = crate_deps(["prost-build"]),
    data = [
        "//proto/agent/netprobe/v1:netprobe_proto_src",
    ],
    build_script_env = {
        "PROTOC": "$(execpath @bazel_tools//tools/proto:protoc)",
    },
    tools = ["@bazel_tools//tools/proto:protoc"],
)

rust_binary(
    name = "netprobe",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps([
        "anyhow",
        "clap",
        "env_logger",
        "log",
        "nix",
        "prometheus",
        "prost",
        "serde",
        "serde_json",
        "thiserror",
        "tokio",
    ]) + [
        ":build_script",
    ],
)
