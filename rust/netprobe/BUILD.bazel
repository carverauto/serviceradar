load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build/rbe:exec_properties.bzl", "NATIVE_ADDON_EXEC_PROPERTIES")
load("//third_party/crates:defs.bzl", "crate_deps")

package(default_visibility = ["//visibility:public"])

NETPROBE_FEATURES = select({
    "//build/platforms:target_linux_aarch64_musl": [],
    "//build/platforms:target_linux_x86_64_musl": [],
    "//conditions:default": [],
})

NETPROBE_DEPS = crate_deps([
    "anyhow",
    "clap",
    "crossbeam-channel",
    "env_logger",
    "etherparse",
    "libc",
    "log",
    "nix",
    "phf",
    "prometheus",
    "prost",
    "quick-xml",
    "regex-automata",
    "serde",
    "serde_json",
    "sha2",
    "thiserror",
    "tokio",
]) + select({
    "//build/platforms:target_linux_aarch64_musl": crate_deps([
        "aya",
        "aya-log",
        "procfs",
    ]),
    "//build/platforms:target_linux_x86_64_musl": crate_deps([
        "aya",
        "aya-log",
        "procfs",
    ]),
    "//build/platforms:target_linux_arm64": crate_deps([
        "aya",
        "aya-log",
        "procfs",
    ]),
    "//build/platforms:target_linux_x86_64": crate_deps([
        "aya",
        "aya-log",
        "procfs",
    ]),
    "//conditions:default": [],
}) + [":build_script"]

NETPROBE_RUSTC_FLAGS = select({
    "//build/platforms:target_linux_aarch64_musl": [],
    "//build/platforms:target_linux_x86_64_musl": [],
    "//build/platforms:target_linux_arm64": [
        "-C",
        "link-arg=-Wl,--disable-new-dtags",
    ],
    "//build/platforms:target_linux_x86_64": [
        "-C",
        "link-arg=-Wl,--disable-new-dtags",
    ],
    "//conditions:default": [],
})

NETPROBE_VERSION = "0.2.28"

cargo_build_script(
    name = "build_script",
    srcs = [
        "build.rs",
        "src/p0f_corpus.rs",
    ],
    build_script_env = {
        "PROTOC": "$(execpath @bazel_tools//tools/proto:protoc)",
    },
    crate_root = "build.rs",
    data = [
        "//proto/agent/netprobe/v1:netprobe_proto_src",
        "//third_party/netprobe_corpora:p0f/p0f.fp",
        "//third_party/netprobe_corpora:p0f/serviceradar-additions.fp",
        "//third_party/netprobe_corpora:recog/serviceradar-recog-additions.xml",
        "//third_party/netprobe_corpora:recog_xml",
    ],
    tools = ["@bazel_tools//tools/proto:protoc"],
    deps = crate_deps([
        "aya-build",
        "phf_codegen",
        "prost-build",
        "quick-xml",
    ]),
)

rust_binary(
    name = "netprobe",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "//third_party/netprobe_corpora:p0f/p0f.fp",
        "//third_party/netprobe_corpora:p0f/serviceradar-additions.fp",
        "//third_party/netprobe_corpora:recog/serviceradar-recog-additions.xml",
        "//third_party/netprobe_corpora:recog_xml",
    ],
    crate_features = NETPROBE_FEATURES,
    crate_root = "src/main.rs",
    exec_properties = NATIVE_ADDON_EXEC_PROPERTIES,
    rustc_flags = NETPROBE_RUSTC_FLAGS,
    version = NETPROBE_VERSION,
    deps = NETPROBE_DEPS,
)

# Unit tests: `crate` inherits the binary's srcs/deps/features/rustc_flags/compile_data,
# so they cannot drift from //rust/netprobe:netprobe. Only test-only extras are here.
rust_test(
    name = "netprobe_test",
    crate = ":netprobe",
    data = ["//third_party/netprobe_corpora:satori_xml"],
    deps = crate_deps(["tempfile"]),
)

###############################################################################
# Static musl linkage gates
#
# Was the "Verify static linkage" step of .forgejo/workflows/rust-musl.yml: a `bazel build`
# with --platforms, then `bazel cquery --output=files | tail -n 1` to locate the artifact,
# then shell assertions over it, plus scripts/ci/assert-netprobe-libpcap-free.sh.
#
# As targets the binary is a declared input rather than something recovered from a cquery
# expression, so the assertions run under a plain `bazel test //...`, cache like any other
# test, and cannot drift from the thing they check.
#
# The platform transition is what makes this work without --platforms on the command line.
# //rust/netprobe:netprobe under the default RBE platform is a glibc build and would fail
# every one of these checks; platform_transition_filegroup rebuilds it for the musl platform
# named here, so the two test targets below always look at the artifact the release actually
# ships. That is also why there are two: x86_64 and aarch64 are separate builds and a
# regression in one says nothing about the other.
#
# Deliberately NOT ported: the `--help` smoke run that step did for the host architecture
# only. A cross-built aarch64 binary cannot execute on an x86_64 executor, so as a test
# target it would have to be silently skipped on one of the two platforms, which is the
# failure mode this whole change exists to remove. Execution belongs in a test that can
# state its own platform requirement.
###############################################################################
platform_transition_filegroup(
    name = "netprobe_linux_x86_64_musl",
    srcs = [":netprobe"],
    target_platform = "//build/platforms:linux_x86_64_musl",
)

platform_transition_filegroup(
    name = "netprobe_linux_aarch64_musl",
    srcs = [":netprobe"],
    target_platform = "//build/platforms:linux_aarch64_musl",
)

# One test for both architectures. debug/elf parses any ELF regardless of the host, so an
# aarch64 artifact is checked from an x86_64 executor without a second runner. See the file
# header for why this is Go and not the sh_test it started as.
#
# target_compatible_with is about the MUSL BUILD, not the ELF parsing. The transitions above
# need the musl Rust toolchain, which a macOS developer running `bazel test //...` under
# --config=darwin_local cannot resolve; pinning the test to Linux makes that a skip rather
# than a toolchain error. On CI the target platform is the RBE Linux platform, so it runs.
go_test(
    name = "static_linkage_test",
    size = "small",
    srcs = ["static_linkage_test.go"],
    data = [
        ":netprobe_linux_aarch64_musl",
        ":netprobe_linux_x86_64_musl",
    ],
    env = {
        "NETPROBE_AARCH64_MUSL": "$(rootpath :netprobe_linux_aarch64_musl)",
        "NETPROBE_X86_64_MUSL": "$(rootpath :netprobe_linux_x86_64_musl)",
    },
    target_compatible_with = ["@platforms//os:linux"],
)
