load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "PROTOC": "$(execpath @bazel_tools//tools/proto:protoc)",
    },
    crate_root = "build.rs",
    data = [
        "//proto:kv_proto_src",
    ],
    # Restores the execroot as this script's working directory.
    #
    # rules_rs's rules_rust synthesizes CARGO_MANIFEST_DIR as a runfiles directory holding
    # only files from THIS package, and runs the script there. Every proto consumed here
    # comes from another package, so it lands outside that directory and build.rs's
    # execroot-relative path resolves to nothing -- protoc reports "Could not make proto path
    # relative: ... No such file or directory". The feature symlinks the execroot into the
    # manifest dir, which is what build.rs's Bazel branch was written against.
    #
    # Still hermetic: the sandbox holds only declared inputs, so this changes which paths
    # resolve, not which files exist. A build script whose data lives in its own package
    # (//rust/addon-sdk, //rust/powerdns) does not need it.
    features = ["symlink-exec-root"],
    tools = ["@bazel_tools//tools/proto:protoc"],
    deps = ["@crates//:tonic-prost-build"],
)

# Syslog lines with the record JSON mode publishes and the batch the normalizing
# encoder publishes for each. This crate's tests produce it and EventWriter's
# tests in //elixir/serviceradar_core check that both store the same row.
filegroup(
    name = "normalized_log_parity",
    srcs = ["tests/resources/normalized_log_parity.json"],
)

rust_library(
    name = "flowgger_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "gelf",
        "nats-output",
        "passthrough",
        "rfc3164",
        "rfc5424",
        "syslog",
        "tls",
    ],
    crate_name = "flowgger",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//rust/cert-policy:cert_policy",
        "//rust/zen-normalize:zen_normalize",
        ":build_script",
        "@crates//:async-nats",
        "@crates//:base64",
        "@crates//:prost",
    ],
)

rust_test(
    name = "flowgger_lib_test",
    crate = ":flowgger_lib",
    # crate_features are NOT inherited from `crate`; they must mirror flowgger_lib or the
    # test compiles a different crate than the one that ships.
    crate_features = [
        "gelf",
        "nats-output",
        "passthrough",
        "rfc3164",
        "rfc5424",
        "syslog",
        "tls",
    ],
    # Config::from_path tests read these fixtures by relative path.
    data = glob(["tests/resources/*.toml"]) + [
        ":normalized_log_parity",
        "//third_party/binaries:nats_server_linux_amd64",
    ],
    env = {
        # Hegel's CI profile keeps no example database, which a test sandbox cannot write.
        # It also fixes the seed; that is turned off so each run that is not served from
        # the cache tries inputs no run has tried. A failure prints a
        # `#[hegel::reproduce_failure("...")]` line that replays it.
        "HEGEL_DEFAULT_PROFILE": "ci",
        "HEGEL_DERANDOMIZE": "false",
        "HEGEL_TEST_CASES": "1000",
        "NATS_SERVER_BIN": "$(rootpath //third_party/binaries:nats_server_linux_amd64)",
    },
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ),
)

# The Hegel properties over many more inputs than a pull request should wait for. Never
# cached and never part of a wildcard build: the "RustPropertyExploration" workflow in
# //:buildbuddy.yaml runs it on a schedule.
rust_test(
    name = "flowgger_property_exploration_test",
    args = ["props"],
    crate = ":flowgger_lib",
    crate_features = [
        "gelf",
        "nats-output",
        "passthrough",
        "rfc3164",
        "rfc5424",
        "syslog",
        "tls",
    ],
    data = [":normalized_log_parity"],
    env = {
        "HEGEL_DEFAULT_PROFILE": "ci",
        "HEGEL_DERANDOMIZE": "false",
        "HEGEL_TEST_CASES": "2000000",
    },
    timeout = "long",
    tags = [
        "external",
        "manual",
    ],
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ),
)

# The managed certificate policy loader accepts only a root-owned file under
# root-owned directories. flowgger_lib_test skips this case whenever its action
# is not uid 0; this target asks for uid 0, and here a skip is a failure.
rust_test(
    name = "flowgger_managed_policy_test",
    args = ["revoked_broker_certificate_fails_the_publisher"],
    crate = ":flowgger_lib",
    crate_features = [
        "gelf",
        "nats-output",
        "passthrough",
        "rfc3164",
        "rfc5424",
        "syslog",
        "tls",
    ],
    data = ["//third_party/binaries:nats_server_linux_amd64"],
    env = {
        "FLOWGGER_REQUIRE_MANAGED_POLICY_TEST": "1",
        "NATS_SERVER_BIN": "$(rootpath //third_party/binaries:nats_server_linux_amd64)",
    },
    exec_properties = {"test.dockerUser": "0"},
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ),
)
