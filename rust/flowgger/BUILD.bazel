load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//third_party/crates:defs.bzl", "all_crate_deps", "crate_deps")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    deps = crate_deps(["tonic-prost-build"]),
    data = [
        "//proto:kv_proto_src",
    ],
    build_script_env = {
        "PROTOC": "$(execpath @bazel_tools//tools/proto:protoc)",
    },
    tools = ["@bazel_tools//tools/proto:protoc"],
)

rust_library(
    name = "flowgger_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "flowgger",
    crate_features = [
        "gelf",
        "nats-output",
        "passthrough",
        "rfc3164",
        "rfc5424",
        "syslog",
        "tls",
    ],
    deps = all_crate_deps(normal = True) + [
        "//third_party/crates:async-nats",
        ":build_script",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "flowgger_lib_test",
    crate = ":flowgger_lib",
    # Config::from_path tests read these fixtures by relative path.
    data = glob(["tests/resources/*.toml"]),
    # crate_features are NOT inherited from `crate`; they must mirror flowgger_lib or the
    # test compiles a different crate than the one that ships.
    crate_features = [
        "gelf",
        "nats-output",
        "passthrough",
        "rfc3164",
        "rfc5424",
        "syslog",
        "tls",
    ],
    deps = all_crate_deps(normal_dev = True),
)
