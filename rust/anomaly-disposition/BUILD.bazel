load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//third_party/crates:defs.bzl", "all_crate_deps")

# Plain rlib disposition kernel crate. NO cdylib bazel rule: the NIF cdylib is
# built by Rustler during `mix compile`, not bazel (the core-elx app filegroup
# already globs native/**). This `rust_library` exists for non-NIF consumers and
# for the kernel unit tests. The `rustler` feature is OFF here, so the optional
# proc-macro dep is not pulled into this target.
rust_library(
    name = "serviceradar_anomaly_disposition",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    crate_name = "serviceradar_anomaly_disposition",
    crate_root = "src/lib.rs",
    # path-dep on the shared substrate (the sibling bazel target) + deep_causality_core.
    deps = all_crate_deps(normal = True) + [
        "//rust/anomaly-core:serviceradar_anomaly_core",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "serviceradar_anomaly_disposition_test",
    crate = ":serviceradar_anomaly_disposition",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//rust/anomaly-core:serviceradar_anomaly_core",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# End-to-end proof test: drives BOTH engine halves (the agent edge detector in
# //rust/anomaly-core and the core seasonal disposition in this crate) from one
# synthetic scenario, asserting escalate / suppress / clean. Integration test, so it
# links both crate libraries as deps (not `crate = ...`).
rust_test(
    name = "anomaly_e2e_test",
    srcs = ["tests/anomaly_e2e.rs"],
    crate_root = "tests/anomaly_e2e.rs",
    deps = [
        ":serviceradar_anomaly_disposition",
        "//rust/anomaly-core:serviceradar_anomaly_core",
    ],
)
