load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "dgraph_topology",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    crate_name = "dgraph_topology",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + ["//rust/dgraph-migrate:dgraph_migrate"],
)

rust_binary(
    name = "dgraph-migrate",
    srcs = ["src/bin/dgraph-migrate.rs"],
    crate_root = "src/bin/dgraph-migrate.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        ":dgraph_topology",
        "//rust/dgraph-migrate:dgraph_migrate",
    ],
)

rust_test(
    name = "dgraph_topology_test",
    crate = ":dgraph_topology",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "lib_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = ["tests/schema_lifecycle.rs"],
    ),
    crate_root = "tests/lib_tests.rs",
    edition = "2024",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        ":dgraph_topology",
        "//rust/dgraph-migrate:dgraph_migrate",
    ],
)

# Live cluster. `make test` excludes integration_test. Local:
#   cargo test -p dgraph-topology --features integration-tests --test schema_lifecycle
# CI: DGRAPH_TEST_STRATEGY=existing against dgraph-ci, not the demo namespace.
rust_test(
    name = "schema_lifecycle_test",
    srcs = ["tests/schema_lifecycle.rs"],
    crate_features = ["integration-tests"],
    crate_root = "tests/schema_lifecycle.rs",
    edition = "2024",
    tags = ["integration_test"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        ":dgraph_topology",
        "//rust/dgraph-migrate:dgraph_migrate",
    ],
)
