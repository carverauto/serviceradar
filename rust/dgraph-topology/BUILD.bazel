load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "dgraph_topology",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    crate_name = "dgraph_topology",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + ["//rust/dgraph-migrate:dgraph_migrate"],
)

rust_binary(
    name = "dgraph-migrate",
    srcs = ["src/bin/dgraph-migrate.rs"],
    crate_root = "src/bin/dgraph-migrate.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        ":dgraph_topology",
        "//rust/dgraph-migrate:dgraph_migrate",
    ],
)

rust_test(
    name = "dgraph_topology_test",
    crate = ":dgraph_topology",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "lib_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = ["tests/schema_lifecycle.rs"],
    ),
    crate_root = "tests/lib_tests.rs",
    edition = "2024",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        ":dgraph_topology",
        "//rust/dgraph-migrate:dgraph_migrate",
    ],
)

# Existing CI cluster only. The workflow compiles on RBE and runs TestRunner
# beside the fixture, with its typed credential resolved on that runner.
# `external` disables cached success for a namespace lifecycle.
rust_test(
    name = "schema_lifecycle_test",
    timeout = "long",
    srcs = ["tests/schema_lifecycle.rs"],
    crate_root = "tests/schema_lifecycle.rs",
    data = ["//config/environments:ci_binpb"],
    edition = "2024",
    tags = [
        "external",
        "integration_test",
        "manual",
    ],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        ":dgraph_topology",
        "//config/manager_config/rust:manager",
        "//config/manager_secret/rust:secret_manager",
        "//config/proto_bindings/rust:config_schema",
        "//rust/dgraph-migrate:dgraph_migrate",
    ],
)
