load("@rules_rust//rust:defs.bzl", "rust_library")
load("//third_party/crates:defs.bzl", "all_crate_deps")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "serviceradar_causal_context",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "serviceradar_causal_context",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//rust/causal-model:serviceradar_causal_model",
        "//rust/causal-ports:serviceradar_causal_ports",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)
