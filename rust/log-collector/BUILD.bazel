load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "log-collector",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "syslog",
        "otel",
    ],
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//rust/config-bootstrap:config_bootstrap",
        "//rust/flowgger:flowgger_lib",
        "//rust/kvutil",
        "//rust/otel:otel_lib",
        "//rust/zen-normalize:zen_normalize",
    ],
)

rust_test(
    name = "log_collector_test",
    crate = ":log-collector",
    crate_features = [
        "syslog",
        "otel",
    ],
    # The NATS rule bucket reader's tests run a real broker.
    data = ["//third_party/binaries:nats_server_linux_amd64"],
    env = {
        "NATS_SERVER_BIN": "$(rootpath //third_party/binaries:nats_server_linux_amd64)",
    },
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "health_listener_test",
    srcs = ["tests/health_listener.rs"],
    data = [":log-collector"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        "@crates//:rcgen",
        "@crates//:runfiles",
        "@crates//:tempfile",
    ],
)

# Live check of the public /rum/v1/beacon gate: the real collector binary
# against a real JetStream nats-server, driven over TCP.
rust_test(
    name = "rum_live_e2e_test",
    size = "medium",
    srcs = ["tests/rum_live_e2e.rs"],
    data = [
        ":log-collector",
        "@nats_server_linux_amd64//:nats_server",
    ],
    env = {
        "LOG_COLLECTOR_BIN": "$(rlocationpath :log-collector)",
        "NATS_SERVER_BIN": "$(rlocationpath @nats_server_linux_amd64//:nats_server)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//rust/metric-proto:serviceradar_metric_proto",
        "//rust/otel:otel_lib",
        "@crates//:async-nats",
        "@crates//:flate2",
        "@crates//:futures",
        "@crates//:prost",
        "@crates//:runfiles",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
