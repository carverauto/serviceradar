load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# Generates the tonic/prost stubs for the language-agnostic add-on contract.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "PROTOC": "$(execpath @bazel_tools//tools/proto:protoc)",
    },
    crate_root = "build.rs",
    data = [
        "proto/agent/addon/v1/addon.proto",
        "proto/agent/discovery/v1/discovery.proto",
    ],
    tools = ["@bazel_tools//tools/proto:protoc"],
    deps = ["@crates//:tonic-prost-build"],
)

ADDON_SDK_DEPS = [
    "@crates//:anyhow",
    "@crates//:base64",
    "@crates//:hex",
    "@crates//:p521",
    "@crates//:prost",
    "@crates//:rcgen",
    "@crates//:rustls",
    "@crates//:rustls-pemfile",
    "@crates//:sha2",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-rustls",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tonic-prost",
    "@crates//:tonic-health",
] + [
    ":build_script",
    "//rust/metric-proto:serviceradar_metric_proto",
]

# async-trait is a pure proc-macro crate; rules_rust requires proc-macros in
# proc_macro_deps, not deps (otherwise the target fails to analyze).
ADDON_SDK_PROC_MACROS = ["@crates//:async-trait"]

rust_library(
    name = "addon_sdk",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "addon_sdk",
    crate_root = "src/lib.rs",
    proc_macro_deps = ADDON_SDK_PROC_MACROS,
    visibility = ["//visibility:public"],
    deps = ADDON_SDK_DEPS,
)

# Rust reference add-on, mirroring //go/cmd/serviceradar-sample-addon. Supervised
# by the agent's go-plugin client as an agent-sidecar to prove Go<->Rust interop.
rust_binary(
    name = "serviceradar-rust-sample-addon",
    srcs = ["src/bin/rust_sample_addon.rs"],
    crate_root = "src/bin/rust_sample_addon.rs",
    proc_macro_deps = ADDON_SDK_PROC_MACROS,
    visibility = ["//visibility:public"],
    deps = ADDON_SDK_DEPS + [":addon_sdk"],
)

# The crate's inline #[cfg(test)] modules (src/tls.rs). Without this target they
# compile under `cargo test` and never run under Bazel, which is how the P-521
# scheme guard would have gone unnoticed -- the very regression it exists to
# catch. `crate` inherits ADDON_SDK_DEPS, so nothing is re-listed here; naming an
# inherited crate again duplicates the label and puts the package in error.
rust_test(
    name = "addon_sdk_lib_test",
    crate = ":addon_sdk",
)

rust_test(
    name = "addon_sdk_handshake_mtls_test",
    srcs = ["tests/handshake_mtls.rs"],
    crate_root = "tests/handshake_mtls.rs",
    proc_macro_deps = ADDON_SDK_PROC_MACROS,
    # rcgen is already in ADDON_SDK_DEPS; adding it again duplicates the dep label
    # and puts the package in error. Only test-only crates belong here.
    deps = ADDON_SDK_DEPS + [":addon_sdk"] + [
        "@crates//:hyper-util",
        "@crates//:tempfile",
        "@crates//:tower",
    ],
)
