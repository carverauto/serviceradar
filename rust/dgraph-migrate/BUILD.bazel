load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "dgraph_migrate",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dgraph_migrate",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ),
)

rust_test(
    name = "dgraph_migrate_test",
    crate = ":dgraph_migrate",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "lib_tests",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/lib_tests.rs",
    edition = "2024",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [":dgraph_migrate"],
)
