load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//third_party/crates:defs.bzl", "all_crate_deps")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "serviceradar_causal_reasoning",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "serviceradar_causal_reasoning",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True) + [
        "//rust/causal-model:serviceradar_causal_model",
        "//rust/causal-ports:serviceradar_causal_ports",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "serviceradar_causal_reasoning_test",
    crate = ":serviceradar_causal_reasoning",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//rust/causal-model:serviceradar_causal_model",
        "//rust/causal-ports:serviceradar_causal_ports",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)
