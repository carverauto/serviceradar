load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "cert_policy",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "serviceradar_cert_policy",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(cargo_only = True, normal = True),
)

rust_test(
    name = "cert_policy_test",
    crate = ":cert_policy",
    deps = all_crate_deps(cargo_only = True, normal_dev = True),
)
