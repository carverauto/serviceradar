load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load(
    "//build:integration_shards.bzl",
    "LARGE_INGESTION_DB_SHARD",
    "integration_lane_names",
)
load("//build:integration_tests.bzl", "requires_shared_fixture")

# Declared inputs every target that opens a connection needs.
#
# Loading still validates, but the rule set is no longer among these: it is embedded in
# //config/manager_config/rust, because it varies by nothing and every caller having to supply
# it was what kept services from using ConfigManager at all. The committed instances stay --
# those DO vary, by environment. The run id names the database the step may touch.
FIXTURE_DATA = [
    "//build:run_id_file",
    "//config/environments:ci_binpb",
]

package(default_visibility = ["//visibility:public"])

exports_files(["registry.sql"])

filegroup(
    name = "schema_template_construction_inputs",
    srcs = [
        "BUILD.bazel",
        "Cargo.toml",
        "registry.sql",
        "src/bin/generation.rs",
        "src/config/mod.rs",
        "src/generation.rs",
        "src/lib.rs",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "target/**",
        ],
    ),
)

rust_library(
    name = "serviceradar_integration_db",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["registry.sql"],
    crate_name = "serviceradar_integration_db",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//config/manager_config/rust:manager",
        "//config/manager_secret/rust:secret_manager",
        "//config/proto_bindings/rust:config_schema",
        "//rust/srql:srql_lib",
    ],
)

# Pure logic: quoting and the disposable-name guard. No database, so this one is a normal
# cached test and runs in any wildcard. URL repointing is gone -- the DSN is assembled from
# typed fields rather than parsed and rewritten.
rust_test(
    name = "serviceradar_integration_db_test",
    compile_data = ["registry.sql"],
    crate = ":serviceradar_integration_db",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        "//config/manager_config/rust:manager",
        "//config/manager_secret/rust:secret_manager",
        "//config/proto_bindings/rust:config_schema",
        "//rust/srql:srql_lib",
    ],
)

# The database lifecycle targets.
#
# `external` disables Bazel's test caching, which is not optional here: a cached "pass" would
# mean a rerun provisions nothing and drops nothing, and the job would go green having done
# neither. `manual` keeps them out of //... so an ordinary `bazel test` never points DDL at
# the shared fixture.
#
# THERE IS DELIBERATELY NO `no-remote-exec` HERE ANY MORE -- but note that the TEST actions
# are nonetheless pinned to the runner, by `--strategy=TestRunner=local` on the workflow's
# invocations rather than by a tag here. An RBE executor cannot resolve the fixture hostname
# ("failed to lookup address information: Name or service not known"), so a fully remote run
# fails at step 1. `--strategy=` selects per mnemonic, so compiles stay remote and cached
# while only the test binary moves; a tag cannot make that distinction, which is exactly why
# it was removed (below).
#
# It was load-bearing once. The CA reached the test as a PATH -- PGSSLROOTCERT and friends,
# written by scripts/ci/configure-srql-fixture.sh into ${RUNNER_TEMP} -- and --test_env forwards
# the path, never the file, so an executor died with
#
#   FAILED: failed to open PGSSLROOTCERT
#   Caused by: No such file or directory (os error 2)
#
# src/lib.rs ca_pem_from_env() now prefers SRQL_TEST_DATABASE_CA_CERT, which carries the PEM
# CONTENT (//.bazelrc forwards it), and falls back to the path only for a developer pointing at
# a local fixture. The tag outlived the reason for it by some margin.
#
# Keeping it was not free. Tags propagate from a *_test rule to its COMPILE actions, so rustc
# ran wherever the client was: on the workflow runner that means `linker /usr/bin/gcc not found`
# (the runner image has no compiler), and on a macOS workstation `cannot execute binary file`
# (Exit 126, the process_wrapper is built for the Linux exec platform). Both were live failures.
# It survived on CI only because remote CACHING still applied and the compile was always a hit --
# which stopped being true the moment the cc toolchain changed and re-keyed every action.
#
# These read SERVICERADAR_ENV and nothing else: host, port, roles and TLS posture come from the
# instance ConfigManager loads for that identity, and the password from the provider the same
# identity selects.
#
# Sequencing lives in the workflow, because Bazel deliberately does not order tests:
#   sweep_stale_dbs -> cleanup_generations -> prepare_generation
#     -> (elixir) migrate_generation [only when needs_migration] -> prepare_generation [ready]
#     -> provision_generation -> (elixir) integration_tests -> teardown_db -> release_generation
#
# The retired shared-template lifecycle (provision_base, provision_db*, prepare_template,
# reset_template and, on the Elixir side, migrate_template/migrate_run) is gone: every database
# this crate creates is a clone of the run's pinned immutable `sr_tpl_*` generation, and
# //build/contracts:ci_heavy_gate_contract_test fails if any retired target reappears. The
# frozen `sr_core_template` database itself stays protected until its approved drop.
#
[
    rust_test(
        name = target,
        size = "medium",
        srcs = ["tests/{}_test.rs".format(target)],
        crate_root = "tests/{}_test.rs".format(target),
        # Loading validates (Decision 12), so the committed rule set is a declared input of
        # anything that opens a connection -- not only of the targets that read migrations.
        data = FIXTURE_DATA,
        tags = [
            "external",
            "manual",
        ],
        target_compatible_with = requires_shared_fixture(),
        deps = all_crate_deps(
            cargo_only = True,
            normal = True,
            normal_dev = True,
        ) + [
            ":serviceradar_integration_db",
            "//rust/srql:srql_lib",
        ],
    )
    for target in [
        "sweep_stale_dbs",
        "teardown_db",
    ]
]

# Samples the shared fixture while the dedicated IntegrationBenchmark lifecycle runs. It is
# manual so ordinary wildcards never connect to the fixture; BuildBuddy starts it explicitly
# after fixture credentials have been materialized.
rust_binary(
    name = "observe_connections",
    srcs = ["src/bin/observe_connections.rs"],
    data = FIXTURE_DATA,
    tags = ["manual"],
    target_compatible_with = requires_shared_fixture(),
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        ":serviceradar_integration_db",
        "//rust/srql:srql_lib",
    ],
)

# Keyed generation lifecycle. Every active workflow (BazelCI, LargeIngestionGate,
# IntegrationBenchmark*) builds schema databases through these guarded targets and the
# generation binaries below; the legacy shared-template targets that once sat beside them are
# deleted, and //build/contracts:ci_heavy_gate_contract_test fails if any of them reappears.
rust_test(
    name = "generation_lifecycle_test",
    size = "large",
    srcs = ["tests/generation_lifecycle_test.rs"],
    crate_root = "tests/generation_lifecycle_test.rs",
    data = FIXTURE_DATA + [
        "//build/schema_template:manifest",
        "//build/schema_template:policy.json",
    ],
    tags = [
        "external",
        "integration_test",
        "manual",
    ],
    target_compatible_with = requires_shared_fixture(),
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [":serviceradar_integration_db"],
)

[
    rust_binary(
        name = name,
        srcs = ["src/bin/generation.rs"],
        args = [operation],
        data = FIXTURE_DATA + [
            "//build/schema_template:manifest",
            "//build/schema_template:policy.json",
        ],
        env = {"SERVICERADAR_TEST_DB_SHARDS": shards},
        tags = ["manual"],
        target_compatible_with = requires_shared_fixture(),
        deps = all_crate_deps(
            cargo_only = True,
            normal = True,
        ) + [":serviceradar_integration_db"],
    )
    for name, operation, shards in [
        ("prepare_generation", "prepare", ""),
        (
            "provision_generation",
            "clone",
            ",".join(integration_lane_names()),
        ),
        ("provision_generation_large_ingestion", "clone", LARGE_INGESTION_DB_SHARD),
        ("release_generation", "release", ""),
        ("cleanup_generations", "cleanup", ""),
    ]
]

# Focused developer targets clone only the lane that will run, instead of touching seven
# additional databases: `provision_generation_<lane>` followed by the matching
# `integration_tests_<lane>` target. Generated from the same lane list as the Elixir lane
# targets, so the two name sets cannot drift and no hand-maintained list can shadow it;
# //build/contracts:ci_heavy_gate_contract_test pins the comprehension to
# integration_lane_names(). This replaces the retired provision_db_<lane> targets.
[
    rust_binary(
        name = "provision_generation_{}".format(lane),
        srcs = ["src/bin/generation.rs"],
        args = ["clone"],
        data = FIXTURE_DATA + [
            "//build/schema_template:manifest",
            "//build/schema_template:policy.json",
        ],
        env = {"SERVICERADAR_TEST_DB_SHARDS": lane},
        tags = ["manual"],
        target_compatible_with = requires_shared_fixture(),
        deps = all_crate_deps(
            cargo_only = True,
            normal = True,
        ) + [":serviceradar_integration_db"],
    )
    for lane in integration_lane_names()
]
