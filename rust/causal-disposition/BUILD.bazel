load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rust_crates//:defs.bzl", "all_crate_deps")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

# Plain rlib disposition kernel crate. NO cdylib bazel rule: the NIF cdylib is
# built by Rustler during `mix compile`, not bazel (the core-elx app filegroup
# already globs native/**). This `rust_library` exists for non-NIF consumers and
# for the kernel unit tests. The `rustler` feature is OFF here, so the optional
# proc-macro dep is not pulled into this target.
rust_library(
    name = "serviceradar_causal_disposition",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    crate_name = "serviceradar_causal_disposition",
    crate_root = "src/lib.rs",
    edition = "2024",
    # path-dep on the shared substrate (the sibling bazel target) + deep_causality_core.
    deps = all_crate_deps(normal = True) + [
        "//rust/anomaly-core:serviceradar_anomaly_core",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "serviceradar_causal_disposition_test",
    crate = ":serviceradar_causal_disposition",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//rust/anomaly-core:serviceradar_anomaly_core",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)
