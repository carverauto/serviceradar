load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "serviceradar_causal_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "serviceradar_causal_config",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//rust/causal-model:serviceradar_causal_model",
    ],
)

rust_test(
    name = "serviceradar_causal_config_test",
    crate = ":serviceradar_causal_config",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        "//rust/causal-model:serviceradar_causal_model",
    ],
)
