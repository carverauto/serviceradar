load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//third_party/crates:defs.bzl", "all_crate_deps")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "srql_lib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "srql",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True) + [
        "//rust/kvutil:kvutil",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "srql_bin",
    srcs = ["src/main.rs"],
    crate_name = "srql",
    deps = [
        ":srql_lib",
        "//rust/kvutil:kvutil",
    ] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

# NOTE: srql_api_test / srql_comprehensive_test moved to //integration_tests/srql.
# They wire the CNPG Postgres image (heavy, Linux-only) and must not be reachable from
# //rust/... — see integration_tests/srql/BUILD.bazel.
rust_test(
    name = "srql_lib_test",
    crate = ":srql_lib",
    deps = all_crate_deps(normal_dev = True),
)
