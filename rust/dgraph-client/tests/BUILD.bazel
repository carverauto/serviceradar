load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_test_suite")

# Unit tests living in src/ behind #[cfg(test)]. `crate` must be the full label: a
# relative ":dgraph_client" would resolve inside this tests package, where no such target
# exists. Note rust_test(crate = ...) does NOT inherit crate_features; if the library ever
# gains features, repeat them here.
rust_test(
    name = "dgraph_client_test",
    crate = "//rust/dgraph-client:dgraph_client",
    deps = all_crate_deps(
        package_name = "rust/dgraph-client",
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + ["//proto/dgraph:proto_dgraph_bindings"],
)

# unit tests
rust_test_suite(
    name = "dgraph_client_integration_test",
    srcs = glob(["**/*.rs"], exclude = ["dgraph_container_test.rs"]),
    crate_root = "lib_tests.rs",
    deps = all_crate_deps(
        package_name = "rust/dgraph-client",
        cargo_only = True, normal = True, normal_dev = True,
    ) + ["//proto/dgraph:proto_dgraph_bindings", "//rust/dgraph-client:dgraph_client"],
)

# These need a running Docker daemon.
# Everything lives in a single test function because Bazel runs test functions
# concurrently and does not honour --test-threads=1, so parallel scenarios would race over
# the one shared container. See the module docs in dgraph_container_test.rs.
rust_test_suite(
    name = "dgraph_integration_test",
    srcs = ["dgraph_container_test.rs"],
    # The test is #[ignore] so `cargo test` stays hermetic. Without this flag Bazel would
    # honour that attribute too and the target would report success having run nothing.
    args = ["--include-ignored"],
    tags = [
        # Selector for the integration stage.
        # Bazel would select this and all other integation tests via
        # bazel test --test_env=SERVICERADAR_ENV=localhost --test_tag_filters=integration_test
       "integration_test",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "rust/dgraph-client",
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        "//proto/dgraph:proto_dgraph_bindings",
        "//rust/dgraph-client:dgraph_client",
        # The test suite resolves its endpoint through the auto-config system.
        "//config/manager_config/rust:manager",
        "//config/proto_bindings/rust:config_schema",
    ],
)
