load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_test_suite")

# All test targets live here so the whole test surface is declared in one place.
#
# `package_name` is required on every all_crate_deps(cargo_only = True) call in this file: it otherwise
# resolves against the package it is called from, and there is no Cargo.toml at
# rust/dgraph-client/tests. Without it the load fails with
# "that package had no Cargo.toml file".

# Unit tests living in src/ behind #[cfg(test)]. `crate` must be the full label: a
# relative ":dgraph_client" would resolve inside this tests package, where no such target
# exists. Note rust_test(crate = ...) does NOT inherit crate_features; if the library ever
# gains features, repeat them here.
rust_test(
    name = "dgraph_client_test",
    crate = "//rust/dgraph-client:dgraph_client",
    edition = "2024",
    deps = all_crate_deps(
        package_name = "rust/dgraph-client",
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + ["//proto/dgraph:proto_dgraph_bindings"],
)

# Hermetic integration tests. The tests/ tree mirrors src/ and every module is registered
# from lib_tests.rs, so one target covers the whole tree.
#
# dgraph_container_test.rs is excluded: it needs a Docker daemon and is built by the
# acceptance suite below instead.
rust_test(
    name = "dgraph_client_integration_test",
    srcs = glob(
        ["**/*.rs"],
        exclude = ["dgraph_container_test.rs"],
    ),
    crate_root = "lib_tests.rs",
    edition = "2024",
    deps = all_crate_deps(
        package_name = "rust/dgraph-client",
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        "//proto/dgraph:proto_dgraph_bindings",
        "//rust/dgraph-client:dgraph_client",
    ],
)

# Acceptance tests against a real dgraph/standalone container.
#
# These need a Docker daemon. The exec_properties below are what let BuildBuddy provide
# one; a workstation without Docker running will fail this target.
#
# Everything lives in a single test function because Bazel runs test functions
# concurrently and does not honour --test-threads=1, so parallel scenarios would race over
# the one shared container. See the module docs in dgraph_container_test.rs.
#
# The exec_properties are: a Firecracker microVM with a
# Docker daemon inside, and a recycled runner keyed so the whole suite lands on the same VM
# and reuses the already-pulled dgraph image rather than pulling it per test.
rust_test_suite(
    name = "acceptance_tests",
    # Without this the target inherits Bazel's default "moderate" (300s), which has to
    # cover microVM boot, a cold `docker pull` of dgraph/standalone, and the suite's own
    # 120s readiness budget. That leaves under three minutes for the pull, which is not a
    # safe margin on a contended executor. This is only a backstop: the test bounds itself
    # with READY_TIMEOUT, so a genuine hang still fails in about two minutes, not fifteen.
    timeout = "long",
    srcs = ["dgraph_container_test.rs"],
    # The test is #[ignore] so `cargo test` stays hermetic. Without this flag Bazel would
    # honour that attribute too and the target would report success having run nothing.
    args = ["--include-ignored"],
    edition = "2024",
    tags = [
        # Selector for the integration stage. Run these on their own, after the hermetic
        # suites are green, with:
        #
        #   bazel test --config=ci $(bazel query 'attr("tags", "integration_test", tests(//...))')
       # "integration_test",
        #
        # Local selector for running just this suite.
        # "dgraph_acceptance_test",
        # CI selector for the acceptance job.
        # "acceptance_test",
        #
        # Disabled for the time being until a proper DGraph instance is in the CI cluster.
        "manual",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "rust/dgraph-client",
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        "//proto/dgraph:proto_dgraph_bindings",
        "//rust/dgraph-client:dgraph_client",
    ],
)
