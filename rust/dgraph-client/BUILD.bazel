load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

# The in-repo proto binding is NOT a crates.io crate, so all_crate_deps(cargo_only = True) cannot infer it;
# it has to be appended explicitly. The generated crate is named after the proto_library
# target (proto_dgraph), which is what `use proto_dgraph::api` resolves to.
rust_library(
    name = "dgraph_client",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + ["//proto/dgraph:proto_dgraph_bindings"],
)
