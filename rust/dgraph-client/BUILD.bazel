load("@rules_rust//rust:defs.bzl", "rust_library")
load("//third_party/crates:defs.bzl", "all_crate_deps")

# The in-repo proto binding is NOT a crates.io crate, so all_crate_deps() cannot infer it;
# it has to be appended explicitly. The generated crate is named after the proto_library
# target (proto_dgraph), which is what `use proto_dgraph::api` resolves to.
rust_library(
    name = "dgraph_client",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = all_crate_deps(normal = True) + ["//proto/dgraph:proto_dgraph_bindings"],
    visibility = ["//visibility:public"],
)
