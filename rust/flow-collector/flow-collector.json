{
  "nats_url": "nats://nats:4222",
  "stream_name": "flows",
  "stream_max_bytes": 1073741824,
  "stream_max_age_secs": 7200,
  "stream_replicas": 1,
  "channel_size": 10000,
  "batch_size": 100,
  "publish_timeout_ms": 5000,
  "listeners": [
    {
      "protocol": "sflow",
      "listen_addr": "0.0.0.0:6343",
      "subject": "flows.raw.sflow"
    },
    {
      "protocol": "netflow",
      "listen_addr": "0.0.0.0:2055",
      "subject": "flows.raw.netflow"
    }
  ],
  "rehome_state_path": "/var/lib/serviceradar/flow-collector-rehome.json",
  "ready_state_path": "/var/lib/serviceradar/flow-collector.ready"
}
