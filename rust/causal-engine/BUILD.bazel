load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rust_crates//:defs.bzl", "all_crate_deps")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "causal_engine_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "causal_engine",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "causal_engine_bin",
    srcs = ["src/main.rs"],
    crate_name = "causal_engine",
    edition = "2021",
    deps = [":causal_engine_lib"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "causal_engine_test",
    crate = ":causal_engine_lib",
    deps = all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)
