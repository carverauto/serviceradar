load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")

rust_binary(
    name = "serviceradar-causal-engine",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//rust/causal-causaloids:serviceradar_causal_causaloids",
        "//rust/causal-config:serviceradar_causal_config",
        "//rust/causal-context:serviceradar_causal_context",
        "//rust/causal-emit:serviceradar_causal_emit",
        "//rust/causal-ingest:serviceradar_causal_ingest",
        "//rust/causal-mitigation:serviceradar_causal_mitigation",
        "//rust/causal-model:serviceradar_causal_model",
        "//rust/causal-ports:serviceradar_causal_ports",
        "//rust/causal-reasoning:serviceradar_causal_reasoning",
    ],
)
