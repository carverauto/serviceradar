load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# The OTEL collector packaged as a native agent add-on (agent-sidecar,
# otlp-relay:v1). Mirrors //rust/log-collector's binary shape; the addon-sdk
# and otel libs are path deps, so they are bazel labels rather than
# crate_universe deps.
rust_binary(
    name = "serviceradar-otel-addon",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//rust/addon-sdk:addon_sdk",
        "//rust/otel:otel_lib",
    ],
)

rust_test(
    name = "otel_addon_test",
    # fj#4383: core-emitted config_json contract fixture, include_str!'d by
    # src/addon.rs's contract test (regenerated via
    # `mix serviceradar.gen.addon_contract_fixtures`).
    compile_data = ["//go/pkg/agent:addonconfig_contract_fixtures"],
    crate = ":serviceradar-otel-addon",
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ),
)
