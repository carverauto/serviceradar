{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Endpoint Software Inventory Configuration",
  "description": "Operator-facing configuration for the root-owned endpoint software inventory collector. The collector reads this base config and applies the runtime profile written under /var/lib/serviceradar/endpoint-inventory/profile/runtime.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "description": "Master switch for endpoint inventory collection. When false, the timer run writes a disabled/not-scanned spool payload.",
      "default": false
    },
    "agent_id": {
      "type": "string",
      "title": "Agent ID",
      "description": "Agent UID written into inventory spool payloads when the runtime profile does not override it.",
      "minLength": 1
    },
    "profile_path": {
      "type": "string",
      "title": "Runtime profile path",
      "default": "/var/lib/serviceradar/endpoint-inventory/profile/runtime.json"
    },
    "spool_dir": {
      "type": "string",
      "title": "Spool directory",
      "default": "/var/lib/serviceradar/endpoint-inventory/spool"
    },
    "cache_dir": {
      "type": "string",
      "title": "Local cache directory",
      "default": "/var/lib/serviceradar/endpoint-inventory/cache"
    },
    "tmp_dir": {
      "type": "string",
      "title": "Temporary directory",
      "default": "/var/lib/serviceradar/endpoint-inventory/tmp"
    },
    "scan_timeout": {
      "type": "string",
      "title": "Scan timeout",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
      "default": "5m"
    },
    "os_release_path": {
      "type": "string",
      "title": "OS release path",
      "default": "/etc/os-release"
    },
    "dpkg_status_path": {
      "type": "string",
      "title": "dpkg status path",
      "default": "/var/lib/dpkg/status"
    },
    "apk_installed_path": {
      "type": "string",
      "title": "apk installed database path",
      "default": "/lib/apk/db/installed"
    },
    "rpm_path": {
      "type": "string",
      "title": "rpm binary path",
      "default": "rpm"
    },
    "rpm_database_paths": {
      "type": "array",
      "title": "RPM database candidate paths",
      "items": {
        "type": "string"
      },
      "default": [
        "/usr/lib/sysimage/rpm/rpmdb.sqlite",
        "/var/lib/rpm/rpmdb.sqlite",
        "/var/lib/rpm/Packages",
        "/var/lib/rpm"
      ]
    },
    "sources": {
      "type": "array",
      "title": "Package sources",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["dpkg", "rpm", "apk"]
      },
      "default": ["dpkg", "rpm", "apk"]
    },
    "max_packages": {
      "type": "integer",
      "title": "Maximum packages",
      "minimum": 1,
      "default": 100000
    },
    "force_full_scan_interval": {
      "type": "integer",
      "title": "Forced full scan interval",
      "description": "Maximum number of unchanged scheduled scans before a full package database reparse is forced.",
      "minimum": 1,
      "default": 24
    },
    "cache_stale_threshold": {
      "type": "string",
      "title": "Cache stale threshold",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
      "default": "24h"
    },
    "upload_jitter": {
      "type": "string",
      "title": "Changed upload jitter",
      "description": "Maximum delay applied before exposing a changed full-inventory upload. This is distinct from the scan timer delay.",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
      "default": "0s"
    },
    "upload_retry_initial": {
      "type": "string",
      "title": "Initial upload retry delay",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
      "default": "5m"
    },
    "upload_retry_max": {
      "type": "string",
      "title": "Maximum upload retry delay",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
      "default": "1h"
    },
    "upload_retry_max_attempts": {
      "type": "integer",
      "title": "Maximum upload retry attempts",
      "minimum": 1,
      "default": 5
    },
    "force_fresh_enabled": {
      "type": "boolean",
      "title": "Allow force-fresh commands",
      "description": "When true, authorized device-scoped on-demand commands may run a fresh endpoint inventory scan. Disabled by default.",
      "default": false
    },
    "max_output_bytes": {
      "type": "integer",
      "title": "Maximum spool payload bytes",
      "minimum": 1048576,
      "default": 33554432
    }
  }
}
