[Unit]
Description=ServiceRadar endpoint software inventory collector
Documentation=https://docs.serviceradar.cloud/
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=serviceradar
# Group-writable umask so the non-root agent (user serviceradar) can write
# upload-success markers and runtime profiles into the shared state dirs.
UMask=0007
# Share cgroup accounting with the host agent while preserving independent
# systemd supervision, restart policy, privileges, and hardening.
Slice=serviceradar.slice
WorkingDirectory=/var/lib/serviceradar/endpoint-inventory
Environment="HOME=/var/lib/serviceradar/endpoint-inventory"
ExecStart=/var/lib/serviceradar/agent/addons/endpoint-inventory/current/serviceradar-endpoint-inventory -config /var/lib/serviceradar/agent/addons/endpoint-inventory/current/endpoint-inventory.json
Nice=10
IOSchedulingClass=best-effort
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateNetwork=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
StateDirectory=serviceradar/endpoint-inventory serviceradar/endpoint-inventory/profile serviceradar/endpoint-inventory/cache serviceradar/endpoint-inventory/spool serviceradar/endpoint-inventory/spool/runs serviceradar/endpoint-inventory/tmp
# setgid (2) + group-write so dirs stay owned by the serviceradar group and the
# non-root agent can write markers; systemd re-asserts this on every start.
StateDirectoryMode=2770
ReadWritePaths=/var/lib/serviceradar/endpoint-inventory
