{
  "enabled": false,
  "agent_id": "default-agent",
  "scanner_id": "osv-scalibr",
  "scanner_version": "v0.4.5",
  "profile_path": "/var/lib/serviceradar/endpoint-inventory/profile/runtime.json",
  "spool_dir": "/var/lib/serviceradar/endpoint-inventory/spool",
  "cache_dir": "/var/lib/serviceradar/endpoint-inventory/cache",
  "tmp_dir": "/var/lib/serviceradar/endpoint-inventory/tmp",
  "scan_timeout": "5m",
  "scalibr_plugins": ["os/dpkg", "os/rpm", "os/apk"],
  "scan_roots": ["/"],
  "paths_to_extract": [],
  "dirs_to_skip": [
    "/proc",
    "/sys",
    "/dev",
    "/run",
    "/var/lib/serviceradar/endpoint-inventory"
  ],
  "network_online": false,
  "read_symlinks": false,
  "max_file_size": 33554432,
  "max_inodes": 0,
  "cadence": "24h",
  "collect_paths": false,
  "collect_file_hashes": false,
  "max_packages": 100000,
  "force_full_scan_interval": 24,
  "cache_stale_threshold": "26h",
  "upload_jitter": "0s",
  "upload_retry_initial": "5m",
  "upload_retry_max": "1h",
  "upload_retry_max_attempts": 5,
  "force_fresh_enabled": false,
  "max_output_bytes": 33554432
}
