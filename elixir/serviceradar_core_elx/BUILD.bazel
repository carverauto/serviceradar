load("//build:mix_release.bzl", "mix_release")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "deps/**",
            "tmp/**",
        ],
    ),
)

filegroup(
    name = "deps_srcs",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(["config/**"]),
)

mix_release(
    name = "release_tar",
    srcs = [":srcs"],
    bootstrap_srcs = [":deps_srcs"],
    out = "serviceradar-core-elx-release.tar.gz",
    src_dir = "elixir/serviceradar_core_elx",
    run_assets = False,
    extra_dirs = [
        "addons/bumblebee-scan",
        "addons/netprobe",
        "addons/workload-identity",
        "elixir/connection",
        "elixir/elixir_uuid",
        "elixir/serviceradar_core",
        "elixir/serviceradar_srql",
        "elixir/vendor/opentelemetry_oban",
        "proto",
        "rust/kvutil",
        "rust/srql",
    ],
    extra_dir_srcs = [
        "//addons/bumblebee-scan:bumblebee_scan_manifest",
        "//addons/netprobe:netprobe_manifest",
        "//addons/workload-identity:workload_identity_manifest",
        "//elixir/connection:srcs",
        "//elixir/elixir_uuid:srcs",
        "//elixir/serviceradar_core:srcs",
        "//elixir/serviceradar_srql:srcs",
        "//elixir/vendor/opentelemetry_oban:srcs",
        "//proto:kv_proto_src",
        "//rust/kvutil:srcs",
        "//rust/srql:srcs",
    ],
    # Membrane precompiled OS-dep tarballs (x86_64 linux), pinned in MODULE.bazel.
    # Staged into the sandbox and copied by Bundlex's patched download/2 so
    # `mix deps.compile` does not need github.com egress on the CI runner.
    precompiled_os_deps = [
        "@membrane_precompiled_fdk_aac//file",
        "@membrane_precompiled_lame//file",
        "@membrane_precompiled_mad//file",
        "@membrane_precompiled_opus//file",
        "@membrane_precompiled_portaudio//file",
        "@membrane_precompiled_sdl2//file",
        "@membrane_precompiled_libvpx//file",
        "@membrane_precompiled_srt//file",
        "@membrane_precompiled_srtp//file",
        "@membrane_precompiled_ffmpeg//file",
    ],
    workdir_name = "serviceradar_core_elx",
)
