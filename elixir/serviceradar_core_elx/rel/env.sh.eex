#!/bin/sh
# Runtime selection of mounted certificate material must happen before OTP
# starts; deployment credential paths cannot be baked into a Bazel action.
# Release environment configuration for ServiceRadar Core-ELX

# =============================================================================
# Node Name Configuration
# =============================================================================

if [ -z "${RELEASE_NODE}" ]; then
  HOSTNAME=${HOSTNAME:-$(hostname -f)}
  export RELEASE_NODE="serviceradar_core@${HOSTNAME}"
fi

export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

# =============================================================================
# mTLS Distribution Configuration
# =============================================================================

# Managed adoption selects the packaged OTP configuration before distribution
# starts. The mounted certificate directory stays read-only.
if [ -n "${SERVICERADAR_CERT_POLICY_URL:-}${SERVICERADAR_CERT_POLICY_KEY_FILE:-}" ]; then
  if [ -z "${SERVICERADAR_CERT_POLICY_URL:-}" ] || [ -z "${SERVICERADAR_CERT_POLICY_KEY_FILE:-}" ]; then
    echo "Managed peer policy requires its HTTPS URL and pinned signing-key file" >&2
    exit 1
  fi
  managed_dist_count=0
  for managed_dist_file in "$RELEASE_ROOT"/lib/serviceradar_core-*/priv/managed_ssl_dist.config; do
    if [ -f "$managed_dist_file" ]; then
      SSL_DIST_OPTFILE="$managed_dist_file"
      managed_dist_count=$((managed_dist_count + 1))
    fi
  done
  if [ "$managed_dist_count" -ne 1 ]; then
    echo "Expected exactly one packaged managed distribution configuration" >&2
    exit 1
  fi
  export SSL_DIST_OPTFILE
  export ENABLE_TLS_DIST=true
  export CLUSTER_TLS_ENABLED=true
fi

CERT_DIR="${SPIFFE_CERT_DIR:-/etc/serviceradar/certs}"
SSL_DIST_OPTFILE="${SSL_DIST_OPTFILE:-${CERT_DIR}/ssl_dist.conf}"

if [ "${ENABLE_TLS_DIST:-true}" = "true" ] && [ -f "${SSL_DIST_OPTFILE}" ]; then
  export ERL_FLAGS="${ERL_FLAGS} -proto_dist inet_tls"
  export ERL_FLAGS="${ERL_FLAGS} -ssl_dist_optfile ${SSL_DIST_OPTFILE}"
fi

# =============================================================================
# Remote Shell Access
# =============================================================================

if [ -n "${HIDDEN_NODE}" ]; then
  export ERL_FLAGS="${ERL_FLAGS} -hidden"
fi

# =============================================================================
# Cookie Configuration
# =============================================================================

if [ -z "${RELEASE_COOKIE}" ]; then
  COOKIE_FILE="${RELEASE_COOKIE_FILE:-${CERT_DIR}/erlang_cookie}"
  if [ -f "${COOKIE_FILE}" ]; then
    export RELEASE_COOKIE=$(cat "${COOKIE_FILE}")
  else
    export RELEASE_COOKIE="${ERLANG_COOKIE:-serviceradar_dev_cookie}"
  fi
fi

# =============================================================================
# Memory and Performance
# =============================================================================
# Scheduler/async-thread tuning is baked into rel/vm.args.eex (+S/+SDcpu/+SDio,
# +sbwt none, +A 4) so it cannot be removed via ELIXIR_ERL_OPTIONS. The previous
# `+sbt db` core-binding and oversized `+A 16` were removed here on purpose.

# =============================================================================
# Debug/Development Settings
# =============================================================================

if [ "${DEBUG_DIST:-false}" = "true" ]; then
  export ERL_FLAGS="${ERL_FLAGS} -kernel inet_dist_listen_min 9100 -kernel inet_dist_listen_max 9155"
fi
