load("@serviceradar//build:elixir_tests.bzl", "ex_unit_tests")
load("@serviceradar//build:mix_app.bzl", "mix_app")
load("//build:mix_release.bzl", "mix_release")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "deps/**",
            "tmp/**",
        ],
    ),
)

filegroup(
    name = "deps_srcs",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(["config/**"]),
)

mix_release(
    name = "release_tar",
    srcs = [":srcs"],
    out = "serviceradar-agent-gateway-release.tar.gz",
    bootstrap_srcs = [":deps_srcs"],
    extra_dir_srcs = [
        "//addons/bumblebee-scan:bumblebee_scan_manifest",
        "//addons/scalibr-endpoint-inventory:scalibr_endpoint_inventory_manifest",
        "//addons/netprobe:netprobe_manifest",
        "//addons/otel-collector:otel_collector_manifest",
        "//addons/workload-identity:workload_identity_manifest",
        "//elixir/connection:srcs",
        "//elixir/elixir_uuid:srcs",
        "//elixir/serviceradar_core:srcs",
        "//elixir/serviceradar_srql:srcs",
        "//elixir/vendor/opentelemetry_oban:srcs",
        "//proto:kv_proto_src",
        "//rust/anomaly-core:srcs",
        "//rust/anomaly-disposition:srcs",
        "//rust/kvutil:srcs",
        "//rust/srql:srcs",
    ],
    extra_dirs = [
        "addons/bumblebee-scan",
        "addons/scalibr-endpoint-inventory",
        "addons/netprobe",
        "addons/otel-collector",
        "addons/workload-identity",
        "elixir/connection",
        "elixir/elixir_uuid",
        "elixir/serviceradar_core",
        "elixir/serviceradar_srql",
        "elixir/vendor/opentelemetry_oban",
        "proto",
        "rust/anomaly-core",
        "rust/anomaly-disposition",
        "rust/kvutil",
        "rust/srql",
    ],
    run_assets = False,
    src_dir = "elixir/serviceradar_agent_gateway",
    workdir_name = "serviceradar_agent_gateway",
)

# Compiled by Mix inside a single hermetic Bazel action. mix_env is "test" because
# mix.exs sets elixirc_paths(:test) => ["lib", "test/support"], and the ExUnit targets
# need those support modules on the code path.
mix_app(
    name = "erlang_app",
    srcs = [":srcs"],
    app_name = "serviceradar_agent_gateway",
    mix_env = "test",
    deps = [
        "//elixir/serviceradar_core:erlang_app",
        "@hex_ash_credo//:erlang_app",
        "@hex_bandit//:erlang_app",
        "@hex_boundary//:erlang_app",
        "@hex_credo//:erlang_app",
        "@hex_dialyxir//:erlang_app",
        "@hex_ex_dna//:erlang_app",
        "@hex_ex_slop//:erlang_app",
        "@hex_grpc_server//:erlang_app",
        "@hex_gun//:erlang_app",
        "@hex_jason//:erlang_app",
        "@hex_libcluster//:erlang_app",
        "@hex_mix_audit//:erlang_app",
        "@hex_mox//:erlang_app",
        "@hex_plug//:erlang_app",
        "@hex_protobuf//:erlang_app",
        "@hex_req//:erlang_app",
        "@hex_styler//:erlang_app",
        "@hex_telemetry_metrics//:erlang_app",
        "@hex_telemetry_metrics_prometheus_core//:erlang_app",
        "@rules_elixir//elixir",
    ],
)

ex_unit_tests(
    name = "unit_tests",
    srcs = glob(["test/**/*_test.exs"]),
    data = glob(
        [
            "lib/**",
            "priv/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = ["test/**/*_test.exs"],
    ),
    test_helper = "test/test_helper.exs",
    deps = [":erlang_app"],
)
