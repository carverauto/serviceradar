load("@serviceradar//build:elixir_tests.bzl", "ex_unit_tests")
load("@serviceradar//build:mix_app.bzl", "mix_app")
load("//build:elixir_release.bzl", "elixir_release")
load("//build:mix_release.bzl", "mix_release")

package(default_visibility = ["//visibility:public"])

# The release RECIPE, as opposed to the release CONTENTS. mix.exs supplies releases/0,
# config/ and rel/ supply the templates `mix release` renders. Compiled code is not here
# -- it reaches the release through the ErlangAppInfo closure of :erlang_app.
filegroup(
    name = "release_recipe",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(
        [
            "config/**",
            "rel/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "deps/**",
            "tmp/**",
        ],
    ),
)

filegroup(
    name = "deps_srcs",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(["config/**"]),
)

mix_release(
    name = "release_tar",
    srcs = [":srcs"],
    out = "serviceradar-agent-gateway-release.tar.gz",
    bootstrap_srcs = [":deps_srcs"],
    extra_dir_srcs = [
        "//addons/bumblebee-scan:bumblebee_scan_manifest",
        "//addons/scalibr-endpoint-inventory:scalibr_endpoint_inventory_manifest",
        "//addons/netprobe:netprobe_manifest",
        "//addons/otel-collector:otel_collector_manifest",
        "//addons/workload-identity:workload_identity_manifest",
        "//elixir/connection:srcs",
        "//elixir/elixir_uuid:srcs",
        "//elixir/serviceradar_core:srcs",
        "//elixir/serviceradar_srql:srcs",
        "//elixir/vendor/opentelemetry_oban:srcs",
        "//proto:kv_proto_src",
    ],
    extra_dirs = [
        "addons/bumblebee-scan",
        "addons/scalibr-endpoint-inventory",
        "addons/netprobe",
        "addons/otel-collector",
        "addons/workload-identity",
        "elixir/connection",
        "elixir/elixir_uuid",
        "elixir/serviceradar_core",
        "elixir/serviceradar_srql",
        "elixir/vendor/opentelemetry_oban",
        "proto",
    ],
    # Bazel builds the NIFs; Mix must not shell out to cargo. serviceradar_srql and
    # serviceradar_core are path deps staged via extra_dirs, so their .so lands in the
    # staged copy of each app's priv/native.
    extra_config = [
        "config :serviceradar_srql, ServiceRadarSRQL.Native, skip_compilation?: true",
        "config :serviceradar_core, ServiceRadar.Observability.Zen.Native, skip_compilation?: true",
        "config :serviceradar_core, ServiceRadar.Observability.DispositionKernels, skip_compilation?: true",
    ],
    native_libs = {
        "//elixir/serviceradar_srql/native/srql_nif:srql_nif": "elixir/serviceradar_srql/priv/native/srql_nif.so",
        "//elixir/serviceradar_core/native/zen_nif:zen_nif": "elixir/serviceradar_core/priv/native/zen_nif.so",
        "//elixir/serviceradar_core/native/anomaly_disposition_nif:anomaly_disposition_nif": "elixir/serviceradar_core/priv/native/anomaly_disposition_nif.so",
    },
    run_assets = False,
    src_dir = "elixir/serviceradar_agent_gateway",
    workdir_name = "serviceradar_agent_gateway",
)

# Deps shared by the :test and :prod compilations below. The first entry differs between
# them -- each env must see serviceradar_core built for the SAME env, or a release ends up
# with test-compiled configuration baked into a dependency.
GATEWAY_DEPS = [
    "@hex_ash_credo//:erlang_app",
        "@hex_bandit//:erlang_app",
        "@hex_boundary//:erlang_app",
        "@hex_credo//:erlang_app",
        "@hex_dialyxir//:erlang_app",
        "@hex_ex_dna//:erlang_app",
        "@hex_ex_slop//:erlang_app",
        "@hex_grpc_server//:erlang_app",
        "@hex_gun//:erlang_app",
        "@hex_jason//:erlang_app",
        "@hex_libcluster//:erlang_app",
        "@hex_mix_audit//:erlang_app",
        "@hex_mox//:erlang_app",
        "@hex_plug//:erlang_app",
        "@hex_protobuf//:erlang_app",
        "@hex_req//:erlang_app",
        "@hex_styler//:erlang_app",
        "@hex_telemetry_metrics//:erlang_app",
    "@hex_telemetry_metrics_prometheus_core//:erlang_app",
    "@rules_elixir//elixir",
]

# Compiled by Mix inside a single hermetic Bazel action. mix_env is "test" because
# mix.exs sets elixirc_paths(:test) => ["lib", "test/support"], and the ExUnit targets
# need those support modules on the code path.
mix_app(
    name = "erlang_app",
    srcs = [":srcs"],
    app_name = "serviceradar_agent_gateway",
    mix_env = "test",
    deps = ["//elixir/serviceradar_core:erlang_app"] + GATEWAY_DEPS,
)

# The release build. See //elixir/serviceradar_core:erlang_app_prod for why the env
# matters; this one also drops test/support from elixirc_paths and pulls the :prod build
# of serviceradar_core, so no test-only application reaches the image.
mix_app(
    name = "erlang_app_prod",
    srcs = [":srcs"],
    app_name = "serviceradar_agent_gateway",
    mix_env = "prod",
    deps = ["//elixir/serviceradar_core:erlang_app_prod"] + GATEWAY_DEPS,
)

# Assembly-only release: no deps.get, no recompilation, no cargo, no network.
# Contents come from the transitive ErlangAppInfo closure of :erlang_app.
elixir_release(
    name = "release_assembled",
    srcs = [
        ":release_recipe",
        # Mix reads each PATH dependency's mix.exs to learn its app name and version,
        # transitively. Only the manifest is needed -- the compiled code arrives via `app`.
        "//elixir/connection:mix.exs",
        "//elixir/elixir_uuid:mix.exs",
        "//elixir/serviceradar_core:mix.exs",
        "//elixir/serviceradar_srql:mix.exs",
        "//elixir/vendor/opentelemetry_oban:mix.exs",
    ],
    app = ":erlang_app_prod",
    out = "serviceradar-agent-gateway-assembled.tar.gz",
    release_name = "serviceradar_agent_gateway",
)

ex_unit_tests(
    name = "unit_tests",
    srcs = glob(["test/**/*_test.exs"]),
    data = glob(
        [
            "lib/**",
            "priv/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = ["test/**/*_test.exs"],
    ),
    test_helper = "test/test_helper.exs",
    deps = [":erlang_app"],
)
