{
  "schema_version": 1,
  "id": "cloud.serviceradar.web-rum",
  "name": "Web RUM",
  "version": "0.1.0",
  "vendor": "ServiceRadar",
  "description": "Boomerang Real User Monitoring dashboard for Core Web Vitals (p75 LCP, INP, CLS, FCP, TTFB), Akamai Edge vs Origin RTT splits, branch prefix_tag/ASN cohorts, and trace-correlated beacon inspection.",
  "capabilities": [
    "srql.execute",
    "dashboard.preferences.read",
    "dashboard.preferences.write",
    "navigation.open"
  ],
  "data_frames": [
    {
      "id": "rum_cwv_summary",
      "query": "in:rum time:last_24h stats:\"count() as beacons, p75(lcp_ms) as p75_lcp_ms, p75(inp_ms) as p75_inp_ms, p75(cls) as p75_cls, p75(fcp_ms) as p75_fcp_ms, p75(ttfb_ms) as p75_ttfb_ms, p75(page_load_ms) as p75_page_load_ms, sum(has_error) as error_beacons\" limit:1",
      "encoding": "json_rows",
      "limit": 1,
      "refresh_interval_ms": 30000,
      "required": true,
      "fields": [
        "beacons",
        "p75_lcp_ms",
        "p75_inp_ms",
        "p75_cls",
        "p75_fcp_ms",
        "p75_ttfb_ms",
        "p75_page_load_ms",
        "error_beacons"
      ]
    },
    {
      "id": "rum_latency_breakdown",
      "query": "in:rum time:last_24h stats:\"count() as beacons, p75(cdn_edge_rtt_ms) as p75_edge_rtt_ms, p75(cdn_origin_rtt_ms) as p75_origin_rtt_ms, p75(ttfb_ms) as p75_ttfb_ms, p75(dom_ready_ms) as p75_dom_ready_ms, p75(page_load_ms) as p75_page_load_ms, p75(lcp_ms) as p75_lcp_ms by time:1h\" limit:48",
      "encoding": "json_rows",
      "limit": 48,
      "refresh_interval_ms": 30000,
      "required": true,
      "fields": [
        "bucket",
        "beacons",
        "p75_edge_rtt_ms",
        "p75_origin_rtt_ms",
        "p75_ttfb_ms",
        "p75_dom_ready_ms",
        "p75_page_load_ms",
        "p75_lcp_ms"
      ]
    },
    {
      "id": "rum_site_asn_summary",
      "query": "in:rum time:last_24h stats:\"count() as beacons, p75(lcp_ms) as p75_lcp_ms, p75(inp_ms) as p75_inp_ms, p75(ttfb_ms) as p75_ttfb_ms, p75(cdn_edge_rtt_ms) as p75_edge_rtt_ms, p75(cdn_origin_rtt_ms) as p75_origin_rtt_ms, sum(has_error) as error_beacons by prefix_tag, asn, as_org\" sort:beacons:desc limit:100",
      "encoding": "json_rows",
      "limit": 100,
      "refresh_interval_ms": 30000,
      "required": true,
      "fields": [
        "prefix_tag",
        "asn",
        "as_org",
        "beacons",
        "p75_lcp_ms",
        "p75_inp_ms",
        "p75_ttfb_ms",
        "p75_edge_rtt_ms",
        "p75_origin_rtt_ms",
        "error_beacons"
      ]
    },
    {
      "id": "rum_cdn_summary",
      "query": "in:rum time:last_24h stats:\"count() as beacons, p75(cdn_edge_rtt_ms) as p75_edge_rtt_ms, p75(cdn_origin_rtt_ms) as p75_origin_rtt_ms, p75(ttfb_ms) as p75_ttfb_ms by cdn_provider, cdn_cache_status\" sort:beacons:desc limit:20",
      "encoding": "json_rows",
      "limit": 20,
      "refresh_interval_ms": 30000,
      "required": false,
      "fields": [
        "cdn_provider",
        "cdn_cache_status",
        "beacons",
        "p75_edge_rtt_ms",
        "p75_origin_rtt_ms",
        "p75_ttfb_ms"
      ]
    },
    {
      "id": "rum_route_summary",
      "query": "in:rum time:last_24h stats:\"count() as beacons, p75(lcp_ms) as p75_lcp_ms, p75(inp_ms) as p75_inp_ms, p75(cls) as p75_cls, p75(ttfb_ms) as p75_ttfb_ms, sum(has_error) as error_beacons by canonical_origin, metric_path\" sort:beacons:desc limit:100",
      "encoding": "json_rows",
      "limit": 100,
      "refresh_interval_ms": 30000,
      "required": false,
      "fields": [
        "canonical_origin",
        "metric_path",
        "beacons",
        "p75_lcp_ms",
        "p75_inp_ms",
        "p75_cls",
        "p75_ttfb_ms",
        "error_beacons"
      ]
    },
    {
      "id": "rum_recent_beacons",
      "query": "in:rum time:last_24h sort:observed_at:desc limit:200",
      "encoding": "json_rows",
      "limit": 200,
      "refresh_interval_ms": 30000,
      "required": true,
      "fields": [
        "beacon_id",
        "observed_at",
        "web_property_id",
        "canonical_origin",
        "environment",
        "url",
        "host",
        "path",
        "metric_path",
        "referrer",
        "page_group",
        "initiator",
        "trace_id",
        "span_id",
        "session_id",
        "device_type",
        "browser",
        "os",
        "lcp_ms",
        "inp_ms",
        "cls",
        "fcp_ms",
        "ttfb_ms",
        "page_load_ms",
        "dns_ms",
        "connect_ms",
        "tls_ms",
        "dom_ready_ms",
        "rage_clicks",
        "js_errors",
        "http_status",
        "has_error",
        "cdn_provider",
        "cdn_cache_status",
        "cdn_edge_rtt_ms",
        "cdn_origin_rtt_ms",
        "cdn_pop",
        "client_ip",
        "country",
        "region",
        "city",
        "asn",
        "as_org",
        "prefix_tag"
      ]
    },
    {
      "id": "web_properties",
      "query": "in:websites sort:name:asc limit:200",
      "encoding": "json_rows",
      "limit": 200,
      "refresh_interval_ms": 60000,
      "required": false,
      "fields": [
        "id",
        "name",
        "canonical_origin",
        "environment",
        "edge_provider",
        "rum_enabled",
        "prefix_tags",
        "observed_asns",
        "tls_not_after"
      ]
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "defaultWindow": {
        "type": "string",
        "title": "Default time window",
        "default": "last_24h"
      },
      "lcpGoodThresholdMs": {
        "type": "number",
        "title": "LCP Good threshold (ms)",
        "default": 2500
      },
      "lcpPoorThresholdMs": {
        "type": "number",
        "title": "LCP Poor threshold (ms)",
        "default": 4000
      },
      "inpGoodThresholdMs": {
        "type": "number",
        "title": "INP Good threshold (ms)",
        "default": 200
      },
      "inpPoorThresholdMs": {
        "type": "number",
        "title": "INP Poor threshold (ms)",
        "default": 500
      },
      "clsGoodThreshold": {
        "type": "number",
        "title": "CLS Good threshold",
        "default": 0.1
      },
      "clsPoorThreshold": {
        "type": "number",
        "title": "CLS Poor threshold",
        "default": 0.25
      },
      "selectedWebPropertyId": {
        "type": "string",
        "title": "Default web property filter",
        "default": ""
      }
    }
  },
  "renderer": {
    "kind": "built_in",
    "interface_version": "dashboard-built-in-v1",
    "artifact": "web-rum",
    "trust": "first_party",
    "entrypoint": "web_rum",
    "sha256": "5c1edf1aab72b6e8ba3990af5af4629f6bc620f1e5e29360fc0a780457a0fcb3"
  }
}
