load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//third_party/crates:defs.bzl", "all_crate_deps")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "target/**",
        ],
    ),
)

# A NIF is loaded by the BEAM, which supplies the enif_* symbols at load time, so the
# shared object is linked with those symbols left undefined. That is the default for an
# ELF .so; Mach-O has to be told explicitly.
rust_shared_library(
    name = "god_view_nif",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "god_view_nif",
    edition = "2021",
    rustc_flags = select({
        "@platforms//os:macos": ["-Clink-arg=-Wl,-undefined,dynamic_lookup"],
        "//conditions:default": [],
    }),
    deps = all_crate_deps(normal = True) + [
    ],
)
