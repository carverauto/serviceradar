package(default_visibility = ["//visibility:public"])

# Explicit codec/seek acceptance only; this does not launch the product UI or
# exercise authentication. Run directly on RBE when recording bytes change.
playwright_bin.playwright_test(
    name = "camera_recording_browser_test",
    size = "medium",
    args = ["test", "--config=camera_recording.config.js"],
    chdir = package_name(),
    data = [
        "camera_recording.playwright.js",
        "camera_recording.config.js",
        "//elixir/serviceradar_core_elx:recording_browser_fixture",
        "//elixir/web-ng/assets:camera_recording_browser_test_lib",
        "//elixir/web-ng/assets:node_modules/@playwright/test",
    ],
    env = {
        "CAMERA_BROWSER_FIXTURE": "$(rootpath //elixir/serviceradar_core_elx:recording_browser_fixture)",
        "CI": "1",
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
    },
    exec_properties = {
        "container-image": "docker://registry.carverauto.dev/serviceradar/playwright-rbe@sha256:bdfda2a8fdf48707c5e50a49bd3e06d8d0c759153dc8ee057d8a81c3450bb3e9",
    },
    tags = ["acceptance_test", "external", "no-local", "no-remote-cache"],
)

