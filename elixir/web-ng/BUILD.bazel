# Compiled by Mix inside a single hermetic Bazel action. mix_env is "test" because
# mix.exs sets elixirc_paths(:test) => ["lib", "test/support"].
mix_app(
    name = "erlang_app",
    srcs = [
        ":srcs",
        # Signal display contracts, read at compile time and baked in with
        # @external_resource (lib/serviceradar_web_ng/observability/signal_display.ex).
        # It resolves them against Path.expand("../..", File.cwd!()), i.e. the repo root,
        # which is why mix_app mirrors the workspace layout inside the action.
        "//addons/powerdns:powerdns_manifest",
        "//go/cmd/wasm-plugins/axis:srcs",
        "//go/cmd/wasm-plugins/proxmox:srcs",
        "//go/cmd/wasm-plugins/unifi-protect:srcs",
        "//go/pkg/trivysidecar:display_contracts",
        "//integrations/falco:display_contracts",
    ],
    app_name = "serviceradar_web_ng",
    # Bazel builds the cdylib; Mix must not shell out to cargo.
    extra_config = [
        "config :serviceradar_web_ng, ServiceRadarWebNG.Topology.Native, skip_compilation?: true",
    ],
    mix_env = "test",
    native_libs = {
        "//elixir/web-ng/native/god_view_nif:god_view_nif": "god_view_nif",
    },
    deps = [
        "//elixir/connection:erlang_app",
        "//elixir/datasvc:erlang_app",
        "//elixir/serviceradar_core:erlang_app",
        "//elixir/serviceradar_srql:erlang_app",
