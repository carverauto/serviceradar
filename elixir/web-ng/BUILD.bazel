# Declared `only: [:dev, :test]` in mix.exs, most with `runtime: false`. Mix therefore
# excludes every one of them under MIX_ENV=prod -- but the Bazel :erlang_app_prod target was
# declaring them anyway, which staged them into the prod compile's ERL_LIBS and, more
# importantly, carried them through ErlangAppInfo into the OTP release closure that becomes
# the shipped image. Lint and static-analysis tooling has no business in a production
# release.
#
# Kept on the :test target, which is the env that actually resolves them.
WEB_NG_DEV_DEPS = [
    "@hexpm//:ash_credo",
    "@hexpm//:credo",
    "@hexpm//:dialyxir",
    "@hexpm//:ex_dna",
    "@hexpm//:ex_slop",
    "@hexpm//:igniter",
    "@hexpm//:jump_credo_checks",
    "@hexpm//:lazy_html",
    "@hexpm//:mix_audit",
    "@hexpm//:phoenix_live_reload",
    "@hexpm//:sobelow",
    "@hexpm//:styler",
]

# Compiled by Mix inside a single hermetic Bazel action. mix_env is "test" because
# mix.exs sets elixirc_paths(:test) => ["lib", "test/support"].
mix_app(
    name = "erlang_app",
    srcs = WEB_NG_SRCS,
    app_name = "serviceradar_web_ng",
    extra_config = WEB_NG_EXTRA_CONFIG,
    mix_env = "test",
    native_libs = WEB_NG_NATIVE_LIBS,
    deps = ["//elixir/serviceradar_core:erlang_app"] + WEB_NG_DEPS + WEB_NG_DEV_DEPS,
)

# The release build. Under :prod, elixirc_paths drops test/support and every
# Application.compile_env/2 read resolves against config/prod.exs rather than
# config/test.exs -- shipping the :test build would bake test configuration into the
# image. Pulls the :prod build of serviceradar_core for the same reason.
mix_app(
    name = "erlang_app_prod",
    srcs = WEB_NG_SRCS,
    app_name = "serviceradar_web_ng",
    extra_config = WEB_NG_EXTRA_CONFIG,
    mix_env = "prod",
    native_libs = WEB_NG_NATIVE_LIBS,
    deps = ["//elixir/serviceradar_core:erlang_app_prod"] + WEB_NG_DEPS,
)

# Assembly-only release: no deps.get, no recompilation, no cargo, no bun, no network.
# Application code comes from the ErlangAppInfo closure of :erlang_app_prod; the digested
# CSS/JS arrives as a declared overlay instead of being built inside this action.
elixir_release(
    name = "release_tar",
    srcs = [
        ":release_recipe",
        # Mix reads each PATH dependency's mix.exs to learn its app name and version,
        # transitively. Only the manifest is needed -- compiled code arrives via `app`.
        "//third_party/hex_vendored/connection:mix.exs",
        "//elixir/datasvc:mix.exs",
        "//third_party/hex_vendored/elixir_uuid:mix.exs",
        "//elixir/serviceradar_core:mix.exs",
        "//elixir/serviceradar_srql:mix.exs",
        "//third_party/hex_vendored/opentelemetry_oban:mix.exs",
    ],
    out = "serviceradar-web-ng-release.tar.gz",
    app = ":erlang_app_prod",
    # Named release matches mix.exs releases/0 (validate_compile_env: false).
    erts_otp_root = SHIPPED_ERTS_OTP_ROOT,
    erts_root_marker = SHIPPED_ERTS_ROOT_MARKER,
    # The same list :erlang_app_prod compiled with. `mix release` compares every
    # Application.compile_env/2 key against its compile-time value and refuses to assemble
    # if they differ, so these have to agree -- hence the shared variable rather than two
    # copies. serviceradar_core's entries are here for the same reason: it is part of the
    # release and was compiled with them.
    extra_config = WEB_NG_EXTRA_CONFIG + [
        "config :serviceradar_core, ServiceRadar.Observability.Zen.Native, skip_compilation?: true",
        "config :serviceradar_core, ServiceRadar.Observability.DispositionKernels, skip_compilation?: true",
    ],
    overlays = {
        "//elixir/web-ng/assets:static": "priv",
    },
    release_name = "serviceradar_web_ng",
)

ex_unit_tests(
    name = "unit_tests",
    # test/integration and test/property are excluded because this target is the
    # DATABASE-FREE tier, and not one file in either directory carries
    # @moduletag :db_free -- they need a database, the SRQL NIF, or AGE/Cypher.
    #
    # Globbing them in did not run them; it generated
    # //elixir/web-ng:unit_tests_integration and :unit_tests_property, which
    # loaded their files, excluded every test, and reported PASSED on
    # "0 tests, 0 failures (11 excluded)". Two green CI targets covering nothing,
    # for as long as they have existed. test_helper.exs now fails a target that
    # executes zero tests, which is what surfaced them.
    #
    # Excluding them states the truth -- these are not database-free tests --
    # instead of tagging them :db_free, which would make them run without the
    # database they need. They belong in a DB-backed target; until one exists
    # they are not covered by Bazel, and that is now visible rather than
    # disguised as green.
    srcs = glob(
        ["test/**/*_test.exs"],
        exclude = [
            "test/integration/**",
            "test/property/**",
        ],
    ),
    config_loader = "//build:elixir_test_config_loader.exs",
    data = glob(
        [
            "config/**",
            "lib/**",
            "priv/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = [
            # Named explicitly below as an audit runfile.
            "lib/**/*.heex",
            "test/**/*_test.exs",
            # Named explicitly below so the timestamp audit cannot lose its
            # checked classification artifact in a broad data-glob refactor.
            "test/fixtures/timestamp_formatter_inventory.json",
        ],
    ) + [
        # Runtime inputs for ContractRegistryTest's actual first-party package
        # reachability checks. mix_app compile inputs do not automatically become
        # an ex_unit_test's runfiles.
        "//addons/anomaly-addon:anomaly_manifest",
        "//addons/powerdns:powerdns_manifest",
        # assets/ is its own package; glob() here cannot see css/app.css.
        # DashboardLayoutTest reads it at runtime.
        "//elixir/web-ng/assets:css/app.css",
        # TimestampFormatterInventoryTest scans production JavaScript at runtime.
        # assets/ is a separate package, so these sources must be explicit runfiles.
        "//elixir/web-ng/assets:timestamp_formatter_audit_js_srcs",
        ":timestamp_formatter_audit_heex_srcs",
        "test/fixtures/timestamp_formatter_inventory.json",
        # PluginConfigFormTest reads the live OpenText schema via Path.expand
        # from __DIR__. ex_unit_test mirrors the workspace layout, so this
        # declared input is what makes that relative path exist in the sandbox.
        "//go/cmd/wasm-plugins/opentext-nom:config.schema.json",
        "//go/cmd/wasm-plugins/axis:srcs",
        "//go/cmd/wasm-plugins/proxmox:srcs",
        "//go/cmd/wasm-plugins/unifi-protect:srcs",
        # TimezoneMigrationTest asserts on the generated core migration, so its
        # cross-package source must be in runfiles.
        "//elixir/serviceradar_core:migrations",
    ],
    # web-ng already defines a database-free tier: with ALLOW_DB_FREE_TESTS set and neither
    # CI nor REQUIRE_DB_TESTS, test_helper.exs skips Application.ensure_all_started and runs
    # only `:db_free`-tagged tests (87 of 316 files). That is the project's own notion of
    # what runs without a database, so this job uses it rather than inventing a second one.
    # CI is pinned empty because the helper treats CI=true as "a database is required".
    env = {
        "SERVICERADAR_ALLOW_DB_FREE_TESTS": "1",
        "CI": "",
    },
    test_helper = "test/test_helper.exs",
    deps = [":erlang_app"],
)

# The database-free unit target above deliberately excludes the tagged cases in these files.
# Run them after the ordinary serviceradar_core integration lanes, when serial_0 is quiescent
# but still exists, so the guarded CI lifecycle gains focused coverage without provisioning
# another database or raising the observer's peak connection budget. This target is manual
# because Bazel cannot express its required ordering relative to the core lanes and fixture
# teardown. Its helper selects only `:web_ng_shared_fixture_db`; adding a source alone does not
# silently opt every pre-existing case in that file into this lane.
ex_unit_test(
    name = "networks_live_db_test",
    size = "enormous",
    srcs = [
        "test/app_domain/dashboards/group_access_db_test.exs",
        "test/app_domain/dashboards/report_jobs_test.exs",
        "test/phoenix/auth/sso_provisioning_test.exs",
        "test/phoenix/controllers/api/admin_authorization_test.exs",
        "test/phoenix/controllers/api/api_endpoint_integration_test.exs",
        "test/phoenix/live/alert_live/show_test.exs",
        "test/phoenix/live/authored_dashboard_live_test.exs",
        "test/phoenix/live/camera_analysis_worker_live_test.exs",
        "test/phoenix/live/device_live/endpoint_inventory_data_db_test.exs",
        "test/phoenix/live/device_live_test.exs",
        "test/phoenix/live/event_live/show_test.exs",
        "test/phoenix/live/log_live/index_test.exs",
        "test/phoenix/live/log_live/netflows_test.exs",
        "test/phoenix/live/log_live/show_test.exs",
        "test/phoenix/live/metric_live/timestamp_rendering_test.exs",
        "test/phoenix/live/security_dashboard_routes_test.exs",
        "test/phoenix/live/settings/ansible_live_test.exs",
        "test/phoenix/live/settings/networks_live_test.exs",
        "test/phoenix/live/settings/notifications_live_test.exs",
        "test/phoenix/live/settings/rbac_live_test.exs",
        "test/phoenix/live/settings/snmp_profiles_live/profile_lifecycle_test.exs",
        "test/phoenix/live/trace_live/show_test.exs",
        "test/phoenix/live/user_live/settings_test.exs",
        "test/serviceradar/identity/timezone_migration_db_test.exs",
        "test/serviceradar/identity/timezone_preference_test.exs",
    ],
    data = glob(
        [
            "config/**",
            "lib/**",
            "priv/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = ["test/**/*_test.exs"],
    ) + [
        "//build:elixir_test_config_loader.exs",
        "//build:run_id_file",
        "//config/environments:ci_binpb",
        "//elixir/serviceradar_core:config/test_database_guard.exs",
        "//elixir/serviceradar_core:test/db/fixture_config.exs",
        "//elixir/serviceradar_core:test/db/integration_env.exs",
        "//elixir/serviceradar_core:test/db/integration_env_config.exs",
    ],
    elixir_opts = [
        "-r",
        "../serviceradar_core/test/db/integration_env.exs",
        "-r",
        "../../build/elixir_test_config_loader.exs",
        "-r",
        "test/db/networks_live_db_test_helper.exs",
    ],
    env = {
        "SERVICERADAR_REQUIRE_DB_TESTS": "1",
        "SERVICERADAR_TEST_DATABASE_OWNERSHIP_TIMEOUT_MS": "600000",
        "SERVICERADAR_TEST_DB_SHARD": "serial_0",
        # A single RBAC LiveView mount starts three async database loads. Keep
        # enough connections for that fan-out plus the endpoint's own request
        # and application processes; the 15-second query timeout still catches
        # a real hang.
        "TEST_CNPG_POOL_SIZE": "8",
        "TEST_CNPG_QUEUE_INTERVAL_MS": "10000",
        "TEST_CNPG_QUEUE_TARGET_MS": "10000",
    },
    tags = [
        "integration_test",
        "manual",
    ],
    target_compatible_with = requires_shared_fixture(),
    deps = [
        ":erlang_app",
        "//config/manager_config/elixir:manager",
        "//config/manager_secret/elixir:secret",
    ],
)
