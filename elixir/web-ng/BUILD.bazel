# Read by //build/contracts:first_party_plugin_cosign_key_consistency_test. config/ has no BUILD file of its
# own, so the file lives in this package. It is already swept up by the `config/**` globs in
# :deps_srcs and :unit_tests, but naming it here is deliberate: relying on incidental
# filegroup membership would break the test the moment one of those globs is reorganised.
exports_files(["config/config.exs"])

# Standalone HEEx templates scanned at runtime by TimestampFormatterInventoryTest.
# Keep this a named input so a broad unit-test data-glob refactor cannot silently
# remove production templates from the audit.
filegroup(
    name = "timestamp_formatter_audit_heex_srcs",
    srcs = glob(
        ["lib/**/*.heex"],
        allow_empty = True,
    ),
)

# Read by //integration_tests/srql_parity:srql_parity_test (task 1.5 of the
# extend-starrocks-to-all-telemetry change): every SRQL chart query a checked-in dashboard or
# dashboard package defines for a warehouse-served entity must have a parity inventory entry.
# A named input, so a refactor of the broader globs cannot silently drop definitions from the audit.
filegroup(
    name = "srql_dashboard_definitions",
    srcs = glob(
        [
            "priv/dashboards/**/*.json",
            "priv/dashboard-packages/**/*.json",
        ],
    ),
)

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "million_world_browser_fixture.json",
            "_build/**",
            "assets/**",
            "deps/**",
            "native/**/target/**",
            "node_modules/**",
            "priv/plts/**",
            "tmp/**",
            ".git/**",
        ],
    ) + [
        # assets/ is its own package now (it owns package-lock.json for npm_translate_lock),
        # and a glob does not cross a package boundary. Without this label the assets would
        # drop out of every consumer silently -- the excluded "assets/**" above is there to
        # make that fact explicit rather than implied.
        "//elixir/web-ng/assets:all_srcs",
    ],
)

filegroup(
    name = "deps_srcs",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(["config/**"]),
)

# What `mix compile` actually needs -- :srcs minus the test files it never compiles.
# See the long note on //elixir/serviceradar_core:compile_srcs; the reasoning is identical.
# mix.exs:54 is `elixirc_paths(:test), do: ["lib", "test/support"]`, so 324 of the 343 files
# under test/ were declared inputs that the application never reads, and touching any one of
# them rebuilt this app plus everything downstream of it.
filegroup(
    name = "compile_srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "million_world_browser_fixture.json",
            "_build/**",
            "assets/**",
            "deps/**",
            "native/**/target/**",
            "node_modules/**",
            "priv/plts/**",
            "tmp/**",
            ".git/**",
            "test/**",
        ],
    ) + glob(
        ["test/support/**"],
        allow_empty = True,
    ) + [
        # Same reason as :srcs -- assets/ is its own package and a glob cannot cross the
        # boundary, so the label is named explicitly.
        "//elixir/web-ng/assets:all_srcs",
    ],
)

# The release RECIPE, as opposed to the release CONTENTS: mix.exs supplies releases/0,
# config/ and rel/ supply what `mix release` renders. Compiled code is not here -- it
# reaches the release through the ErlangAppInfo closure of :erlang_app_prod.
filegroup(
    name = "release_recipe",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(
        [
            "config/**",
            "rel/**",
        ],
        allow_empty = True,
    ),
)

# Read by Tailwind, not by Elixir. css/app.css declares
# `@source "../../lib/serviceradar_web_ng_web"`, so v4 scans these templates to decide
# which utility classes to emit; without them as declared inputs the stylesheet builds
# clean and nearly empty, and the change would not invalidate the CSS bundle.
#
# copy_to_bin, not a plain filegroup: rules_js stages every src of a js_run_binary through
# copy_to_bin, which refuses a source file owned by a different package. Copying them here,
# in their own package, makes them bazel-out files that //elixir/web-ng/assets can consume.
# It also lands them at bazel-out/.../elixir/web-ng/lib/..., which is exactly where
# `@source "../../lib/serviceradar_web_ng_web"` resolves from the assets working directory.
copy_to_bin(
    name = "web_templates",
    srcs = glob(
        [
            "lib/serviceradar_web_ng_web/**/*.ex",
            "lib/serviceradar_web_ng_web/**/*.heex",
        ],
        allow_empty = True,
    ),
)

# Static files that are committed rather than generated. mix_release preserved these by
# copying them aside before wiping priv/static; as a target they are just inputs.
#
# The excludes are the gitignored outputs of the local asset loop AGENTS.md documents:
# `npm run build:js` / `build:css` write priv/static/assets, `mix phx.digest` writes
# cache_manifest.json. Neither exists in a clean CI checkout, so the glob only picks them
# up on a developer's machine -- where they collide with the Bazel-built bundles that
# //elixir/web-ng/assets:static_undigested already gets from :css_bundle and :js_bundle,
# taking down `make test`. Do NOT reach for allow_overwrites instead: it resolves the
# collision by source order, which would let a stale local bundle shadow the one Bazel
# just built.
filegroup(
    name = "static_files",
    srcs = glob(
        ["priv/static/**"],
        allow_empty = True,
        exclude = [
            "priv/static/assets/**",
            "priv/static/cache_manifest.json",
        ],
    ),
)

