load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@serviceradar//build:elixir_tests.bzl", "ex_unit_tests")
load("@serviceradar//build:mix_app.bzl", "mix_app")
load("//build:elixir_release.bzl", "elixir_release")

# REMOVED FOR NOW: :precommit / :precommit_check, and the two mix_deps cache layers
# (:deps_cache, :path_deps_cache) that existed only to feed them.
#
# :precommit_check fails on `mix format --check-formatted` against pre-existing HEEx
# formatting, which has nothing to do with the build graph and blocks `//elixir/...` from
# going green. The two cache layers went with it because nothing else consumed them, and
# :deps_cache alone was a 214s `mix deps.get + deps.compile` action -- the second-largest
# single action in the Elixir tree.
#
# Restore from git history once the tree is formatted; //build:mix_deps.bzl and
# //build:mix_precommit.bzl are untouched.
#
# Two CI references went with it, and both have to come back deliberately:
#
#   * .forgejo/workflows/precommit-web-ng.yml was deleted. Its only substantive step was
#     `bazel test //elixir/web-ng:precommit`, so with the target gone every run exited 1.
#   * main.yml's test sweep dropped its `except set(//elixir/web-ng:precommit)` clause. That
#     was not cosmetic: `set()` hard-errors on an unknown label, so the dangling reference
#     aborted the entire query with exit 7 and the sweep ran no tests at all.
#
# The exclusion existed so a web-ng lint failure produced its own red X rather than one
# indistinguishable from a compile break. If the target returns, decide again whether that is
# worth a separate workflow before re-adding either reference.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "assets/**",
            "deps/**",
            "native/**/target/**",
            "node_modules/**",
            "tmp/**",
            ".git/**",
        ],
    ) + [
        # assets/ is its own package now (it owns package-lock.json for npm_translate_lock),
        # and a glob does not cross a package boundary. Without this label the assets would
        # drop out of every consumer silently -- the excluded "assets/**" above is there to
        # make that fact explicit rather than implied.
        "//elixir/web-ng/assets:all_srcs",
    ],
)

filegroup(
    name = "deps_srcs",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(["config/**"]),
)

# The release RECIPE, as opposed to the release CONTENTS: mix.exs supplies releases/0,
# config/ and rel/ supply what `mix release` renders. Compiled code is not here -- it
# reaches the release through the ErlangAppInfo closure of :erlang_app_prod.
filegroup(
    name = "release_recipe",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(
        [
            "config/**",
            "rel/**",
        ],
        allow_empty = True,
    ),
)

# Read by Tailwind, not by Elixir. css/app.css declares
# `@source "../../lib/serviceradar_web_ng_web"`, so v4 scans these templates to decide
# which utility classes to emit; without them as declared inputs the stylesheet builds
# clean and nearly empty, and the change would not invalidate the CSS bundle.
#
# copy_to_bin, not a plain filegroup: rules_js stages every src of a js_run_binary through
# copy_to_bin, which refuses a source file owned by a different package. Copying them here,
# in their own package, makes them bazel-out files that //elixir/web-ng/assets can consume.
# It also lands them at bazel-out/.../elixir/web-ng/lib/..., which is exactly where
# `@source "../../lib/serviceradar_web_ng_web"` resolves from the assets working directory.
copy_to_bin(
    name = "web_templates",
    srcs = glob(
        [
            "lib/serviceradar_web_ng_web/**/*.ex",
            "lib/serviceradar_web_ng_web/**/*.heex",
        ],
        allow_empty = True,
    ),
)

# Static files that are committed rather than generated. mix_release preserved these by
# copying them aside before wiping priv/static; as a target they are just inputs.
filegroup(
    name = "static_files",
    srcs = glob(
        ["priv/static/**"],
        allow_empty = True,
    ),
)

# Shared between the :test and :prod compilations below, which differ only in mix_env.
WEB_NG_SRCS = [
    ":srcs",
        # Signal display contracts, read at compile time and baked in with
        # @external_resource (lib/serviceradar_web_ng/observability/signal_display.ex).
        # It resolves them against Path.expand("../..", File.cwd!()), i.e. the repo root,
        # which is why mix_app mirrors the workspace layout inside the action.
        "//addons/powerdns:powerdns_manifest",
        "//go/cmd/wasm-plugins/axis:srcs",
        "//go/cmd/wasm-plugins/proxmox:srcs",
        "//go/cmd/wasm-plugins/unifi-protect:srcs",
        "//go/pkg/trivysidecar:display_contracts",
    "//integrations/falco:display_contracts",
]

# Bazel builds the cdylib; Mix must not shell out to cargo.
WEB_NG_EXTRA_CONFIG = [
    "config :serviceradar_web_ng, ServiceRadarWebNG.Topology.Native, skip_compilation?: true",
]

WEB_NG_NATIVE_LIBS = {
    "//elixir/web-ng/native/god_view_nif:god_view_nif": "god_view_nif",
}

# serviceradar_core is deliberately absent: each mix_app below prepends the build of it
