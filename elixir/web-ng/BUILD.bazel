ex_unit_tests(
    name = "unit_tests",
    srcs = glob(["test/**/*_test.exs"]),
    data = glob(
        [
            "config/**",
            "lib/**",
            "priv/**",
            "test/**",
        ],
        allow_empty = True,
        exclude = ["test/**/*_test.exs"],
    ),
    # web-ng already defines a database-free tier: with ALLOW_DB_FREE_TESTS set and neither
    # CI nor REQUIRE_DB_TESTS, test_helper.exs skips Application.ensure_all_started and runs
    # only `:db_free`-tagged tests (87 of 316 files). That is the project's own notion of
    # what runs without a database, so this job uses it rather than inventing a second one.
    # CI is pinned empty because the helper treats CI=true as "a database is required".
    env = {
        "SERVICERADAR_ALLOW_DB_FREE_TESTS": "1",
        "CI": "",
    },
    test_helper = "test/test_helper.exs",
    deps = [":erlang_app"],
)
