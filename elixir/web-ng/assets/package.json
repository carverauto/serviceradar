{
  "name": "serviceradar-web-ng-assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss --input=css/app.css --output=../priv/static/assets/css/app.css",
    "build:css:minify": "tailwindcss --input=css/app.css --output=../priv/static/assets/css/app.css --minify",
    "build:js": "esbuild js/app.js js/theme_init.js --bundle --target=es2022 --outdir=../priv/static/assets/js --public-path=/assets/js --external:/fonts/* --external:/images/* --alias:@=. --alias:react=./node_modules/react --alias:react-dom=./node_modules/react-dom --alias:stream=stream-browserify --alias:phoenix_live_view=./vendor/phoenix_live_view.esm.js --loader:.ttf=file --loader:.woff=file --loader:.woff2=file --loader:.wasm=file && cp js/wasm/god_view_exec.wasm ../priv/static/assets/js/god_view_exec.wasm",
    "build:js:minify": "esbuild js/app.js js/theme_init.js --bundle --target=es2022 --outdir=../priv/static/assets/js --public-path=/assets/js --external:/fonts/* --external:/images/* --alias:@=. --alias:react=./node_modules/react --alias:react-dom=./node_modules/react-dom --alias:stream=stream-browserify --alias:phoenix_live_view=./vendor/phoenix_live_view.esm.js --loader:.ttf=file --loader:.woff=file --loader:.woff2=file --loader:.wasm=file --minify && cp js/wasm/god_view_exec.wasm ../priv/static/assets/js/god_view_exec.wasm",
    "test": "bunx vitest run js/lib/god_view/*.test.js js/wasm/*.test.js js/lib/remote_desktop/*.test.js js/lib/srql/*.test.js js/utils/*.test.js js/hooks/charts/*.test.js js/hooks/CredentialDeepLinkFocus.test.js js/hooks/DashboardWasmHost.test.js js/hooks/DetailsState.test.js js/hooks/DialogTopLayer.test.js js/hooks/ToastTopLayer.test.js js/hooks/RemoteAccessDesktopSession.test.js js/hooks/RemoteAccessSSHConsole.test.js js/hooks/RemoteConsoleTerminal.test.js js/hooks/SRQLInput.test.js js/hooks/SRQLTimeCookie.test.js js/hooks/SettingsNavTree.test.js component/test/DashboardBuilderCanvas.test.jsx component/test/DashboardPanelChart.test.jsx component/test/RemoteAccessDesktopSession.test.jsx component/test/RemoteAccessSSHConsole.test.jsx component/test/RemoteAccessTerminal.test.jsx component/test/RemoteAccessSSHConsoleHostKey.test.jsx component/test/RemoteAccessSSHConsoleSession.test.jsx component/test/RemoteAccessSSHConsoleRememberKey.test.jsx component/test/sshEphemeralKeypair.test.js",
    "test:dashboard_host": "bunx vitest run js/hooks/DashboardWasmHost.test.js",
    "test:god_view:contracts": "bunx vitest run js/lib/god_view/*contract*.test.js js/lib/god_view/renderer_deps.test.js",
    "lint": "bunx eslint js/**/*.js",
    "lint:god_view": "bunx eslint js/lib/god_view/**/*.js",
    "typecheck:god_view": "bunx tsc -p js/lib/god_view/tsconfig.json --noEmit",
    "precommit:god_view": "bun run lint:god_view && bun run test:god_view:contracts && bun run typecheck:god_view"
  },
