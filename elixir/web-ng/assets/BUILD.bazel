# Everything under assets/, minus installed dependency trees. node_modules is listed in
# //.bazelignore, so Bazel does not see it; the excludes here are belt-and-braces for a
# developer working tree where an install has already happened.
filegroup(
    name = "all_srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "node_modules/**",
            "component/node_modules/**",
            "**/target/**",
        ],
    ),
)

# Inputs both bundlers read: the stylesheet entry, the JS tree, the vendored Tailwind
# plugins (css/app.css does `@plugin "../vendor/heroicons"`), and the React component
# sources that Tailwind scans via `@source "../component/src"`.
filegroup(
    name = "bundle_srcs",
    srcs = glob(
        [
            "css/**",
            "js/**",
            "vendor/**",
            "component/src/**",
        ],
        allow_empty = True,
    ),
)

# css/app.css declares `@source "../../lib/serviceradar_web_ng_web"`, so Tailwind v4 reads
# the HEEx templates to decide which utility classes to emit. Leave these out and the
# stylesheet builds clean and ships almost empty.
tailwind_bin.tailwindcss(
    name = "css_bundle",
    srcs = [
        ":bundle_srcs",
        ":node_modules",
        "//elixir/web-ng:web_templates",
    ],
    outs = ["static/assets/css/app.css"],
    args = [
        "--input=css/app.css",
        "--output=static/assets/css/app.css",
        "--minify",
    ],
    chdir = package_name(),
)

# Driven through esbuild.config.mjs rather than the generated `bin.esbuild`: that bin is
# the platform-native executable and rules_js would hand it to node. See the comment at
# the top of esbuild.config.mjs.
js_binary(
    name = "bundler",
    data = [":node_modules/esbuild"],
    entry_point = "esbuild.config.mjs",
)

# out_dirs, not outs: the `file` loaders make esbuild emit content-hashed copies of every
# font and wasm blob it encounters, and those names cannot be predicted at analysis time.
js_run_binary(
    name = "js_bundle",
    srcs = [
        ":bundle_srcs",
        ":node_modules",
    ],
    args = ["static/assets/js"],
    chdir = package_name(),
    out_dirs = ["static/assets/js"],
    tool = ":bundler",
)

# The undigested static tree: generated bundles plus the files that are checked in
# (favicon, robots.txt, images, openapi.json). mix_release preserved those by copying them
# aside before wiping priv/static; here they are simply inputs.
copy_to_directory(
    name = "static_undigested",
    srcs = [
        ":css_bundle",
        ":js_bundle",
        "//elixir/web-ng:static_files",
    ],
    replace_prefixes = {
        "static/": "",
        "priv/static/": "",
    },
    root_paths = [
        package_name(),
        "elixir/web-ng/priv/static",
    ],
)

# config/prod.exs sets `cache_static_manifest: "priv/static/cache_manifest.json"`, so the
# release needs the digested tree, not the raw one. Output is a tar consumed by
# //elixir/web-ng:release_assembled through elixir_release's `overlays`.
phoenix_digest(
    name = "static",
    src = ":static_undigested",
    out = "static.tar.gz",
    prefix = "static",
)
