            "component/**/generated/**",
            "component/**/static/**",
            "component/**/vendor/**",
            "js/**/*.test.js",
            "js/**/*.test.jsx",
            "js/**/*.test.ts",
            "js/**/*.test.tsx",
            "js/**/*.spec.js",
            "js/**/*.spec.jsx",
            "js/**/*.spec.ts",
