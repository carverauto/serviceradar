            "component/**/*.test.jsx",
            "component/**/*.test.ts",
            "component/**/*.test.tsx",
            "component/**/*.spec.js",
            "component/**/*.spec.jsx",
            "component/**/*.spec.ts",
            "component/**/*.spec.tsx",
            "component/test/**",
            "component/**/test/**",
