"""web-ng browser assets, built by Bazel instead of inside the release action.

Adding this file makes assets/ its own Bazel package, which is required for
`npm.npm_translate_lock` in //MODULE.bazel to address package-lock.json by label.

IMPORTANT: a `glob` never crosses a package boundary. The moment this BUILD file exists,
`glob(["**"])` in //elixir/web-ng stops matching anything under assets/ -- silently, with
no error. Every target that needs the asset sources must therefore depend on :all_srcs
explicitly. //elixir/web-ng:srcs does; if you add another consumer of the web-ng tree,
it needs :all_srcs too, or it will build against a project with no CSS and no JS.

What this replaces: //build:mix_release.bzl ran `bun install` (twice, against a
node_modules symlinked out of the executor's mutable /cache), then `mix tailwind`,
`mix esbuild` and `mix phx.digest`, all inside the single release action. That made every
Elixir source change re-run the entire JS toolchain. Here they are ordinary targets keyed
on assets/** and the HEEx templates, so an .ex-only change is a cache hit.
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@web_ng_npm//:defs.bzl", "npm_link_all_packages")
load("@web_ng_npm//elixir/web-ng/assets:@tailwindcss/cli/package_json.bzl", tailwind_bin = "bin")
load("@web_ng_npm//elixir/web-ng/assets:vitest/package_json.bzl", vitest_bin = "bin")
load("//build:phoenix_digest.bzl", "phoenix_digest")

package(default_visibility = ["//visibility:public"])

exports_files([
    "package-lock.json",
    "css/app.css",
])

# Materializes node_modules from the checked-in pnpm-lock.yaml as a Bazel-managed tree.
# This is what replaces `bun install`, and with it the node_modules symlink into the
# executor's mutable /cache.
npm_link_all_packages(name = "node_modules")

