{
  "alert_policy": {
    "cooldown_seconds": 300,
    "emit_ocsf_transition": true,
    "open_on_statuses": [],
    "priority": 1,
    "renotify_seconds": 21600,
    "threshold": 1,
    "window_seconds": 300
  },
  "credential_slots": [],
  "description": "Reports Proxmox virtual machines that are paused, stopped on an I/O error or panicked while Proxmox still lists them as running.",
  "edges": [
    {
      "id": "e1",
      "source": "fresh_guests",
      "source_handle": "signal",
      "target": "assert_fresh",
      "target_handle": "in"
    },
    {
      "id": "e2",
      "source": "paused_guests",
      "source_handle": "signal",
      "target": "assert_paused",
      "target_handle": "in"
    },
    {
      "id": "e3",
      "source": "unreported_guests",
      "source_handle": "signal",
      "target": "assert_unreported",
      "target_handle": "in"
    },
    {
      "id": "e4",
      "source": "assert_fresh",
      "source_handle": "verdict",
      "target": "decide",
      "target_handle": "in:fresh"
    },
    {
      "id": "e5",
      "source": "assert_paused",
      "source_handle": "verdict",
      "target": "decide",
      "target_handle": "in:paused"
    },
    {
      "id": "e6",
      "source": "assert_unreported",
      "source_handle": "verdict",
      "target": "decide",
      "target_handle": "in:unreported"
    },
    {
      "id": "e7",
      "source": "decide",
      "source_handle": "verdict",
      "target": "out_1",
      "target_handle": "in"
    }
  ],
  "inputs": [],
  "managed": true,
  "name": "Proxmox Paused Guests",
  "nodes": [
    {
      "config": {
        "limit": 100,
        "query": "in:virtualization_guests time:last_1h limit:1",
        "result_mode": "count"
      },
      "id": "fresh_guests",
      "kind": "srql_query",
      "label": "Guests Reported"
    },
    {
      "config": {
        "limit": 100,
        "query": "in:virtualization_guests status:paused time:last_1h",
        "result_mode": "count"
      },
      "id": "paused_guests",
      "kind": "srql_query",
      "label": "Paused Guests"
    },
    {
      "config": {
        "limit": 100,
        "query": "in:virtualization_guests status:running runtime_state:unknown time:last_1h",
        "result_mode": "count"
      },
      "id": "unreported_guests",
      "kind": "srql_query",
      "label": "Runtime State Not Reported"
    },
    {
      "config": {
        "crit": {
          "op": "<",
          "value": 1
        },
        "field": "count"
      },
      "id": "assert_fresh",
      "kind": "threshold_assert",
      "label": "Guests Were Reported"
    },
    {
      "config": {
        "crit": {
          "op": ">=",
          "value": 1
        },
        "field": "count"
      },
      "id": "assert_paused",
      "kind": "threshold_assert",
      "label": "No Guest Paused"
    },
    {
      "config": {
        "crit": {
          "op": ">=",
          "value": 1
        },
        "field": "count"
      },
      "id": "assert_unreported",
      "kind": "threshold_assert",
      "label": "Every Runtime State Reported"
    },
    {
      "config": {
        "inputs": [
          {
            "field": "status",
            "key": "fresh",
            "label": "Guests reported in the last hour"
          },
          {
            "field": "status",
            "key": "paused",
            "label": "Paused guests"
          },
          {
            "field": "status",
            "key": "unreported",
            "label": "Running guests without a runtime state"
          }
        ],
        "rules": [
          {
            "id": "paused",
            "match": {
              "paused": "down"
            },
            "status": "down",
            "summary": "At least one Proxmox guest is paused. A full datastore is the usual cause.",
            "verdict": "guests_paused"
          },
          {
            "id": "paused_unreadable",
            "match": {
              "paused": "unknown"
            },
            "status": "unknown",
            "summary": "The paused-guest query returned no result.",
            "verdict": "paused_guest_query_failed"
          },
          {
            "id": "no_inventory",
            "match": {
              "fresh": [
                "down",
                "unknown"
              ]
            },
            "status": "unknown",
            "summary": "No Proxmox guest was reported in the last hour, so paused guests cannot be detected.",
            "verdict": "no_fresh_guest_inventory"
          },
          {
            "id": "runtime_state_unreadable",
            "match": {
              "unreported": "unknown"
            },
            "status": "unknown",
            "summary": "The query for running guests without a runtime state returned no result.",
            "verdict": "runtime_state_query_failed"
          },
          {
            "id": "cannot_tell",
            "match": {
              "unreported": "down"
            },
            "status": "unknown",
            "summary": "Some running guests have no runtime state. The agent that runs the Proxmox plugin is too old to read it; upgrade that agent.",
            "verdict": "runtime_state_not_reported"
          },
          {
            "id": "all_running",
            "match": {
              "fresh": "healthy",
              "paused": "healthy",
              "unreported": "healthy"
            },
            "status": "healthy",
            "summary": "Every running guest reported a healthy runtime state.",
            "verdict": "no_paused_guests"
          },
          {
            "id": "undetermined",
            "match": {
              "fresh": "*",
              "paused": "*",
              "unreported": "*"
            },
            "status": "unknown",
            "summary": "The paused-guest state could not be determined.",
            "verdict": "paused_guest_state_unknown"
          }
        ]
      },
      "id": "decide",
      "kind": "decision_table",
      "label": "Paused Guest Decision"
    },
    {
      "config": {},
      "id": "out_1",
      "kind": "alert_output",
      "label": "Paused Guest Verdict"
    }
  ],
  "pack_id": "io.serviceradar.proxmox-monitoring",
  "pack_version": "0.1.0",
  "parameter_overrides": {},
  "schedule": {
    "interval_seconds": 120,
    "jitter_seconds": 15,
    "timeout_seconds": 30
  },
  "schema_version": 1,
  "slug": "proxmox-paused-guests",
  "state": "enabled",
  "target_binding": {
    "mode": "singleton"
  },
  "ui_layout": {
    "nodes": {
      "assert_fresh": {
        "x": 340,
        "y": 60
      },
      "assert_paused": {
        "x": 340,
        "y": 200
      },
      "assert_unreported": {
        "x": 340,
        "y": 340
      },
      "decide": {
        "x": 600,
        "y": 200
      },
      "fresh_guests": {
        "x": 80,
        "y": 60
      },
      "out_1": {
        "x": 860,
        "y": 200
      },
      "paused_guests": {
        "x": 80,
        "y": 200
      },
      "unreported_guests": {
        "x": 80,
        "y": 340
      }
    }
  }
}
