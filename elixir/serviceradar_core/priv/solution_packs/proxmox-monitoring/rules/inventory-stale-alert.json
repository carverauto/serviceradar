{
  "alert": {
    "severity": "critical",
    "title": "Proxmox inventory is stale"
  },
  "bucket_seconds": 60,
  "cooldown_seconds": 300,
  "description": "Opens a critical alert when no Proxmox host was reported in the last hour.",
  "event": {
    "log_name": "alert.proxmox_monitoring.proxmox_inventory_stale",
    "message": "Proxmox inventory is stale"
  },
  "group_by": [
    "check_slug",
    "target_key"
  ],
  "install_state": "enabled",
  "kind": "stateful_alert_rule",
  "match": {
    "attribute_equals": {
      "check_slug": "proxmox-inventory-freshness",
      "to_status": "down"
    },
    "recovery": {
      "attribute_equals": {
        "check_slug": "proxmox-inventory-freshness",
        "to_status": "healthy"
      },
      "subject_prefix": "declarative_check.health.state_change"
    },
    "subject_prefix": "declarative_check.health.state_change"
  },
  "name": "proxmox_inventory_stale",
  "priority": 20,
  "renotify_seconds": 86400,
  "signal": "event",
  "threshold": 1,
  "window_seconds": 300
}
