{
  "alert": {
    "severity": "critical",
    "title": "Proxmox guests are paused"
  },
  "bucket_seconds": 60,
  "cooldown_seconds": 300,
  "description": "Opens a critical alert when a Proxmox guest is paused, stopped on an I/O error or panicked.",
  "event": {
    "log_name": "alert.proxmox_monitoring.proxmox_guests_paused",
    "message": "Proxmox guests are paused"
  },
  "group_by": [
    "check_slug",
    "target_key"
  ],
  "install_state": "enabled",
  "kind": "stateful_alert_rule",
  "match": {
    "attribute_equals": {
      "check_slug": "proxmox-paused-guests",
      "to_status": "down"
    },
    "recovery": {
      "attribute_equals": {
        "check_slug": "proxmox-paused-guests",
        "to_status": "healthy"
      },
      "subject_prefix": "declarative_check.health.state_change"
    },
    "subject_prefix": "declarative_check.health.state_change"
  },
  "name": "proxmox_guests_paused",
  "priority": 10,
  "renotify_seconds": 86400,
  "signal": "event",
  "threshold": 1,
  "window_seconds": 300
}
