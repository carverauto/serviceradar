{
  "alert": {
    "severity": "critical",
    "title": "Camera semantic search media-worker /readyz endpoint is unready"
  },
  "bucket_seconds": 60,
  "cooldown_seconds": 300,
  "description": "Alerts when the media-worker /readyz readiness probe transitions to down.",
  "event": {
    "log_name": "health.camera_media_worker_unready"
  },
  "group_by": [
    "check_slug",
    "target_key"
  ],
  "install_state": "enabled",
  "kind": "stateful_alert_rule",
  "match": {
    "attribute_equals": {
      "check_slug": "media-worker-readiness",
      "to_status": "down"
    },
    "recovery": {
      "attribute_equals": {
        "check_slug": "media-worker-readiness",
        "to_status": "healthy"
      },
      "subject_prefix": "declarative_check.health.state_change"
    },
    "subject_prefix": "declarative_check.health.state_change"
  },
  "name": "camera_media_worker_unready",
  "priority": 20,
  "renotify_seconds": 21600,
  "signal": "event",
  "threshold": 1,
  "window_seconds": 300
}
