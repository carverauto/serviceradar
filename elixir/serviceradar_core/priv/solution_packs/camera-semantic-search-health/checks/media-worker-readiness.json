{
  "alert_policy": {
    "cooldown_seconds": 300,
    "emit_ocsf_transition": true,
    "open_on_statuses": [
      "down"
    ],
    "priority": 2,
    "renotify_seconds": 21600,
    "threshold": 1,
    "window_seconds": 300
  },
  "credential_slots": [],
  "description": "Probes the media-worker /readyz endpoint to confirm semantic clip inference readiness and response latency.",
  "edges": [
    {
      "id": "e1",
      "source": "probe_readyz",
      "source_handle": "signal",
      "target": "extract_ready",
      "target_handle": "in"
    },
    {
      "id": "e2",
      "source": "extract_ready",
      "source_handle": "value",
      "target": "assert_ready",
      "target_handle": "in"
    },
    {
      "id": "e3",
      "source": "assert_ready",
      "source_handle": "verdict",
      "target": "out_1",
      "target_handle": "in"
    }
  ],
  "inputs": [
    {
      "default": {
        "$pack_param": "worker_latency_warn_ms"
      },
      "description": "Warning latency threshold in milliseconds for media-worker readiness probes",
      "key": "worker_latency_warn_ms",
      "max": 15000,
      "min": 50,
      "type": "integer"
    },
    {
      "default": {
        "$pack_param": "worker_latency_crit_ms"
      },
      "description": "Critical latency threshold in milliseconds for media-worker readiness probes",
      "key": "worker_latency_crit_ms",
      "max": 30000,
      "min": 100,
      "type": "integer"
    }
  ],
  "managed": true,
  "name": "Media Worker Readiness",
  "nodes": [
    {
      "config": {
        "expected_statuses": [
          200
        ],
        "follow_redirects": false,
        "method": "GET",
        "timeout_ms": 5000,
        "url": {
          "$pack_param": "media_worker_readyz_url"
        }
      },
      "id": "probe_readyz",
      "kind": "http_request",
      "label": "GET media-worker /readyz"
    },
    {
      "config": {
        "cast": "number",
        "field": "latency_ms",
        "output_key": "latency_ms",
        "source_type": "field"
      },
      "id": "extract_ready",
      "kind": "extract_field",
      "label": "Extract Readiness Latency"
    },
    {
      "config": {
        "crit": {
          "op": ">=",
          "value": "{{inputs.worker_latency_crit_ms}}"
        },
        "field": "latency_ms",
        "warn": {
          "op": ">=",
          "value": "{{inputs.worker_latency_warn_ms}}"
        }
      },
      "id": "assert_ready",
      "kind": "threshold_assert",
      "label": "Readiness Latency Thresholds"
    },
    {
      "config": {
        "verdict_map": {
          "degraded": "media_worker_slow",
          "down": "media_worker_not_ready",
          "healthy": "media_worker_ready",
          "unknown": "media_worker_probe_unknown"
        }
      },
      "id": "out_1",
      "kind": "alert_output",
      "label": "Media Worker Verdict"
    }
  ],
  "pack_id": "io.serviceradar.camera-semantic-search-health",
  "pack_version": "0.1.0",
  "parameter_overrides": {},
  "schedule": {
    "interval_seconds": 60,
    "jitter_seconds": 10,
    "timeout_seconds": 20
  },
  "schema_version": 1,
  "slug": "media-worker-readiness",
  "state": "enabled",
  "target_binding": {
    "mode": "service_targets",
    "target_ids": [
      "http://serviceradar-media-worker.example.internal:8096/readyz"
    ],
    "url": "http://serviceradar-media-worker.example.internal:8096/readyz"
  },
  "ui_layout": {
    "nodes": {
      "assert_ready": {
        "x": 640,
        "y": 120
      },
      "extract_ready": {
        "x": 360,
        "y": 120
      },
      "out_1": {
        "x": 920,
        "y": 120
      },
      "probe_readyz": {
        "x": 80,
        "y": 120
      }
    }
  }
}
