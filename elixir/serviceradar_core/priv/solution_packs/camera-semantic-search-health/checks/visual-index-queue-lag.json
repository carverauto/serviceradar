{
  "alert_policy": {
    "cooldown_seconds": 300,
    "emit_ocsf_transition": true,
    "open_on_statuses": [],
    "priority": 2,
    "renotify_seconds": 21600,
    "threshold": 1,
    "window_seconds": 300
  },
  "credential_slots": [],
  "description": "Monitors queued camera visual indexing jobs via SRQL to detect embedding pipeline backlog or stalled workers.",
  "edges": [
    {
      "id": "e1",
      "source": "srql_1",
      "source_handle": "signal",
      "target": "extract_lag",
      "target_handle": "in"
    },
    {
      "id": "e2",
      "source": "extract_lag",
      "source_handle": "value",
      "target": "assert_lag",
      "target_handle": "in"
    },
    {
      "id": "e3",
      "source": "assert_lag",
      "source_handle": "verdict",
      "target": "out_1",
      "target_handle": "in"
    }
  ],
  "inputs": [
    {
      "default": {
        "$pack_param": "queue_lag_warn_count"
      },
      "description": "Warning threshold for queued visual indexing jobs",
      "key": "queue_lag_warn_count",
      "max": 100000,
      "min": 1,
      "type": "integer"
    },
    {
      "default": {
        "$pack_param": "queue_lag_crit_count"
      },
      "description": "Critical threshold for queued visual indexing jobs",
      "key": "queue_lag_crit_count",
      "max": 100000,
      "min": 1,
      "type": "integer"
    }
  ],
  "managed": true,
  "name": "Visual Index Queue Lag",
  "nodes": [
    {
      "config": {
        "limit": 100,
        "query": "in:events log_name:\"camera.visual_index.queued\" time:last_15m stats:\"count() as pending_jobs\"",
        "result_mode": "first_row",
        "timeout_ms": 5000
      },
      "id": "srql_1",
      "kind": "srql_query",
      "label": "Visual Index Backlog Query"
    },
    {
      "config": {
        "cast": "integer",
        "field": "pending_jobs",
        "output_key": "pending_jobs",
        "source_type": "srql_field"
      },
      "id": "extract_lag",
      "kind": "extract_field",
      "label": "Extract Pending Job Count"
    },
    {
      "config": {
        "crit": {
          "op": ">=",
          "value": "{{inputs.queue_lag_crit_count}}"
        },
        "field": "pending_jobs",
        "warn": {
          "op": ">=",
          "value": "{{inputs.queue_lag_warn_count}}"
        }
      },
      "id": "assert_lag",
      "kind": "threshold_assert",
      "label": "Backlog Thresholds"
    },
    {
      "config": {
        "verdict_map": {
          "degraded": "visual_index_queue_elevated",
          "down": "visual_index_queue_stalled",
          "healthy": "visual_index_queue_healthy",
          "unknown": "visual_index_queue_unknown"
        }
      },
      "id": "out_1",
      "kind": "alert_output",
      "label": "Visual Index Queue Verdict"
    }
  ],
  "pack_id": "io.serviceradar.camera-semantic-search-health",
  "pack_version": "0.1.1",
  "parameter_overrides": {},
  "schedule": {
    "interval_seconds": 120,
    "jitter_seconds": 15,
    "timeout_seconds": 30
  },
  "schema_version": 1,
  "slug": "visual-index-queue-lag",
  "state": "enabled",
  "target_binding": {
    "mode": "singleton"
  },
  "ui_layout": {
    "nodes": {
      "assert_lag": {
        "x": 640,
        "y": 120
      },
      "extract_lag": {
        "x": 360,
        "y": 120
      },
      "out_1": {
        "x": 920,
        "y": 120
      },
      "srql_1": {
        "x": 80,
        "y": 120
      }
    }
  }
}
