{
  "alert": {
    "severity": "warning",
    "title": "TLS leaf certificate is approaching expiry threshold"
  },
  "bucket_seconds": 60,
  "cooldown_seconds": 600,
  "description": "Opt-in warning alert when a monitored TLS leaf certificate enters the configured expiry warning window.",
  "event": {
    "log_name": "health.tls_certificate_expiry_warning"
  },
  "group_by": [
    "check_slug",
    "target_key"
  ],
  "install_state": "paused",
  "kind": "stateful_alert_rule",
  "match": {
    "attribute_equals": {
      "check_slug": "tls-certificate-expiry-posture",
      "to_status": "degraded"
    },
    "recovery": {
      "attribute_equals": {
        "check_slug": "tls-certificate-expiry-posture",
        "to_status": "healthy"
      },
      "subject_prefix": "declarative_check.health.state_change"
    },
    "subject_prefix": "declarative_check.health.state_change"
  },
  "name": "tls_certificate_expiry_warning",
  "priority": 30,
  "renotify_seconds": 43200,
  "signal": "event",
  "threshold": 1,
  "window_seconds": 300
}
