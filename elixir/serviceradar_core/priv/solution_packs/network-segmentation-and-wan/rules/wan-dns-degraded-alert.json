{
  "alert": {
    "severity": "warning",
    "summary": "WAN DNS resolution latency exceeded warning threshold"
  },
  "bucket_seconds": 60,
  "cooldown_seconds": 600,
  "description": "Opt-in alert when WAN DNS resolution latency enters the degraded window.",
  "event": {
    "log_name": "health.wan_dns_resolution_degraded"
  },
  "group_by": [
    "check_slug"
  ],
  "install_state": "paused",
  "kind": "stateful_alert_rule",
  "match": {
    "check_slug": "wan-dns-resolution-posture",
    "status": "degraded"
  },
  "name": "wan_dns_resolution_degraded",
  "priority": 30,
  "renotify_seconds": 43200,
  "signal": "event",
  "threshold": 1,
  "window_seconds": 300
}
