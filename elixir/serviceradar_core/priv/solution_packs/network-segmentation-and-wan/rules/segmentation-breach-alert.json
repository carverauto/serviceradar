{
  "alert": {
    "severity": "critical",
    "title": "Network segmentation breach detected from DMZ vantage point"
  },
  "bucket_seconds": 60,
  "cooldown_seconds": 300,
  "description": "Opens a critical security alert when the DMZ vantage point unexpectedly connects to a protected internal service.",
  "event": {
    "log_name": "health.network_segmentation_breach"
  },
  "group_by": [
    "check_slug",
    "target_key"
  ],
  "install_state": "enabled",
  "kind": "stateful_alert_rule",
  "match": {
    "attribute_equals": {
      "check_slug": "multi-vantage-segmentation-isolation",
      "to_status": "down"
    },
    "recovery": {
      "attribute_equals": {
        "check_slug": "multi-vantage-segmentation-isolation",
        "to_status": "healthy"
      },
      "subject_prefix": "declarative_check.health.state_change"
    },
    "subject_prefix": "declarative_check.health.state_change"
  },
  "name": "network_segmentation_breach",
  "priority": 10,
  "renotify_seconds": 14400,
  "signal": "event",
  "threshold": 1,
  "window_seconds": 300
}
