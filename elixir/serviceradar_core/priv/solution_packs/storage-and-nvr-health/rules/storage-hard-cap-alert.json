{
  "alert": {
    "severity": "critical",
    "title": "Storage entitlement hard-cap or critical utilization threshold exceeded"
  },
  "bucket_seconds": 60,
  "cooldown_seconds": 300,
  "description": "Alerts when archive storage entitlement hard-cap enforcement activates or billable utilization exceeds critical threshold.",
  "event": {
    "log_name": "health.storage_entitlement_cap"
  },
  "group_by": [
    "check_slug",
    "target_key"
  ],
  "install_state": "enabled",
  "kind": "stateful_alert_rule",
  "match": {
    "attribute_equals": {
      "check_slug": "storage-entitlement-utilization",
      "to_status": "down"
    },
    "recovery": {
      "attribute_equals": {
        "check_slug": "storage-entitlement-utilization",
        "to_status": "healthy"
      },
      "subject_prefix": "declarative_check.health.state_change"
    },
    "subject_prefix": "declarative_check.health.state_change"
  },
  "name": "storage_entitlement_hard_cap",
  "priority": 20,
  "renotify_seconds": 21600,
  "signal": "event",
  "threshold": 1,
  "window_seconds": 300
}
