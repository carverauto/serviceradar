%% OTP evaluates this file before the application supervision tree starts.
%% Environment values are path data, never interpolated Erlang source. Missing
%% policy state denies connections until the independent HTTPS refresher starts.
(fun() ->
RequiredPath = fun(Name) ->
    case os:getenv(Name) of
        false -> erlang:error({missing_managed_distribution_setting, Name});
        Path ->
            case filelib:is_regular(Path) of
                true -> Path;
                false -> erlang:error({missing_managed_distribution_file, Name})
            end
    end
end,
Cert = RequiredPath("SERVICERADAR_DIST_CERT_FILE"),
Key = RequiredPath("SERVICERADAR_DIST_KEY_FILE"),
CA = RequiredPath("SERVICERADAR_DIST_CA_FILE"),
PolicyKey = RequiredPath("SERVICERADAR_CERT_POLICY_KEY_FILE"),
true = is_list(PolicyKey),
State = #{previous => nil,
          store => 'Elixir.ServiceRadar.Security.PeerCertificatePolicy',
          owner => verify_process},
Options = [{certfile, Cert}, {keyfile, Key}, {cacertfile, CA},
           {versions, ['tlsv1.3']}, {verify, verify_peer},
           {session_tickets, disabled},
           {verify_fun,
            {fun 'Elixir.ServiceRadar.Security.PeerCertificatePolicy':verify/3, State}}],
[{server, [{fail_if_no_peer_cert, true} | Options]}, {client, Options}]
end)().
