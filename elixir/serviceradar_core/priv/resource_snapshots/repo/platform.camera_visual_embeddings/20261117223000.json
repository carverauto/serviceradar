  "custom_statements": [
    {
      "after_tables": [
        "camera_visual_embeddings"
      ],
      "code?": false,
      "down": "DROP INDEX IF EXISTS platform.camera_visual_embeddings_hnsw_768_idx;\n",
      "global?": false,
      "name": "camera_visual_embeddings_hnsw_768_idx",
      "up": "CREATE INDEX camera_visual_embeddings_hnsw_768_idx\nON platform.camera_visual_embeddings\nUSING hnsw ((embedding::vector(768)) vector_cosine_ops)\nWITH (m = 16, ef_construction = 64)\nWHERE (embedding_dim = 768);\n"
    },
