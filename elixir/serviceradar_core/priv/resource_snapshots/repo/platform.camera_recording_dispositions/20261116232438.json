      "code?": false,
      "down": "DROP FUNCTION IF EXISTS platform.camera_recording_dispositions_enforce_append_only();\n",
      "global?": false,
      "name": "enforce_disposition_append_only_fn",
      "up": "CREATE OR REPLACE FUNCTION platform.camera_recording_dispositions_enforce_append_only()\nRETURNS trigger\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  RAISE EXCEPTION 'camera_recording_dispositions is append-only and cannot be modified or deleted'\n    USING ERRCODE = 'check_violation',\n          CONSTRAINT = 'camera_recording_dispositions_append_only';\nEND;\n$$;\n"
