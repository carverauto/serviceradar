package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "deps/**",
            "native/**/target/**",
            "tmp/**",
            "**/*.swp",
            "**/*~",
        ],
    ),
)

filegroup(
    name = "native_srcs",
    srcs = glob(
        ["native/**"],
        exclude = ["native/**/target/**"],
    ),
)
