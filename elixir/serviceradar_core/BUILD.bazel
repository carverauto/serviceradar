# Bootstrap files only -- what `mix deps.get` needs to resolve this project as a path
# dependency, with none of its lib/ sources. Keeping this separate from :srcs is what lets
# //elixir/web-ng:deps_cache stay keyed on lockfiles, so it stays a remote cache hit across
# any change that does not touch dependencies.
filegroup(
    name = "deps_srcs",
    srcs = ["mix.exs"] + glob(
        [
            "mix.lock",
            "config/**",
        ],
        allow_empty = True,
    ),
)

# Shared between the :test and :prod compilations below, which differ only in mix_env.
CORE_SRCS = [
    ":compile_srcs",
    # Read at compile time, from outside this package. The *_addon_package_seeder
    # modules do Path.expand("../../../../../addons/<x>/config.schema.json", __DIR__)
    # and bake the result in with @external_resource, so these have to be declared
    # action inputs -- existing in the source tree is not enough. mix_app stages srcs
    # under their own package path, which is what makes the five-levels-up path
    # resolve here the same way it resolves to the repo root under plain mix.
    "//addons/bumblebee-scan:bumblebee_scan_manifest",
    "//addons/netprobe:netprobe_manifest",
    "//addons/otel-collector:otel_collector_manifest",
    "//addons/scalibr-endpoint-inventory:scalibr_endpoint_inventory_manifest",
    "//addons/workload-identity:workload_identity_manifest",
    # Same reason, different consumer. ServiceRadar.Plugins.AddonConfigContractFixtures
    # pins @repo_root Path.expand("../../../../..", __DIR__) at compile time, so under
    # mix_app that resolves inside the build tree and the committed fixtures have to be
    # staged there too. Declaring them on the test target instead puts them in the test's
    # runfiles, which is a different directory and not the one the baked-in path points
    # at -- the drift test then fails with "could not read file .../erlang_app_mix/go/...".
    "//go/pkg/agent:addonconfig_contract_fixtures",
]

