load("@rules_elixir//:ex_unit_test.bzl", "ex_unit_test")
load("@rules_elixir//:elixir_tests.bzl", "ex_unit_tests")
load(
    "@serviceradar//build:integration_shards.bzl",
    "integration_shard_names",
    "partition_by_shard",
)
load("@serviceradar//build:integration_tests.bzl", "requires_shared_fixture")
load("@rules_elixir//:mix_app.bzl", "mix_app")

package(default_visibility = ["//visibility:public"])

# Every ExUnit file in the project. test/db/** is excluded because those are the database
# lifecycle targets (migrate_template), not suite tests -- they are declared individually.
ALL_TEST_SRCS = glob(
    ["test/**/*_test.exs"],
    exclude = [
        "test/db/**",
        # This brings up real peer nodes and has its own discoverable target
        # below so the normal helper's :cluster exclusion cannot skip it.
        "test/serviceradar/edge/agent_command_bus_rpc_registry_test.exs",
    ],
)

# Disjoint partition of ALL_TEST_SRCS, one bucket per integration shard.
INTEGRATION_SHARD_SRCS = partition_by_shard(ALL_TEST_SRCS)

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "deps/**",
            "native/**/target/**",
            "tmp/**",
            "**/*.swp",
            "**/*~",
        ],
    ),
)

# What `mix compile` actually needs -- :srcs minus the 599 *_test.exs files.
#
# THIS IS THE SINGLE BIGGEST INCREMENTAL-BUILD LEVER IN THE ELIXIR TREE.
#
# mix.exs:48 says `elixirc_paths(:test), do: ["lib", "test/support"]`, so of the 623 files
# under test/ exactly 20 are ever compiled into the application. The other 603 were still
# declared inputs of the compile action, which meant editing ONE unrelated test file
# invalidated:
#
#   :erlang_app (53s) -> :erlang_app_prod (53s) -> //elixir/web-ng:erlang_app (62s)
#   -> agent_gateway, core_elx, every ex_unit_test target, all 8 integration shards
#
# i.e. the entire ~190s critical chain for a one-line change to a file the application never
# compiles. Bazel was correct to rebuild -- a declared input changed. The input was wrong.
#
# The test files still reach the tests: //build:elixir_tests.bzl passes each *_test.exs as
# the `srcs` of its own ex_unit_test target, and the runtime fixtures come through `data`
# below. Nothing loses an input; the compile stops claiming inputs it does not read.
#
# Deliberately a SEPARATE filegroup rather than a narrower :srcs. :srcs means "the whole
# package" and //elixir/web-ng/assets:BUILD.bazel documents relying on that breadth; giving
# the compile its own, honestly-scoped input set keeps both meanings available.
filegroup(
    name = "compile_srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "deps/**",
            "native/**/target/**",
            "tmp/**",
            "**/*.swp",
            "**/*~",
            # The exclusion that matters. test/support is added back below.
            "test/**",
        ],
    ) + glob(
        ["test/support/**"],
        allow_empty = True,
    ),
)

# The migration files, as an input to //rust/integration-db.
#
# That crate decides whether the template database is current by comparing the versions in
# these filenames against the template's schema_migrations, so it needs them staged in its
# runfiles. Declaring them here rather than globbing from the Rust package keeps the
# ownership right: this project owns its migrations.
filegroup(
    name = "migrations",
    srcs = glob(
        ["priv/repo/migrations/*.exs"],
        allow_empty = False,
    ),
)

# Bootstrap files only -- what `mix deps.get` needs to resolve this project as a path
# dependency, with none of its lib/ sources. Keeping this separate from :srcs is what lets
# //elixir/web-ng:deps_cache stay keyed on lockfiles, so it stays a remote cache hit across
# any change that does not touch dependencies.
filegroup(
    name = "deps_srcs",
    srcs = ["mix.exs"] + glob(
        [
            "mix.lock",
            "config/**",
        ],
        allow_empty = True,
    ),
)

# Shared between the :test and :prod compilations below, which differ only in mix_env.
CORE_SRCS = [
    ":compile_srcs",
    # Read at compile time, from outside this package. The *_addon_package_seeder
    # modules do Path.expand("../../../../../addons/<x>/config.schema.json", __DIR__)
    # and bake the result in with @external_resource, so these have to be declared
    # action inputs -- existing in the source tree is not enough. mix_app stages srcs
    # under their own package path, which is what makes the five-levels-up path
    # resolve here the same way it resolves to the repo root under plain mix.
    "//addons/bumblebee-scan:bumblebee_scan_manifest",
    "//addons/netprobe:netprobe_manifest",
    "//addons/otel-collector:otel_collector_manifest",
    "//addons/scalibr-endpoint-inventory:scalibr_endpoint_inventory_manifest",
    "//addons/workload-identity:workload_identity_manifest",
    # Same reason, different consumer. ServiceRadar.Plugins.AddonConfigContractFixtures
    # pins @repo_root Path.expand("../../../../..", __DIR__) at compile time, so under
    # mix_app that resolves inside the build tree and the committed fixtures have to be
    # staged there too. Declaring them on the test target instead puts them in the test's
    # runfiles, which is a different directory and not the one the baked-in path points
    # at -- the drift test then fails with "could not read file .../erlang_app_mix/go/...".
    "//go/pkg/agent:addonconfig_contract_fixtures",
]

# Bazel builds the cdylibs; Mix must not shell out to cargo. `use Rustler` merges
# Application.compile_env(otp_app, __MODULE__) over its own options, so this disables
# native compilation without touching lib/ or the checked-in config. The libraries
# themselves arrive via native_libs, and reach a release through this app's priv.
CORE_EXTRA_CONFIG = [
    "config :serviceradar_core, ServiceRadar.Observability.Zen.Native, skip_compilation?: true",
    "config :serviceradar_core, ServiceRadar.Observability.DispositionKernels, skip_compilation?: true",
]

CORE_NATIVE_LIBS = {
    "//elixir/serviceradar_core/native/anomaly_disposition_nif:anomaly_disposition_nif": "anomaly_disposition_nif",
    "//elixir/serviceradar_core/native/zen_nif:zen_nif": "zen_nif",
}

