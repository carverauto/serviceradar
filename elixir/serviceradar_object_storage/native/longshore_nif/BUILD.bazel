load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")

package(default_visibility = ["//visibility:public"])

rust_shared_library(
    name = "longshore_nif",
    srcs = glob(["src/**/*.rs"]),
    cc_runtime_linkage = "static",
    crate_name = "longshore_nif",
    edition = "2021",
    rustc_env = {"RUSTLER_PRIMARY_NIF_INIT": "1"},
    rustc_flags = ["-Cpanic=unwind"] + select({
        "@platforms//os:macos": ["-Clink-arg=-Wl,-undefined,dynamic_lookup"],
        "//conditions:default": [],
    }),
    deps = all_crate_deps(cargo_only = True, normal = True),
)

rust_binary(
    name = "longshore_bench",
    testonly = True,
    srcs = ["bench/longshore_bench.rs"],
    crate_root = "bench/longshore_bench.rs",
    edition = "2021",
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@crates//:longshore_s3"],
)
