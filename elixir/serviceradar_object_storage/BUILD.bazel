load("@rules_elixir//:elixir_tests.bzl", "ex_unit_tests")
load("@rules_elixir//:ex_unit_test.bzl", "ex_unit_test")
load("@rules_elixir//:mix_app.bzl", "mix_app")
load("//build:elixir_quality.bzl", "elixir_quality")
load("//build:elixir_release.bzl", "SHIPPED_ERTS_OTP_ROOT", "SHIPPED_ERTS_ROOT_MARKER", "elixir_release")

package(default_visibility = ["//visibility:public"])

exports_files([
    "mix.exs",
    "qualification/round_trip.exs",
])

filegroup(
    name = "srcs",
    srcs = glob(["lib/**"]) + glob(["config/**"], allow_empty = True) + ["mix.exs", "mix.lock"],
)

filegroup(
    name = "deps_srcs",
    srcs = ["mix.exs", "mix.lock"] + glob(["config/**"], allow_empty = True),
)

STORAGE_DEPS = ["@hexpm//:rustler", "@rules_elixir//elixir"]

mix_app(
    name = "erlang_app",
    srcs = [":srcs"],
    app_name = "serviceradar_object_storage",
    mix_env = "prod",
    extra_config = [
        "config :serviceradar_object_storage, ServiceRadarObjectStorage, skip_compilation?: true",
    ],
    native_libs = {
        "//elixir/serviceradar_object_storage/native/longshore_nif:longshore_nif": "longshore_nif",
    },
    deps = STORAGE_DEPS,
)

# The same NIF and tests can run in a pod with the required kernel policy.
elixir_release(
    name = "qualification_release",
    testonly = True,
    srcs = ["mix.exs", "mix.lock"],
    out = "serviceradar-object-storage-qualification.tar.gz",
    app = ":erlang_app",
    erts_otp_root = SHIPPED_ERTS_OTP_ROOT,
    erts_root_marker = SHIPPED_ERTS_ROOT_MARKER,
    extra_config = [
        "config :serviceradar_object_storage, ServiceRadarObjectStorage, skip_compilation?: true",
    ],
    release_name = "serviceradar_object_storage",
)

ex_unit_tests(
    name = "unit_tests",
    srcs = [
        "test/config_test.exs",
        "test/object_storage_test.exs",
    ],
    load_config = False,
    exec_properties = {"test.Pool": "longshore-qualification"},
    test_helper = "test/test_helper.exs",
    deps = [":erlang_app"],
)

ex_unit_test(
    name = "object_storage_bench_test",
    size = "large",
    srcs = ["bench/object_storage_bench_test.exs"],
    data = [
        "test/test_helper.exs",
        "//elixir/serviceradar_object_storage/native/longshore_nif:longshore_bench",
    ],
    elixir_opts = [
        "-r",
        "test/test_helper.exs",
    ],
    exec_properties = {"test.Pool": "longshore-qualification"},
    tags = ["benchmark"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":erlang_app"],
)

elixir_quality(
    extra_inputs = [
        "bench/**/*.exs",
        "qualification/**/*.exs",
    ],
    source_deps = ["@hexpm//:ex_dna"],
    tool_deps = STORAGE_DEPS + [
        "@hexpm//:credo",
        "@hexpm//:ex_dna",
        "@hexpm//:ex_slop",
        "@hexpm//:jump_credo_checks",
        "@hexpm//:styler",
    ],
)
