load("@rules_elixir//:elixir_tests.bzl", "ex_unit_tests")
load("@rules_elixir//:mix_app.bzl", "mix_app")
load("//build:elixir_quality.bzl", "elixir_quality")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["lib/**"]) + [
        "mix.exs",
        "mix.lock",
    ],
)

filegroup(
    name = "deps_srcs",
    srcs = [
        "mix.exs",
        "mix.lock",
    ],
)

METADATA_DEPS = [
    "@hexpm//:jason",
    "@rules_elixir//elixir",
]

mix_app(
    name = "erlang_app",
    srcs = [":srcs"],
    app_name = "serviceradar_recording_metadata",
    mix_env = "prod",
    deps = METADATA_DEPS,
)

# Metadata contracts run without Core, database or media-pipeline dependencies.
ex_unit_tests(
    name = "unit_tests",
    srcs = ["test/manifest_test.exs"],
    load_config = False,
    test_helper = "test/test_helper.exs",
    deps = [":erlang_app"],
)

elixir_quality(
    source_deps = ["@hexpm//:ex_dna"],
    tool_deps = METADATA_DEPS + [
        "@hexpm//:credo",
        "@hexpm//:ex_dna",
        "@hexpm//:ex_slop",
        "@hexpm//:jump_credo_checks",
        "@hexpm//:styler",
    ],
)
