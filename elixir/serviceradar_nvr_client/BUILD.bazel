load("@rules_elixir//:elixir_tests.bzl", "ex_unit_tests")
load("@rules_elixir//:mix_app.bzl", "mix_app")
load("//build:elixir_quality.bzl", "elixir_quality")
load("//build:elixir_release.bzl", "SHIPPED_ERTS_OTP_ROOT", "SHIPPED_ERTS_ROOT_MARKER", "elixir_release")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["lib/**"]) + ["mix.exs", "mix.lock"],
)

filegroup(
    name = "deps_srcs",
    srcs = ["mix.exs", "mix.lock"],
)

CLIENT_DEPS = [
    "//elixir/serviceradar_recording_metadata:erlang_app",
    "@hexpm//:jason",
    "@hexpm//:mint",
    "@rules_elixir//elixir",
]

mix_app(
    name = "erlang_app",
    warnings_as_errors = True,
    srcs = [":srcs"],
    app_name = "serviceradar_nvr_client",
    mix_env = "prod",
    deps = CLIENT_DEPS,
)

# The receiver's TLS contract tests run this client in an independent shipped VM.
elixir_release(
    name = "release_fixture",
    testonly = True,
    srcs = ["mix.exs", "mix.lock", "//elixir/serviceradar_recording_metadata:mix.exs"],
    out = "serviceradar-nvr-client-fixture.tar.gz",
    app = ":erlang_app",
    erts_otp_root = SHIPPED_ERTS_OTP_ROOT,
    erts_root_marker = SHIPPED_ERTS_ROOT_MARKER,
    release_name = "serviceradar_nvr_client",
)

exports_files(["test/client_probe.exs"])

ex_unit_tests(
    name = "unit_tests",
    srcs = ["test/wire_test.exs"],
    load_config = False,
    test_helper = "test/test_helper.exs",
    deps = [":erlang_app"],
)

elixir_quality(
    source_deps = ["@hexpm//:ex_dna"],
    tool_deps = CLIENT_DEPS + [
        "@hexpm//:credo", "@hexpm//:ex_dna", "@hexpm//:ex_slop",
        "@hexpm//:jump_credo_checks", "@hexpm//:styler",
    ],
)
