load("//build:elixir_quality.bzl", "elixir_quality")

package(default_visibility = ["//visibility:public"])

# palisade is not built by Bazel, but its lock still takes part in resolving the Hex
# closure: a Bazel repository name is global, so //third_party/hex:gen has to see every
# project's mix.lock at once or it will resolve a version some project disagrees with.
exports_files(["mix.lock"])

# `mix format --check-formatted` + `mix credo --strict`, as CI's Elixir Quality job runs them.
# See //build:elixir_quality.bzl.
elixir_quality(
    tool_deps = ["@hexpm//:credo"],
)
