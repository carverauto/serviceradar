load("@rules_elixir//:elixir_tests.bzl", "ex_unit_tests")
load("@rules_elixir//:mix_app.bzl", "mix_app")
load("//build:elixir_quality.bzl", "elixir_quality")

package(default_visibility = ["//visibility:public"])

# mix.exs and mix.lock are read by name: a release reads each path dependency's
# mix.exs, and //third_party/hex:gen resolves the Hex closure from every project's lock.
exports_files([
    "mix.exs",
    "mix.lock",
])

filegroup(
    name = "srcs",
    srcs = glob(["lib/**"]) + [
        "mix.exs",
        "mix.lock",
    ],
)

PALISADE_DEPS = [
    "@hexpm//:plug",
    "@hexpm//:req",
    "@rules_elixir//elixir",
]

mix_app(
    name = "erlang_app",
    warnings_as_errors = True,
    srcs = [":srcs"],
    app_name = "palisade",
    mix_env = "prod",
    deps = PALISADE_DEPS,
)

# The tests use literal addresses, build requests with Plug.Test without sending them,
# and start the limiters under ExUnit's own supervisor, so they need no network or
# database. test/test_helper.exs loads :plug and :stream_data because the
# Bazel runner does not.
# StreamData is a test-only dependency.
ex_unit_tests(
    name = "unit_tests",
    srcs = glob(["test/palisade/*_test.exs"]),
    load_config = False,
    test_helper = "test/test_helper.exs",
    deps = [
        ":erlang_app",
        "@hexpm//:stream_data",
    ],
)

# `mix format --check-formatted` + `mix credo --strict`, as CI's Elixir Quality job runs them.
# See //build:elixir_quality.bzl.
elixir_quality(
    tool_deps = PALISADE_DEPS + ["@hexpm//:credo"],
)
