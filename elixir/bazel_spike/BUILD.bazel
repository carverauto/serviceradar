# Feasibility spike: can Bazel compile Ash-using Elixir natively, and run ExUnit as a real
# Bazel test target? Not production. Delete once the question is answered either way.
#
# Step 1 (this target): the smallest possible app, no deps. Proves the rules_elixir toolchain
# builds and elixir_app works at all on this host / on RBE.
load("@rules_elixir//:elixir_app.bzl", "elixir_app")
load("@rules_elixir//:ex_unit_test.bzl", "ex_unit_test")

package(default_visibility = ["//visibility:public"])

elixir_app(
    app_name = "bazel_spike",
    srcs = ["lib/spike_plain.ex"],
)

# Step 2: a real Bazel test target -- test = True, its own log, cacheable, RBE-eligible.
ex_unit_test(
    name = "spike_test",
    srcs = ["test/spike_test.exs"],
    deps = [":erlang_app"],
)
