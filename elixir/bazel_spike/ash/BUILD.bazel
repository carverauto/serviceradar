# Phase gate for the Elixir->Bazel migration: compile a real Ash resource with elixir_app and
# assert, from a native ex_unit_test, that Spark's compile-time DSL actually expanded.
load("@rules_elixir//:elixir_app.bzl", "elixir_app")
load("@rules_elixir//:ex_unit_test.bzl", "ex_unit_test")

package(default_visibility = ["//visibility:public"])

elixir_app(
    app_name = "spike_ash",
    srcs = ["lib/spike_ash.ex"],
    deps = ["@hex_ash//:erlang_app"],
)

ex_unit_test(
    name = "spike_ash_test",
    srcs = ["test/spike_ash_test.exs"],
    deps = [":erlang_app"],
)
