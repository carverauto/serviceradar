  "description": "ServiceRadar developer CLI: dashboard authoring loop, auth, and tooling. Companion to @serviceradar/dashboard-sdk.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@code.carverauto.dev/carverauto/serviceradar.git",
    "directory": "js/cli"
  },
  "publishConfig": {
