# gazelle:ignore

load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

# Generated Go sources remain in the repository for the non-Bazel module workflow.

proto_library(
    name = "discoverypb_proto",
    srcs = ["discovery.proto"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "discovery_proto_src",
    srcs = ["discovery.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "discoverypb_go_proto",
    importpath = "github.com/carverauto/serviceradar/proto/agent/discovery/v1",
    proto = ":discoverypb_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "discoverypb",
    embed = [":discoverypb_go_proto"],
    importpath = "github.com/carverauto/serviceradar/proto/agent/discovery/v1",
    visibility = ["//visibility:public"],
)
