# gazelle:ignore

load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

# Generated Go sources remain in the repository for the non-Bazel module workflow.

proto_library(
    name = "addonpb_proto",
    srcs = ["addon.proto"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "addon_proto_src",
    srcs = ["addon.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "addonpb_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/carverauto/serviceradar/proto/agent/addon/v1",
    proto = ":addonpb_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "addonpb",
    embed = [":addonpb_go_proto"],
    importpath = "github.com/carverauto/serviceradar/proto/agent/addon/v1",
    visibility = ["//visibility:public"],
)
