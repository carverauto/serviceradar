# gazelle:ignore

load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "netperfpb_proto",
    srcs = ["netperf.proto"],
    strip_import_prefix = "/proto",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "netperf_proto_src",
    srcs = ["netperf.proto"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "generate_netperf_go",
    srcs = [":netperf_proto_src"],
    outs = [
        "generated/netperf/v1/netperf.pb.go",
        "generated/netperf/v1/netperf_grpc.pb.go",
    ],
    cmd = "$(execpath @protoc_34_1_linux_x86_64//:bin/protoc) -Iproto -I. " +
          "--plugin=protoc-gen-go=$(execpath @org_golang_google_protobuf//cmd/protoc-gen-go) " +
          "--plugin=protoc-gen-go-grpc=$(execpath @org_golang_google_grpc_cmd_protoc_gen_go_grpc//:protoc-gen-go-grpc) " +
          "--go_out=$(RULEDIR)/generated --go_opt=paths=source_relative " +
          "--go-grpc_out=$(RULEDIR)/generated --go-grpc_opt=paths=source_relative " +
          "proto/netperf/v1/netperf.proto",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    tools = [
        "@org_golang_google_grpc_cmd_protoc_gen_go_grpc//:protoc-gen-go-grpc",
        "@org_golang_google_protobuf//cmd/protoc-gen-go",
        "@protoc_34_1_linux_x86_64//:bin/protoc",
    ],
)

write_source_files(
    name = "update_netperf_bindings",
    files = {
        "netperf.pb.go": ":generated/netperf/v1/netperf.pb.go",
        "netperf_grpc.pb.go": ":generated/netperf/v1/netperf_grpc.pb.go",
    },
)

go_library(
    name = "netperfpb",
    srcs = [
        "netperf.pb.go",
        "netperf_grpc.pb.go",
    ],
    importpath = "github.com/carverauto/serviceradar/proto/netperf/v1",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
    ],
)
