# gazelle:ignore

load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "edgev1_proto",
    srcs = ["observation.proto"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "edge_proto_src",
    srcs = ["observation.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "edgev1_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
    ],
    importpath = "github.com/carverauto/serviceradar/proto/edge/v1",
    proto = ":edgev1_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "edgev1",
    embed = [":edgev1_go_proto"],
    importpath = "github.com/carverauto/serviceradar/proto/edge/v1",
    visibility = ["//visibility:public"],
)
