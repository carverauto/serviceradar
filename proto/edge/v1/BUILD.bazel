# gazelle:ignore

load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "edgev1_proto",
    srcs = [
        "record.proto",
        "sweep.proto",
    ],
    # Match the Makefile's `protoc -I=proto`: the descriptor source path (and the
    # generated file-level registration symbols) must be `edge/v1/*.proto`, not
    # `proto/edge/v1/*.proto`, so Bazel and Make emit byte-identical bindings.
    # Safe because no proto imports these edge protos.
    strip_import_prefix = "/proto",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "edge_proto_src",
    srcs = [
        "record.proto",
        "sweep.proto",
    ],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "edgev1_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/carverauto/serviceradar/proto/edge/v1",
    proto = ":edgev1_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "edgev1",
    embed = [":edgev1_go_proto"],
    importpath = "github.com/carverauto/serviceradar/proto/edge/v1",
    visibility = ["//visibility:public"],
)

go_test(
    name = "edgev1_golden_test",
    srcs = ["golden_test.go"],
    data = glob(["testdata/**"]),
    deps = [
        ":edgev1",
        "//go/pkg/edge/edgerecord",
        "@org_golang_google_protobuf//proto",
    ],
)
