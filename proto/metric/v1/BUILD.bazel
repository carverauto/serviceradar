# gazelle:ignore

load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "metricpb_proto",
    srcs = ["metric.proto"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "metric_proto_src",
    srcs = ["metric.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "metricpb_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
    ],
    importpath = "github.com/carverauto/serviceradar/proto/metric/v1",
    proto = ":metricpb_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "metricpb",
    embed = [":metricpb_go_proto"],
    importpath = "github.com/carverauto/serviceradar/proto/metric/v1",
    visibility = ["//visibility:public"],
)
