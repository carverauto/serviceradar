# gazelle:ignore
#
# The smallest complete simkit pack, and the reference for the fixture
# pattern every demo dashboard uses:
#
#   :sample_<scenario>_json   frames generated by running the simulator natively
#   :fixtures_drift_test      fails when the committed copies are stale
#   :update_fixtures          bazel run //demo/simkit/examples/sample:update_fixtures
load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//demo:__subpackages__"])

_SCENARIOS = [
    "steady",
    "overheat",
]

go_library(
    name = "sample",
    srcs = [
        "fixtures.go",
        "sample.go",
    ],
    importpath = "github.com/carverauto/serviceradar/demo/simkit/examples/sample",
    deps = [
        "//demo/simkit",
        "//demo/simkit/fixture",
    ],
)

go_test(
    name = "sample_test",
    size = "small",
    srcs = ["sample_test.go"],
    embed = [":sample"],
    deps = [
        "//demo/simkit",
        "//demo/simkit/guard",
        "//demo/simkit/sourcetest",
    ],
)

[
    genrule(
        name = "sample_{}_json".format(scenario),
        outs = ["generated/sample-{}.json".format(scenario)],
        cmd = "$(execpath //demo/simkit/examples/sample/cmd/fixturegen) -scenario {} > $@".format(scenario),
        tools = ["//demo/simkit/examples/sample/cmd/fixturegen"],
    )
    for scenario in _SCENARIOS
]

[
    diff_test(
        name = "fixtures_drift_{}_test".format(scenario),
        file1 = ":sample_{}_json".format(scenario),
        file2 = "fixtures/sample-{}.json".format(scenario),
    )
    for scenario in _SCENARIOS
]

write_source_files(
    name = "update_fixtures",
    files = {
        "fixtures/sample-{}.json".format(scenario): ":sample_{}_json".format(scenario)
        for scenario in _SCENARIOS
    },
)
