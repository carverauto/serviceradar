# gazelle:ignore
#
# serviceradar-sdk-go v2.1.0 (github.com/carverauto/serviceradar-sdk-go, tag
# v2.1.0), non-test sources only, for demo plugins. First-party plugins vendor
# the SDK per plugin; demo plugins share this copy through a go.mod `replace`,
# so the TinyGo build resolves it from declared inputs with no proxy. To bump:
# replace sdk/ with `git archive <tag> sdk` from the SDK repo (dropping
# *_test.go), update the `require` version in every demo go.mod that names
# the SDK, and rerun //demo/... tests.
load("@io_bazel_rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//demo:__subpackages__"])

# Native build for demo unit tests (host calls resolve to the SDK's local
# stubs under !tinygo).
go_library(
    name = "sdk",
    srcs = glob(["sdk/*.go"]),
    importpath = "github.com/carverauto/serviceradar-sdk-go/v2/sdk",
)

# The module as the TinyGo build sees it through a go.mod replace.
filegroup(
    name = "module_srcs",
    srcs = ["go.mod"] + glob(["sdk/*.go"]),
)
