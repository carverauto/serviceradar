genrule(
    name = "ffmpeg_tar_amd64",
    srcs = ["@ffmpeg_static_linux_amd64//file"],
    outs = ["ffmpeg_amd64.tar"],
    cmd = """
set -euo pipefail
TMP=$(@D)/ffmpeg_amd64
rm -rf "$${TMP}"
mkdir -p "$${TMP}/rootfs/usr/local/bin" "$${TMP}/rootfs/usr/share/doc/ffmpeg" "$${TMP}/src"
tar -xf $(location @ffmpeg_static_linux_amd64//file) -C "$${TMP}/src"
cp "$${TMP}"/src/*/ffmpeg "$${TMP}/rootfs/usr/local/bin/ffmpeg"
cp "$${TMP}"/src/*/GPLv3.txt "$${TMP}/rootfs/usr/share/doc/ffmpeg/GPLv3.txt"
chmod 0755 "$${TMP}/rootfs/usr/local/bin/ffmpeg"
chmod 0644 "$${TMP}/rootfs/usr/share/doc/ffmpeg/GPLv3.txt"
find "$${TMP}/rootfs" -exec touch -h -t 200001010000.00 {} + 2>/dev/null || \
  find "$${TMP}/rootfs" -exec touch -t 200001010000.00 {} +
tar -cf "$@" -C "$${TMP}/rootfs" .
""",
)

