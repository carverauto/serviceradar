# gazelle:ignore
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_push")
load("//docker/images:service_images.bzl", "declare_multiarch_image_index", "declare_service_container_amd64", "declare_serviceradar_user_layer")

package(default_visibility = ["//demo:__subpackages__"])

go_library(
    name = "replayer_lib",
    srcs = [
        "fetch.go",
        "lock.go",
        "replayer.go",
        "s3.go",
        "supervise.go",
    ],
    embedsrcs = [
        "clips.lock.json",
        "paths.json",
    ],
    importpath = "github.com/carverauto/serviceradar/demo/rtsp-replayer",
)

go_test(
    name = "replayer_test",
    size = "small",
    srcs = [
        "fetch_test.go",
        "lock_test.go",
        "s3_test.go",
        "supervise_test.go",
    ],
    embed = [":replayer_lib"],
)

# MediaMTX and ffmpeg arrive as upstream release tarballs (pinned in
# MODULE.bazel). Each genrule below repacks one tool for one architecture as
# an OCI layer tar with fixed paths, executable bits and normalized mtimes.
genrule(
    name = "mediamtx_tar_amd64",
    srcs = ["@mediamtx_linux_amd64//file"],
    outs = ["mediamtx_amd64.tar"],
    cmd = """
set -euo pipefail
TMP=$(@D)/mediamtx_amd64
rm -rf "$${TMP}"
mkdir -p "$${TMP}/rootfs/usr/local/bin" "$${TMP}/rootfs/usr/share/doc/mediamtx" "$${TMP}/src"
tar -xzf $(location @mediamtx_linux_amd64//file) -C "$${TMP}/src"
cp "$${TMP}/src/mediamtx" "$${TMP}/rootfs/usr/local/bin/mediamtx"
cp "$${TMP}/src/LICENSE" "$${TMP}/rootfs/usr/share/doc/mediamtx/LICENSE"
chmod 0755 "$${TMP}/rootfs/usr/local/bin/mediamtx"
chmod 0644 "$${TMP}/rootfs/usr/share/doc/mediamtx/LICENSE"
find "$${TMP}/rootfs" -exec touch -h -t 200001010000.00 {} + 2>/dev/null || \
  find "$${TMP}/rootfs" -exec touch -t 200001010000.00 {} +
tar -cf "$@" -C "$${TMP}/rootfs" .
""",
)

