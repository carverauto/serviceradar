# gazelle:ignore
#
# The smallest demo plugin, proving the demo build -> bundle -> sign -> publish
# path. go.mod pins the released SDK and go.sum records it; the SDK is vendored
# in demo/vendor for the whole demo workspace (demo/go.work), and simkit and
# pluginkit resolve from their directories here (see //demo:defs.bzl).
# `go test ./...` works here as well as under Bazel.
#
#   bazel build //demo/hello-sim:hello_sim_bundle
#   bazel test  //demo/hello-sim:all
#   bazel run   //demo/hello-sim:publish -- --agent-uid <agent>   (see demo/README.md)
load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("//demo:defs.bzl", "demo_publish", "demo_wasm_plugin")

package(default_visibility = ["//demo:__subpackages__"])

exports_files([
    "go.mod",
    "plugin.yaml",
])

demo_wasm_plugin(
    name = "hello_sim",
    config_schema = "config.schema.json",
    main = "main.go",
    manifest = "plugin.yaml",
    srcs = [
        "hellosim.go",
        "main_stub.go",
    ],
)

demo_publish(
    name = "publish",
    bundle = ":hello_sim_bundle_zip",
)

go_test(
    name = "hello_sim_test",
    size = "small",
    srcs = [
        "hellosim.go",
        "hellosim_test.go",
        "main_stub.go",
    ],
    data = ["plugin.yaml"],
    deps = [
        "//demo:sdk",
        "//demo/pluginkit",
        "//demo/pluginkit/rulecheck",
        "//demo/simkit",
        "//demo/simkit/examples/sample",
        "//demo/simkit/guard",
    ],
)
