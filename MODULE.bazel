use_repo(buildbuddy_toolchain_ext, "buildbuddy_toolchain")

# --- Hermetic-llvm: the cc toolchain ----------------------------------------
# github.com/hermeticbuild/hermetic-llvm, BCR module name literally "llvm".
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")

# Matches the LLVM that rustc 1.97.1 is built on, which is RUST_DEFAULT_VERSION below.
# Confirmed with `rustc --version --verbose`, which reports "LLVM version: 22.1.6".
# Keep the two in step. Rust and C/C++ objects are linked into the same binaries here, and
# for the musl targets they are linked statically, so a mismatched LLVM shows up as bitcode
# and runtime-library incompatibility rather than as a clean error.
# The tag is mandatory: with no llvm.version the extension fails with "Missing llvm.version(...)".
llvm.version(llvm_version = "22.1.6")
use_repo(llvm, "llvm-project")

# The macOS sysroot.
# This pin is the one hermetic-llvm itself consumes (their MODULE.bazel at v0.8.18), so the
# archive and the include list are known to agree. The Wayback entry is their fallback: the
# preceding SDK's Apple URL started returning 503, which is what motivated the switch.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.from_archive(
    sha256 = "5f044578cd78a3a9b9c965a42d56bad609ee5d252e1d4e6aa7c42fc3f35fee7b",
    strip_prefix = "Payload/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk",
    type = "pkg",
    urls = [
        "https://swcdn.apple.com/content/downloads/09/08/047-91568-A_Y1CFZWQCD4/4xekpyz43i26dbp4enxfro8eb1q7wiujh5/CLTools_macOSNMOS_SDK.pkg",
        "https://web.archive.org/web/20260512015547id_/https://swcdn.apple.com/content/downloads/09/08/047-91568-A_Y1CFZWQCD4/4xekpyz43i26dbp4enxfro8eb1q7wiujh5/CLTools_macOSNMOS_SDK.pkg",
    ],
)

# `System` is not in the extension's default framework set, and every macOS EXECUTABLE needs it:
# the driver emits `-framework System`, so libraries compile and binaries fail to link with
# `ld: framework 'System' not found`. Libraries were fine, which is why this surfaces only when
# something actually links.
#
# The six after it are the extension's own defaults, repeated because this tag REPLACES that
# list rather than extending it (`if not frameworks: frameworks = _DEFAULT_FRAMEWORKS`).
# Naming only `System` drops the rest and the link fails on `Foundation` instead.
osx.frameworks(names = [
    "System",
    "CoreFoundation",
    "Foundation",
    "Kernel",
    "OSLog",
    "Security",
    "SystemConfiguration",
])

register_toolchains("@llvm//toolchain:all")

# --- RBE Toolchain and platforms  ----------------------------------
register_execution_platforms(
    "//build/platforms:linux_x86_64",
    "//build/platforms:linux_aarch64",
    "//build/platforms:darwin_x86_64",
    "//build/platforms:darwin_aarch64",
)

