# Precompiled Rustler NIFs, pinned so no Mix action has to reach the network for one.
#
# rustler_precompiled downloads these itself from GitHub during `mix compile`, keyed on the
# target triple. Even with the triple now correct (see _target_triple_env in
# //build:mix_app.bzl) that is still a network fetch from inside a supposedly hermetic
# action. Pinning them here makes the artefact a declared input with a verified checksum;
# //third_party/precompiled_nifs stages the right one per target platform, and
# RUSTLER_PRECOMPILED_GLOBAL_CACHE_PATH points the library at it.
#
# The sha256s are upstream's own, published in mdex_native's
# checksum-Elixir.MDExNative.Native.exs. Bump both together with the mdex version.
[
    http_file(
        name = "mdex_native_nif_" + arch,
        downloaded_file_path = "libmdex_native_nif-v0.2.5-nif-2.15-" + arch + "-unknown-linux-gnu.so.tar.gz",
        sha256 = sha,
        urls = ["https://github.com/leandrocp/mdex_native/releases/download/v0.2.5/libmdex_native_nif-v0.2.5-nif-2.15-" + arch + "-unknown-linux-gnu.so.tar.gz"],
    )
    for arch, sha in [
        ("x86_64", "d3ec8cd4237c25791dba415ae08acb90f57eee927275de644b2a96dbbe9c6c71"),
        ("aarch64", "4a842f2427e8fffa19d781d6083ebbfba53ce4b822064276779d4c05d85fbd11"),
    ]
]

