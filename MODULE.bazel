#
# pnpm_lock, not npm_package_lock: rules_js can read package-lock.json, but it converts it
# to pnpm form on every repository-rule evaluation -- 141s here, on a cold fetch, before a
# single asset is built. The converted file is checked in instead, so the conversion happens
# once when a dependency actually changes. Regenerate by pointing this at
# npm_package_lock = "//elixir/web-ng/assets:package-lock.json", building once, and
# switching back; rules_js writes the file and tells you to commit it.
npm.npm_translate_lock(
    name = "web_ng_npm",
    pnpm_lock = "//elixir/web-ng/assets:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "web_ng_npm")

