# rules_go/gazelle pull package_metadata transitively. Prefer the Bazel mirror
# first so CI does not fail analysis when GitHub releases transiently returns 502.
archive_override(
    module_name = "package_metadata",
    integrity = "sha256-Se0R5da3UsVfpTnLsQsnNpdPNHsIHXvVAKgNrLfb7AY=",
    strip_prefix = "supply-chain-0.0.5/metadata",
    urls = [
        "https://mirror.bazel.build/github.com/bazel-contrib/supply-chain/releases/download/v0.0.5/supply-chain-v0.0.5.tar.gz",
        "https://github.com/bazel-contrib/supply-chain/releases/download/v0.0.5/supply-chain-v0.0.5.tar.gz",
    ],
)

# rules_rust pulls rules_kotlin transitively through Bazel Central Registry.
# Prefer the Bazel mirror first so CI can analyze targets during GitHub release
# outages instead of failing before any ServiceRadar code is built or tested.
archive_override(
    module_name = "rules_kotlin",
    integrity = "sha256-O3cpdv7Hvc2h2EudObF2WJQkwEfrIXW+0JqsYw5Qr0M=",
    patch_strip = 1,
    patches = ["//third_party/patches/rules_kotlin:module_dot_bazel_version.patch"],
    urls = [
        "https://mirror.bazel.build/github.com/bazelbuild/rules_kotlin/releases/download/v1.9.6/rules_kotlin-v1.9.6.tar.gz",
        "https://github.com/bazelbuild/rules_kotlin/releases/download/v1.9.6/rules_kotlin-v1.9.6.tar.gz",
    ],
)

# zlib's BCR source points at GitHub releases. Prefer the Bazel mirror first so
# release CI can complete analysis during transient GitHub 5xx responses.
archive_override(
    module_name = "zlib",
    integrity = "sha256-mpOyt9/ax3zrpaVYpYDnRmfdb+3kWFuR7vtg8Dty3yM=",
    patch_strip = 0,
    patches = [
        "//third_party/patches/zlib:add_build_file.patch",
        "//third_party/patches/zlib:module_dot_bazel.patch",
    ],
    strip_prefix = "zlib-1.3.1",
    urls = [
        "https://mirror.bazel.build/github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz",
        "https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz",
    ],
)

single_version_override(
    module_name = "rules_java",
    patch_strip = 0,
    patches = ["//third_party/patches/rules_java:openbsd_jni_header.patch"],
)

# VENDORED, not patched. rabbitmq/rules_erlang is ARCHIVED upstream -- last release 3.16.0,
# roughly two years ago, and the repository states it is no longer maintained. The six local
# fixes were therefore never going to land, which made the patch files a permanent tax: they
# apply by context, break silently, and cannot express a design change.
#
# //third_party/rules_erlang is the 3.16.0 source with those six fixes already applied.
# See //third_party/rules_erlang/VENDORING.md for the per-fix rationale and for how to diff
# this tree against upstream 3.16.0.
local_path_override(
    module_name = "rules_erlang",
    path = "third_party/rules_erlang",
)

# VENDORED, not patched -- same reasoning as rules_erlang above. //third_party/rules_elixir
# is the 1.1.0 source with its six local fixes already applied; the per-fix rationale lives
# in //third_party/rules_elixir/VENDORING.md.
local_path_override(
    module_name = "rules_elixir",
    path = "third_party/rules_elixir",
)

# Hex packages as first-class Bazel repositories, compiled by the Bazel Elixir toolchain.
# This replaces `mix deps.get` + `mix deps.compile` for the Ash closure: every package becomes
# a real Bazel target producing ErlangAppInfo, which is what elixir_app and ex_unit_test need.
# Build files live in //third_party/hex. Versions and checksums come from
# elixir/serviceradar_core/mix.lock -- the sha256 is the OUTER tarball checksum (the last field
# of the lock entry), which is what hex_archive downloads.
git_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl",
    "git_repository",
)

hex_archive = use_repo_rule("@rules_erlang//:hex_archive.bzl", "hex_archive")

# bundlex is the one lock entry that is not a Hex package -- serviceradar_core_elx pins it
# from git (membraneframework/bundlex v1.5.4). It ships a Mix compiler that bunch_native
# and the rest of the Membrane stack invoke as `compile.bundlex`, so without it those
# packages fail with `The task "compile.bundlex" could not be found`.
git_repository(
    name = "hex_bundlex",
    build_file = "//third_party/hex:bundlex.BUILD",
    commit = "8f3b94a8d643c4513d61355be53136cb2ea8fbb4",
    # Resolve precompiled OS deps from BUNDLEX_LOCAL_PRECOMPILED_DIR before reaching for
    # github.com. Without it `mix deps.compile` downloads ffmpeg and friends inside a build
    # action -- unkeyed, and once per consuming plugin. See the patch header.
    patch_args = ["-p1"],
    patches = ["//third_party/patches/bundlex:local_precompiled.patch"],
    remote = "https://github.com/membraneframework/bundlex.git",
)

