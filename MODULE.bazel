# Hex, the package manager, built from source as a Mix archive.
#
# This is NOT used to fetch anything -- every dependency is already a Bazel
# repository (see the hex_archive block above) and mix runs with
# --no-deps-check. Hex is needed only so that Mix can resolve an SCM for the
# `{:dep, "~> x.y"}` entries in a package's mix.exs; without it Mix aborts with
# "Could not find an SCM for dependency" on dev/test-only deps it would never
# have compiled anyway.
#
# Hex has no dependencies of its own, so it bootstraps through mix_archive_build
# with an empty dep graph.
http_archive(
    name = "hex",
    build_file_content = """\
load("@serviceradar//build:mix_archive_build.bzl", "mix_archive_build")

# Hex is the one package we genuinely need as a .ez, because it is consumed via
# `mix archive.install` rather than as an ERL_LIBS dependency.
mix_archive_build(
    name = "archive",
    srcs = ["mix.exs"] + glob(["lib/**/*"]),
    out = "hex.ez",
    visibility = ["//visibility:public"],
)
""",
    sha256 = "dabd99ea48ba8064c32bc2e97d59ab1b1055a38a1dd178c5389d95c35e985d2d",
    strip_prefix = "hex-2.5.1",
    urls = ["https://github.com/hexpm/hex/archive/refs/tags/v2.5.1.zip"],
)

