# --- Rust toolchain bootstrap -----------------------------------------------
RUST_DEFAULT_VERSION = "1.93.0"

RUST_EDITION = "2024"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = RUST_EDITION,
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
    ],
    versions = [RUST_DEFAULT_VERSION],
)
use_repo(rust, "rust_toolchains")
use_repo(
    rust,
    "rust_linux_x86_64__aarch64-unknown-linux-musl__stable_tools",
    "rust_linux_x86_64__x86_64-unknown-linux-musl__stable_tools",
)

# MUST precede @rust_toolchains//:all. Bazel picks the FIRST registered toolchain that
# matches, not the most specific one, and rules_rust derives a toolchain's
# target_compatible_with from the triple alone -- @platforms has no musl constraint, so
# `x86_64-unknown-linux-gnu` declares exactly [os:linux, cpu:x86_64]. That is a subset of
# //build/platforms:linux_x86_64_musl, so the glibc toolchain matches the musl platform and,
# registered first, wins. netprobe then built dynamically linked against glibc while the
# --platforms flag said musl, and only the shape assertions in rust-musl.yml caught it.
#
# These wrappers are what encode the distinction: target_compatible_with carries
# //build/platforms:linux_musl and target_settings pins the matching config_setting, so they
# are inert for a non-musl linux platform and resolution falls through to gnu as before.
#
# Note this only ever misresolved on a linux-x86_64 executor. extra_target_triples requests
# no x86_64-unknown-linux-gnu toolchain -- that triple exists only because it is the CI
# executor's own host triple, so from a macOS or arm64 host the musl toolchain was the only
# match and the bug was invisible.
register_toolchains(
    "//build/rust:linux_aarch64_musl_toolchain",
    "//build/rust:linux_x86_64_musl_toolchain",
)

register_toolchains("@rust_toolchains//:all")

# Custom Prost toolchain
register_toolchains(
    "//build/rust/prost_toolchain",
    "//build/rust/proto_toolchain",
)

# TODO(bazel-migration): add rust_host_tools for pinned host binaries and expand
# crate_universe coverage as additional Rust targets migrate.

# --- Rust crate dependencies (crate_universe) --------------------------------

# The former `@rust_crates` crate_universe from_cargo extension (with its cri-api/
# openssl-sys/openssl-src annotations and libzetta/ironrdp specs) was removed here:
# Rust third-party deps are now locally vendored under //third_party/crates via the
# crates_vendor rule in //third_party/BUILD.bazel. Consumers load
# //third_party/crates:defs.bzl. Removing this extension eliminates the slow Cargo
# splicing step. See openspec migrate-bazel-rust-crate-vendoring.

rdp_connector_crates = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
rdp_connector_crates.from_cargo(
    name = "rdp_connector_crates",
    cargo_lockfile = "//rust/rdp-connector-probe:Cargo.lock",
    manifests = ["//rust/rdp-connector-probe:Cargo.toml"],
)
use_repo(
    rdp_connector_crates,
    "rdp_connector_crates",
)

