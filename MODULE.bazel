# --- Bazel dependencies  ----------------------------------
bazel_dep(name = "rules_go", version = "0.62.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.51.3", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_rs", version = "0.0.99")

# Fork carrying the vendoring work.
#
# The patch repoints the Linux zlib runtime that rules_rs unpacks for the rustc
# toolchain. It pinned two Ubuntu pool URLs, and Ubuntu deletes a pool entry as
# soon as a security update supersedes it -- both are now 404, so any cold
# fetch of the Linux Rust toolchain fails outright. A warm cache hid this until
# the first expunge. Launchpad's +files endpoint keeps every published version
# permanently and serves byte-identical archives (both sha256 values below are
# unchanged), so it goes first and the pool URLs stay as fallbacks in case they
# come back.
git_override(
    module_name = "rules_rs",
    commit = "64dcc3fce2286b7fccbbe1703e4d1f87fbf1cbbd",
    patch_strip = 1,
    patches = ["//third_party/patches/rules_rs:zlib_durable_mirror.patch"],
    remote = "https://github.com/marvin-hansen/rules_rs.git",
)

# System libraries for the crates that would otherwise build them from source. rules_rs
# calls these its "well-known annotations": zstd-sys and libz-sys each ship a bundled C
# library and a build script to compile it, and pointing them at the BCR module instead
# removes a from-source C build from every Rust action that touches compression.
#
# Contrast //MODULE.bazel's openssl handling below, which deliberately does NOT take the
# equivalent suggestion: pq-src links the OpenSSL that openssl-sys builds, so swapping in
# @openssl would break that pairing. zstd and zlib have no such coupling.
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "35.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_erlang", version = "3.19.0")
bazel_dep(name = "rules_elixir", version = "1.2.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_features", version = "1.51.0", repo_name = "bazel_features")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "swiftlint", version = "0.65.0", repo_name = "SwiftLint")

