# 18-bookworm, resolved to its OCI image index digest.
#
# This was the only tag-based pull in the file, and `reproducible = False` was rules_oci
# saying so. A tag pull has to re-resolve tag -> digest against the registry on every refetch,
# and that resolution is an authenticated call: it fetches a bearer token from
# https://ghcr.io/token first. Anonymous token requests are rate limited, and a throttled one
# fails in Bazel's loading phase as "no such package @@rules_oci++oci+cloudnativepg_...",
# which took out //integration_tests/srql:srql_api_test and :srql_comprehensive_test -- two
# targets with no visible connection to containers.
#
# A digest is content-addressed, so the fetch is cacheable in the repository cache and needs
# no tag resolution. Every other pull in this file was already pinned this way.
#
# To move to a newer image, re-resolve the tag deliberately:
#   crane digest ghcr.io/cloudnative-pg/postgresql:18.4-system-bookworm
#
# The tag MUST be `18.<minor>-system-bookworm`. Two ways to get this wrong, both of
# which have already happened:
#
#   `18-bookworm`  -- abandoned upstream at 18~rc1 (2025-09-08) and never moved, so
#                     it silently builds a release candidate. A build from it was
#                     pushed over 18.3.0-sr5, which let Harbor garbage-collect the
#                     manifests demo and srql-fixtures were pinned to.
#   `18.4`         -- resolves to the BULLSEYE build (18.4-1.pgdg11+1). Postgres
#                     starts, and then PostGIS does not load: our prebuilt postgis
#                     deb is a bookworm build wanting libldap-2.5.so.0, and bullseye
#                     ships 2.4. Timescale, AGE and pgvector give no hint of it.
#
# Both parts of the suffix are load-bearing. `system` is the flavor the extension
# layers are built against, and `bookworm` has to match the Debian release every
# overlaid deb comes from -- libc6, libc6-dev, libssl-dev, postgis, pgvector. Confirm
# with the base.name label, which must read debian:bookworm-slim.
oci_ext.pull(
    name = "cloudnativepg_postgresql_18",
    digest = "sha256:63ba2470bb07cd0f4492c1f088689a6a01bbf20b5c5fc6c6472507353d14002c",
    image = "registry.carverauto.dev/mirror/cloudnative-pg/postgresql",
    platforms = [
        "linux/amd64",
    ],
)

# Official pg_duckdb image (MIT, duckdb org) — base of the analytics head
# (serviceradar-cnpg-analytics). Digest pins docker.io/pgduckdb/pgduckdb:18-v1.1.1;
# every bump must pass scripts/ci/cold-analytics-image-smoke.sh.
oci_ext.pull(
    name = "pgduckdb_18",
    digest = "sha256:44c88eb9207971af1d7f9804a37429b1bb36f413cd8d7118c81e1288ddde85d1",
    image = "docker.io/pgduckdb/pgduckdb",
    platforms = [
        "linux/amd64",
    ],
)
