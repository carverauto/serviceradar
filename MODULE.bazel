# --- Hex packages ------------------------------------------------------------
# The Elixir/Erlang dependency closure compiled by the Bazel Elixir toolchain.
#
#   bazel run  //third_party/hex:gen       regenerate after any mix.lock change
#   bazel test //third_party/hex:gen_test  fails when that has not been done
#
# Depend on a package as @hexpm//:<app> -- for example @hexpm//:ecto. (Not to be confused
# with @hex, further down: that is the Hex package manager itself.)
hexpm_ext = use_extension("//third_party/hex:extensions.bzl", "hex")
use_repo(hexpm_ext, "hexpm")

host_platform_ext = use_extension("@platforms//host:extension.bzl", "host_platform")
use_repo(host_platform_ext, "host_platform")

# --- Version Extension (reads VERSION file at load time) ----------------------------------
version_ext = use_extension("//build:version.bzl", "version_ext")
use_repo(version_ext, "serviceradar_version")

# --- Erlang/Elixir toolchains (hermetic for web-ng builds) -------------------
erlang_config_ext = use_extension("@rules_erlang//bzlmod:extensions.bzl", "erlang_config")

# Prebuilt OTP binary release rather than an otp_src build. Same version as before; the
# sha256 is the one builds.hex.pm publishes for this archive in its builds.txt, and the
# ubuntu-24.04 build matches both the RBE executor and the ubuntu_noble image bases.
# exec_compatible_with is what keeps this from matching on a Mac. It is a Linux ELF; without
# the constraint it also wins resolution on darwin, and `bazel run` of any Elixir target dies
# with "Exit 126: cannot execute" -- which reads as a broken target, not a wrong toolchain.
erlang_config_ext.prebuilt_erlang_from_hex_builds(
    name = "otp_28_1",
    arch = "amd64",
    exec_compatible_with = ["@platforms//os:linux"],
    os = "ubuntu-24.04",
    sha256 = "6f7a95250a83f999909cf64dc375fd08809eb057f61b24eecdf2b3b44fe621ab",
    version = "28.1",
)

# macOS builds OTP from source because there is nothing to download: builds.hex.pm publishes
# OTP for Linux distributions only (ubuntu-22.04 and ubuntu-24.04 answer; every macOS spelling
# 404s), and Homebrew/asdf/kerl offer no pinnable URL with a checksum. Same version as the
# Linux pin, so the two toolchains stay interchangeable.
#
# This is the slow path -- a from-source OTP build, several minutes, once per developer -- but
# it is confined to darwin exec. CI and RBE resolve the prebuilt above and keep the ~12s fetch.
# Only local `bazel run`/`bazel test` of an Elixir target needs an OTP that runs on the host;
# every sanctioned workflow goes through --config=ci and executes on Linux executors.
erlang_config_ext.internal_erlang_from_github_release(
    name = "otp_28_1_darwin",
    exec_compatible_with = ["@platforms//os:macos"],
    sha256 = "c7c6fe06a3bf0031187d4cb10d30e11de119b38bdba7cd277898f75d53bdb218",
    version = "28.1",
)
use_repo(erlang_config_ext, "erlang_config")

elixir_config_ext = use_extension("@rules_elixir//bzlmod:extensions.bzl", "elixir_config")

# Precompiled Elixir rather than a source build. Elixir is architecture-independent BEAM
# bytecode, so one archive serves every platform; the sha256 is the one builds.hex.pm
# publishes for it in builds.txt.
elixir_config_ext.prebuilt_elixir_from_hex_builds(
    name = "elixir_1_19_4",
    otp_major = "28",
    sha256 = "8fd7b5705b756c0e1ec71f9e8281b4b75801b9564f0205b5035319e8505ad2b4",
    version = "1.19.4",
)
use_repo(elixir_config_ext, "elixir_config")

# The arm64 counterpart is @otp_28_1_linux_arm64, declared with the other http_archives below.
# It is a shipped payload, not a toolchain, so it is deliberately not registered here.

# Linux first: it is the one every action resolves. The darwin pair is only reachable on a
# Mac, where the Linux toolchains no longer match at all, so order between them is not load
# bearing -- but keeping the hot one first means resolution stops at the first candidate for
# every build that matters.
#
# One Elixir toolchain serves both. Elixir is BEAM bytecode, which is why
# prebuilt_elixir_from_hex_builds takes no arch; it runs on whichever OTP resolves.
# The Hex archive, C++ runtime and NIF payloads every mix_app compile stages. Registered
# rather than flagged: this is build graph, and a .bazelrc a given invocation might not read
# would leave NIFs linking no C++ runtime -- which builds clean and fails at dlopen.
register_toolchains("//build:mix_payloads")

# protoc plus protoc-gen-elixir, built from the protobuf Hex package.
register_toolchains("//build/elixir_proto:elixir_proto")

register_toolchains(
    "@erlang_config//otp_28_1:toolchain_major",
    "@erlang_config//otp_28_1:toolchain_major_minor",
    "@erlang_config//otp_28_1_darwin:toolchain_major",
    "@erlang_config//otp_28_1_darwin:toolchain_major_minor",
    "@elixir_config//elixir_1_19_4:toolchain",
)

# Force toolchain resolution to use the hermetic Erlang toolchains (avoid the
# upstream rules_erlang \"external\" toolchains that rely on host OTP).
toolchain_resolution_overrides = {
    "@rules_erlang//tools:toolchain_type": [
        "@erlang_config//otp_28_1:toolchain_major",
        "@erlang_config//otp_28_1:toolchain_major_minor",
    ],
}

# --- Hermetic netprobe eBPF toolchain ----------------------------------------
# Building an aya eBPF program needs a nightly rustc, the std sources for
# `-Z build-std=core`, and bpf-linker -- none of which should perturb the stable
# rules_rust toolchain every other Rust target uses, and all of which have to be
# selected for whichever machine runs the action. That is toolchain resolution,
# so it lives behind @rules_aya_ebpf//:toolchain_type.
bazel_dep(name = "rules_aya_ebpf", version = "0.1.0")

# Pinned by commit
git_override(
    module_name = "rules_aya_ebpf",
    commit = "201ade2cba47809a2409d19acf72d7bc791aa89e",
    remote = "https://github.com/bazelverse/rules_aya_ebpf.git",
)

# `-Z build-std` compiles core from source, so it resolves the std workspace's own
# crates.io dependencies alongside netprobe's -- and those are what
# //third_party/netprobe_ebpf_vendor holds. The vendor tree is therefore a function
# of this exact nightly.
# Bumping: see the rules_aya_ebpf README. rustc's LLVM must not exceed
# bpf-linker's, and the vendor tree must be regenerated in the same commit.
aya_ebpf_ext = use_extension("@rules_aya_ebpf//bzlmod:extensions.bzl", "aya_ebpf")
aya_ebpf_ext.nightly(
    cargo_sha256 = "fe5f7e032778e3ecb543c23a254f2862a5ce2682daff281fdaeb6fd0f2c02d5c",
    date = "2026-08-05",
    rust_src_sha256 = "b03bfe0cc73b77d00e57cdfe895fa1bbcb0b6cfad236eaae4294ebe55aca6526",
    rust_std_sha256 = "d1fa3abf0ba340bd055a6de89786a3b9510bb5ab43efe433836b21d729a52c44",
    rustc_sha256 = "a20c82439bff4a21873e88b6a14d836285ba79a4e9196d602af2b4ff1ddf2c8b",
)
aya_ebpf_ext.bpf_linker(
    archive_extension = "tar.zst",
    sha256 = "4dda77daab6c5f120a468e6d3ede2498f5bd47ece712172cfb7290176d93d015",
    version = "0.10.4",
)

# --- Python toolchain (hermetic for all platforms) -------------------
# Configure hermetic Python toolchains for consistent behavior across
# local builds and remote cache. This prevents architecture mismatches
# when rules_multirun pulls cached artifacts.
#
# Declare that this module uses explicit packages. The matching root Bazel
# option also applies the future rules_python default to transitive tools so
# their implicit-package deprecation warnings do not leak into our builds.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

#
# IMPORTANT: Register host toolchains FIRST so they take precedence for
# host-transitioned targets like rules_multirun (which use cfg="host").
# See: https://github.com/bazelbuild/bazel/issues/5309
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)
use_repo(python, "python_3_11", "python_versions")

register_toolchains(
    # Host toolchains first - ensures local Python is used for `bazel run`
    # targets that use cfg="host" transitions (like rules_multirun)
    "//build/python_toolchain:py3_toolchain",  # macOS ARM64
    "//build/python_toolchain:py3_toolchain_x86_64",  # macOS x86_64
    # Hermetic toolchains for cross-platform builds and remote execution
    "@python_versions//3.11:all",
)

# --- RPM & package Toolchain  ----------------------------------

# Prefer a fixed Linux rpmbuild so remote/RBE builds stay hermetic. We skip the
# host autodetect toolchain (would point at Homebrew on macOS).
register_toolchains("//build/rpm_toolchain:rpmbuild_linux_toolchain")

# --- CC Toolchain  ----------------------------------

cc_configure_ext = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure_ext, "local_config_cc", "local_config_cc_toolchains")

cc_compat_ext = use_extension("@rules_cc//cc:extensions.bzl", "compatibility_proxy")
use_repo(cc_compat_ext, "cc_compatibility_proxy")

# --- BuildBuddy Toolchain  ----------------------------------
buildbuddy_toolchain_ext = use_extension(
    "@io_buildbuddy_buildbuddy_toolchain//:extensions.bzl",
    "buildbuddy",
