register_toolchains(
    # These are the GLIBC cc toolchains only. musl targets are served by @toolchains_musl
    # below; see the comment there for why we do not hand-roll a musl cc toolchain.
    #
    # Both entries declare //build/platforms:linux_glibc in target_compatible_with, which is
    # what keeps them from matching a musl platform. Resolution takes the FIRST registered
    # toolchain whose constraints the target platform satisfies -- not the most specific one --
    # so without that constraint :rbe_cc_toolchain, asking only for (x86_64, linux), also
    # matches (x86_64, linux, linux_musl) and wins by virtue of being listed here.
    "//build/toolchains:rbe_cc_toolchain",
    "//build/toolchains:rbe_cc_toolchain_arm64",
)

# --- musl cc toolchain (bazel-contrib/musl-toolchain) ---------------
#
# This replaces a hand-written cc_toolchain_config that was NOT a musl toolchain: it named
# plain /usr/bin/gcc, set `target_libc = "musl"` as a free-text label, and tried to get
# staticness from `-static` in link_flags. Since the compiler and its libstdc++/libm were the
# distro's glibc ones, "musl" was a naming convention and nothing more -- and
# //rust/netprobe:static_linkage_test caught it once ld.lld started faithfully recording the
# DT_NEEDED entries that ld.gold had quietly resolved away.
#
# @toolchains_musl downloads a real musl-targeting gcc and enables the `fully_static_link`
# feature itself, so `-static`, the static libstdc++/libm and the absence of a dynamic loader
# all come from the toolchain rather than from flags we have to remember to keep in sync.
#
# `extra_target_compatible_with` is what binds it to our own libc constraint; without it these
# toolchains match ANY linux platform, including the glibc ones. This mirrors rules_rust's
# examples/cross_compile_musl, which keys its toolchains on a `linker_config:musl` constraint
# for the same reason.
#
bazel_dep(name = "toolchains_musl", version = "0.1.27.bcr.1")

toolchains_musl = use_extension("@toolchains_musl//:toolchains_musl.bzl", "toolchains_musl")
toolchains_musl.config(
    extra_target_compatible_with = ["//build/platforms:linux_musl"],
)
use_repo(toolchains_musl, "musl_toolchains_hub")

# REGISTERED HERE, AND BEFORE @llvm_toolchain BELOW. Both facts are load-bearing.
#
# @toolchains_musl already registers this from its own MODULE.bazel, but a DEPENDENCY's
# registrations are ordered after every one of the root module's -- including
# `register_toolchains("@llvm_toolchain//:all")` further down. @toolchains_llvm generates
# its toolchain set from the HOST, and on a linux-x86_64 host that set includes
# `cc-toolchain-x86_64-linux`, whose target_compatible_with is [x86_64, linux] with nothing
# about libc. It therefore matches a musl target platform and, being registered first, wins.
#
# That made musl builds host-dependent, which is a miserable failure mode: on a macOS host
# @toolchains_llvm emits only darwin/none toolchains, none of which match musl, so the musl
# hub won and `bazel build //...` passed. The same commit failed on the Linux workflow
# runner, compiling musl targets with glibc headers and failing at link on symbols musl does
# not have (`__memcpy_chk` from zstd-sys, `__isoc23_sscanf` from aws-lc-sys).
#
# Repeating the registration here puts it in root-module order, ahead of @llvm_toolchain.
# Do not move it below that line, and do not drop it as redundant.
register_toolchains("@musl_toolchains_hub//:all")

# --- LLVM Toolchain (clang/lld) ----------------------------------
llvm_ext = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
)
llvm_ext.toolchain(
    name = "llvm_toolchain",
    llvm_versions = {
        # Fallback for hosts whose distro-specific key is not listed below
        # (e.g. ubuntu-24.04-x86_64, debian-12-x86_64).
        "": "17.0.4",
        # Explicit generic Linux key to cover distros like Oracle Linux 9.
        "linux-x86_64": "17.0.4",
        "darwin-aarch64": "17.0.4",
        "darwin-x86_64": "15.0.7",
        "ubuntu-22.04-x86_64": "17.0.4",
    },
)
use_repo(llvm_ext, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

