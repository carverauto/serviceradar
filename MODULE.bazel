# The arm64 OTP an arm64 Elixir image SHIPS; the amd64 pin above still RUNS the build.
# `mix release` collapses both roles into one OTP, which is what blocks arm64 Elixir.
# Not a second prebuilt_erlang_from_hex_builds: no CPU constraint on those toolchains, so a
# second registration would be ambiguous rather than selective.

http_archive(
    name = "otp_28_1_linux_arm64",
    build_file_content = """
# `Install` is the archive's only top-level FILE, so its $(location) parent is the OTP root --
# which a filegroup of 30k files in unspecified order cannot give you.
filegroup(
    name = "root_marker",
    srcs = ["Install"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "otp_root",
    # Excluded paths hold spaces and cannot be passed to the action shell; all are test data.
    srcs = glob(
        allow_empty = False,
        include = ["**"],
        exclude = ["**/* *"],
    ),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "4585a32725c8eebcd9154cd8884366c93077895d1044974f1b728df5eae2cee9",
    strip_prefix = "OTP-28.1",
    urls = ["https://builds.hex.pm/builds/otp/arm64/ubuntu-24.04/OTP-28.1.tar.gz"],
)

# Hex, the package manager itself, built from source as a Mix archive by rules_elixir.
#
# NOT used to fetch anything -- every dependency is already a Bazel repository (see the Hex
# packages extension above) and mix runs with --no-deps-check. Mix simply refuses to resolve
# a project without Hex installed as an archive: `{:dep, "~> x.y"}` in a mix.exs aborts with
# "Could not find an SCM for dependency", even for a dev-only dep nothing would compile.
#
# Pinned here rather than taking the ruleset default, for the same reason the OTP and Elixir
# versions are pinned above: the version this repo builds against should be visible in one
# place. Consumed as @hex//:archive.
hex_ext = use_extension("@rules_elixir//bzlmod:extensions.bzl", "hex")
hex_ext.from_github_release(
    sha256 = "dabd99ea48ba8064c32bc2e97d59ab1b1055a38a1dd178c5389d95c35e985d2d",
    version = "2.5.1",
)
use_repo(hex_ext, "hex")

