use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# Custom Prost toolchain
register_toolchains(
    "//build/rust/prost_toolchain",
    "//build/rust/proto_toolchain",
)

# Every exec and target triple that can take part in a build.
RUST_PLATFORMS = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "aarch64-unknown-linux-musl",
    "x86_64-unknown-linux-gnu",
    "x86_64-unknown-linux-musl",
]

# Crate sources are vendored as .crate archives in //third_party/crate_mirror, reached through
# --distdir rather than through the dependency graph: rules_rs generates its own BUILD file per
# crate, so the mirror carries sources only, and anything missing falls back to the registry.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")

# External repositories that Cargo.toml annotations refer to by name.
crate.repo_alias(
    name = "zstd",
    repo = "@zstd",
)
crate.repo_alias(
    name = "zlib",
    repo = "@zlib",
)

# pq-src compiles libpq's TLS sources in its own build-script action. openssl-sys hands it
# the include path through DEP_OPENSSL_INCLUDE, but a path is not an input: without the tree
# artifact staged in that action's sandbox too, the compile fails on `openssl/ssl.h` not
# found while pointing straight at the directory that holds it.
crate.repo_alias(
    name = "openssl_gen_dir",
    repo = "@openssl//:gen_dir",
)
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = RUST_PLATFORMS,
)

# openssl-sys: link the OpenSSL that @openssl builds, instead of building one.
#
# OPENSSL_NO_VENDOR turns off the openssl-src path and OPENSSL_STATIC picks the archives over
# the shared libraries collated beside them. @openssl//:gen_dir is a directory laid out the
# way openssl-sys expects: include/openssl/*.h and lib/lib{ssl,crypto}.a.
#
# LIB_DIR and INCLUDE_DIR rather than the one OPENSSL_DIR that would imply both. openssl-sys'
# find_normal.rs reads that pair FIRST and returns before it ever looks at OPENSSL_DIR, so
# whoever sets the pair decides which OpenSSL gets linked. //.bazelrc used to set it to /usr
# and no longer does; naming both here means this annotation decides, rather than depending on
# an env var's continued absence. (The `vendored` feature short-circuited all of this, which is
# why the old setting was harmless and invisible at the same time.)
#
# pq-src reads DEP_OPENSSL_INCLUDE, which openssl-sys emits from this same directory, so
# libpq's TLS code compiles against the headers the Rust bindings were generated from and
# links the archives they were checked against. That pairing is why openssl-sys used to have
# to build OpenSSL itself; it holds here because both sides resolve through one build script.
crate.annotation(
    build_script_data = ["@openssl//:gen_dir"],
    build_script_env = {
        "OPENSSL_INCLUDE_DIR": "$(execpath @openssl//:gen_dir)/include",
        "OPENSSL_LIB_DIR": "$(execpath @openssl//:gen_dir)/lib",
        "OPENSSL_NO_VENDOR": "1",
        "OPENSSL_STATIC": "1",
    },
    crate = "openssl-sys",
    data = ["@openssl//:gen_dir"],
    gen_build_script = "on",
    repositories = ["crates"],
)

# @openssl is a bazel_dep of the root module, not of the generated hub, so the label above
# is not resolvable from @crates without this.
inject_repo(crate, "openssl")

use_repo(crate, "crates")

# rdp-connector-probe is deliberately detached from the workspace (its own Cargo.lock), so it
