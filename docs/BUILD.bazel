load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Read by //build/contracts:first_party_plugin_cosign_key_consistency_test as the canonical copy of the
# Cosign release key. docs/ is its own package, so the file does not resolve as a label
# from the root package without this.
exports_files([
    "BUILD.bazel",
    "cosign.pub",
    "lint_placeholder.sh",
    "sigstore/rekor.pub",
])

# Every accepted Rekor v1 public key, named <logID>.pub. Shipped in the web-ng image and
# kept byte-identical to it by //build/contracts:rekor_key_consistency_test.
filegroup(
    name = "sigstore_rekor_keys",
    srcs = glob(["sigstore/rekor-keys/*.pub"]),
)

sh_test(
    name = "lint",
    srcs = ["lint_placeholder.sh"],
)
