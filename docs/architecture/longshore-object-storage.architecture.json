  "cards": [
    {
      "dot": "emerald",
      "title": "Verified Write & Readback",
      "items": [
        "Budget::once single-attempt PUT with If-None-Match: * when no_clobber is true",
        "Records *-put-canonical-v1 canonical_request_sha256 before authority verify",
        "Requires independent HEAD + 4 MiB ranged GET SHA-256 readback; Answer.sha256 is optional"
      ]
    },
    {
      "dot": "cyan",
      "title": "Safe BEAM + io_uring Bridge",
      "items": [
        "Supervised ObjectStorage.Session correlates replies by ref with zero caller mailbox leaks",
        "Strict config/option decoding rejects missing, unknown, or wrongly-typed fields with :bad_config",
        "Pooled ScratchBuf on PUT and direct OwnedBinary release on 200/206 GET avoid redundant copies"
      ]
    },
    {
      "dot": "amber",
      "title": "Unified Credential & Media Scope",
      "items": [
        "Binds s3_compatible secrets from platform.network_credential_secrets via SecretBroker",
        "Opt-in :longshore adapter preserves :http fallback without changing Core wire schemas",
        "Live camera viewing stays WebRTC; recorded browser playback stays HLS / fMP4"
      ]
    }
  ]
