  "cards": [
    {
      "dot": "cyan",
      "title": "Two Retention Tiers",
      "items": [
        "90 days: api_events, security_events, playbook-run and northbound execution tables",
        "180 days: config-audit-trail version tables (credentials, dashboards, lockouts)",
        "Every window per-table overridable; 0 disables that table"
      ]
    },
    {
      "dot": "emerald",
      "title": "Bounded Deletes Only",
      "items": [
        "DELETE \u2026 WHERE id IN (SELECT \u2026 ORDER BY version_inserted_at LIMIT batch_size)",
        "One Oban run deletes at most batch_size rows per table",
        "120 s query timeout per statement, matching RemoteAccessVersionRetentionWorker"
      ]
    },
    {
      "dot": "rose",
      "title": "No Behavior Change By Default",
      "items": [
        "security_events keeps its hardcoded 90-day window unless the new env var is set",
        "remote_access_*_versions stay with their existing worker, untouched",
        "No hypertable conversion, no compression, no UI controls in this change"
      ]
    }
  ]
