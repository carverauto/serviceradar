load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build:integration_tests.bzl", "requires_shared_fixture")

# SRQL integration tests.
#
# These talk to the shared CNPG fixture over the network via SRQL_TEST_DATABASE_URL /
# SRQL_TEST_ADMIN_URL. CI callers keep compilation remote/cacheable but deliberately place
# each database-facing TestRunner on the workflow runner, which owns the fixture credentials
# and network route.
# tests/support/harness.rs applies tests/fixtures/{schema,seed}.sql itself and SKIPS
# outright when those two variables are absent, so no target here ever starts a database.
#
# `manual` stays: they need the fixture credentials in the environment and they run DDL
# against a fixture concurrent branches share, so a step that wants them must name them
# explicitly, pass an empty --test_tag_filters=, and opt in with
# --//build:enable_integration_tests.
#
# WHAT WAS HERE BEFORE, and why it is gone:
#
#   //docker/images:cnpg_image_amd64_tar in `data` -- vestigial. Nothing in tests/ reads it;
#   the only runfiles lookup in the harness resolves the two .sql fixtures. It dragged a
#   full Postgres image build (AGE + TimescaleDB, compiled from an extracted Debian rootfs)
#   into the graph of every build that touched this package, for nothing.
#
#   `no-remote-exec` -- followed from the image, and cost more than it looks. The tag
#   propagates from a *_test rule to its COMPILE actions, so rustc ran wherever the client
#   was. rustc bundles LLVM for codegen but no linker: on linux-gnu it shells out to the
#   cc_toolchain's linker driver, which under --config=ci is @buildbuddy_toolchain's
#   /usr/bin/gcc. That path exists in //docker/Dockerfile.rbe and not on the workflow
#   runner, so the compile died with `linker /usr/bin/gcc not found` -- and on a macOS
#   workstation with `cannot execute binary file` (Exit 126), because the process_wrapper
#   is built for the Linux exec platform. Both symptoms, one cause. Remote execution has
#   the toolchain the exec platform actually describes.
#
# So: do not reintroduce either. If a test here ever genuinely needs its own database,
# that is a design change to discuss, not a `data` entry -- the shared fixture is the
# contract, and //rust/integration-db owns its lifecycle.
#
# TLS travels as PEM CONTENT so the action is independent of a runner-local certificate path:
# callers explicitly select //.bazelrc's database_env profile to forward
# SRQL_TEST_DATABASE_CA_CERT, and the harness materializes it when PGSSLROOTCERT does not name a
# readable path. Generic remote tests do not receive this credential-bearing environment.
#
# `all_crate_deps(..., cargo_only = True)` resolves this crate's own dev-dependencies from
# //integration_tests/srql/Cargo.toml. `cargo_only` keeps the result to third-party crates:
# rules_rs also reports first-party workspace members, and //rust/srql is already named above.

SRQL_IT_DATA = [
    "tests/fixtures/schema.sql",
    "tests/fixtures/seed.sql",
]

SRQL_IT_DEPS = ["//rust/srql:srql_lib"] + all_crate_deps(
    cargo_only = True,
    normal = True,
    normal_dev = True,
)

rust_test(
    name = "srql_api_test",
    srcs = [
        "tests/api.rs",
        "tests/support/harness.rs",
        "tests/support/mod.rs",
    ],
    crate_name = "srql_api_tests",
    crate_root = "tests/api.rs",
    data = SRQL_IT_DATA,
    edition = "2021",
    # integration_test, NOT manual. `manual` removed these from //... expansion BEFORE tag
    # filters were considered, so no wildcard could ever reach them and every caller had to
    # name them explicitly -- which is how srql_device_grouped_stats_test ended up running in
    # buildbuddy.yaml but not in the Forgejo job. The tag is the real filter: the unit sweep
    # excludes it with -integration_test, the database sweep selects it. requires_shared_fixture()
    # remains the second guard -- without --//build:enable_integration_tests these are
    # incompatible and a wildcard skips them.
    tags = ["integration_test"],
    target_compatible_with = requires_shared_fixture(),
    deps = SRQL_IT_DEPS,
)

rust_test(
    name = "srql_comprehensive_test",
    srcs = [
        "tests/comprehensive_queries.rs",
        "tests/support/harness.rs",
        "tests/support/mod.rs",
    ],
    crate_name = "srql_comprehensive_tests",
    crate_root = "tests/comprehensive_queries.rs",
    data = SRQL_IT_DATA,
    edition = "2021",
    # integration_test, NOT manual. `manual` removed these from //... expansion BEFORE tag
    # filters were considered, so no wildcard could ever reach them and every caller had to
    # name them explicitly -- which is how srql_device_grouped_stats_test ended up running in
    # buildbuddy.yaml but not in the Forgejo job. The tag is the real filter: the unit sweep
    # excludes it with -integration_test, the database sweep selects it. requires_shared_fixture()
    # remains the second guard -- without --//build:enable_integration_tests these are
    # incompatible and a wildcard skips them.
    tags = ["integration_test"],
    target_compatible_with = requires_shared_fixture(),
    deps = SRQL_IT_DEPS,
)

# Grouped device stats have to be exercised against a real Postgres: the
# placeholder-rewriting bug they cover is invisible to translation-only tests,
# which never hand the SQL to a server.
rust_test(
    name = "srql_device_grouped_stats_test",
    srcs = [
        "tests/device_grouped_stats.rs",
        "tests/support/harness.rs",
        "tests/support/mod.rs",
    ],
    crate_name = "srql_device_grouped_stats_tests",
    crate_root = "tests/device_grouped_stats.rs",
    data = SRQL_IT_DATA,
    edition = "2021",
    # integration_test, NOT manual. `manual` removed these from //... expansion BEFORE tag
    # filters were considered, so no wildcard could ever reach them and every caller had to
    # name them explicitly -- which is how srql_device_grouped_stats_test ended up running in
    # buildbuddy.yaml but not in the Forgejo job. The tag is the real filter: the unit sweep
    # excludes it with -integration_test, the database sweep selects it. requires_shared_fixture()
    # remains the second guard -- without --//build:enable_integration_tests these are
    # incompatible and a wildcard skips them.
    tags = ["integration_test"],
    target_compatible_with = requires_shared_fixture(),
    deps = SRQL_IT_DEPS,
)
