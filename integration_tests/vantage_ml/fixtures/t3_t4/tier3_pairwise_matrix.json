{
  "schema_version": "1.0.0",
  "milestone": "E2E-M5",
  "description": "Synthetic Tier 3 pairwise cross-feature contract vectors (15 pairs across F1-F14).",
  "pairs": [
    {
      "test_id": "E2E-T3-01",
      "pair": "F1xF2",
      "feature": "F1+F2",
      "boundary": "CNPG schema FKs/checks <-> RecordingCatalogEntry quarantine/reclaim trigger & RecordingHold",
      "camera_name": "Gate West 01",
      "camera_source_id": "22222222-2222-4222-8222-222222222201",
      "hold_window": {
        "state": "accepted",
        "start_us": 1760000000000000,
        "end_us": 1760000020000000
      },
      "transitions": [
        {
          "name": "quarantined_purges_recorded_and_cancels_active_jobs",
          "source_mode": "recorded_block",
          "local_state": "quarantined",
          "archive_state": "verified",
          "held": false,
          "expected_observations_purged": true,
          "expected_active_jobs_cancelled": true,
          "expected_completed_jobs_preserved": true
        },
        {
          "name": "reclaimed_verified_preserves_observations",
          "source_mode": "recorded_block",
          "local_state": "reclaimed",
          "archive_state": "verified",
          "held": false,
          "expected_observations_purged": false,
          "expected_active_jobs_cancelled": false,
          "expected_completed_jobs_preserved": true
        },
        {
          "name": "reclaimed_deleted_purges_unheld_observations",
          "source_mode": "recorded_block",
          "local_state": "reclaimed",
          "archive_state": "deleted",
          "held": false,
          "expected_observations_purged": true,
          "expected_active_jobs_cancelled": true,
          "expected_completed_jobs_preserved": true
        },
        {
          "name": "accepted_hold_blocks_terminal_reclaim",
          "source_mode": "recorded_block",
          "local_state": "present",
          "archive_state": "verified",
          "held": true,
          "expected_observations_purged": false,
          "expected_hold_pinned_copy": "archive",
          "expected_active_jobs_cancelled": false
        },
        {
          "name": "live_tap_null_catalog_survives_sibling_block_reclaim",
          "source_mode": "live_keyframe_tap",
          "local_state": "reclaimed",
          "archive_state": "deleted",
          "held": false,
          "expected_observations_purged": false,
          "expected_survives_until_source_cascade": true
        }
      ]
    },
    {
      "test_id": "E2E-T3-02",
      "pair": "F1xF3",
      "feature": "F1+F3",
      "boundary": "Ash constraints (32 KiB crop_jpeg, bbox, search_tsv) <-> EventWriter pre-upsert projector validation",
      "expected_persisted_crop_max_bytes": 32768,
      "search_tokens": ["SR-0100", "Gate", "West", "silver", "sedan"],
      "negative_cases": [
        {
          "name": "crop_32769_bytes_rejected_before_ash_upsert",
          "crop_bytes": 32769,
          "expected_disposition": "dead_letter",
          "expected_rows_written": 0
        },
        {
          "name": "invalid_plate_text_rejected_before_ash_upsert",
          "plate_text": "bad plate!",
          "expected_disposition": "dead_letter",
          "expected_rows_written": 0
        },
        {
          "name": "inverted_bbox_rejected_before_ash_upsert",
          "bbox": [0.7, 0.2, 0.3, 0.8],
          "expected_disposition": "dead_letter",
          "expected_rows_written": 0
        }
      ]
    },
    {
      "test_id": "E2E-T3-03",
      "pair": "F2xF3",
      "feature": "F2+F3",
      "boundary": "Quarantine/terminal deletion race <-> In-flight media.results.vantage.v1 projection",
      "race_scenarios": [
        {
          "name": "quarantined_before_result_arrival",
          "catalog_local_state": "quarantined",
          "catalog_archive_state": "verified",
          "expected_disposition": "drop_recording_gone",
          "expected_job_state": "cancelled",
          "expected_observations_persisted": 0
        },
        {
          "name": "reclaimed_deleted_before_result_arrival",
          "catalog_local_state": "reclaimed",
          "catalog_archive_state": "deleted",
          "expected_disposition": "drop_recording_gone",
          "expected_job_state": "cancelled",
          "expected_observations_persisted": 0
        },
        {
          "name": "present_and_playable_persists_cleanly",
          "catalog_local_state": "present",
          "catalog_archive_state": "not_required",
          "expected_disposition": "persisted",
          "expected_job_state": "completed",
          "expected_observations_persisted": 1
        }
      ]
    },
    {
      "test_id": "E2E-T3-04",
      "pair": "F2xF11",
      "feature": "F2+F11",
      "boundary": "Quarantine/reclaim state <-> POST /v1/media/workers/read-grants 410 recording_gone",
      "cases": [
        {
          "name": "playable_present_issues_200_reader_grant",
          "local_state": "present",
          "archive_state": "not_required",
          "descriptor_match": true,
          "expected_http_status": 200,
          "expected_job_state_after": "dispatched"
        },
        {
          "name": "quarantined_returns_410_and_cancels_job",
          "local_state": "quarantined",
          "archive_state": "verified",
          "descriptor_match": true,
          "expected_http_status": 410,
          "expected_body_status": "recording_gone",
          "expected_job_state_after": "cancelled"
        },
        {
          "name": "reclaimed_deleted_returns_410_and_cancels_job",
          "local_state": "reclaimed",
          "archive_state": "deleted",
          "descriptor_match": true,
          "expected_http_status": 410,
          "expected_body_status": "recording_gone",
          "expected_job_state_after": "cancelled"
        },
        {
          "name": "descriptor_mismatch_returns_409",
          "local_state": "present",
          "archive_state": "not_required",
          "descriptor_match": false,
          "expected_http_status": 409,
          "expected_body_status": "descriptor_sha256_mismatch"
        }
      ]
    },
    {
