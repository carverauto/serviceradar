load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# Keep Markdown files out of Bazel data inputs so docs_only_ci_contract_test
# (DocsOnlyExclusionCoverageContractTest) never sees an unexcluded Markdown literal.
filegroup(
    name = "fixtures_data",
    srcs = glob(
        ["fixtures/**/*.json"],
        allow_empty = False,
    ),
)

py_library(
    name = "vantage_contracts",
    srcs = [
        "__init__.py",
        "fixtures/__init__.py",
        "vantage_contracts.py",
    ],
    data = [
        ":fixtures_data",
        "//elixir/serviceradar_core:vantage_alpr_pack",
    ],
)

py_library(
    name = "drivers",
    srcs = glob(["drivers/*.py"]),
    deps = [":vantage_contracts"],
)

py_test(
    name = "mode_a_contracts_test",
    size = "small",
    srcs = ["test_mode_a_contracts.py"],
    main = "test_mode_a_contracts.py",
    deps = [
        ":drivers",
        ":vantage_contracts",
    ],
)

py_test(
    name = "mode_a_synthetic_media_test",
    size = "small",
    srcs = ["test_mode_a_synthetic_media.py"],
    main = "test_mode_a_synthetic_media.py",
    deps = [":vantage_contracts"],
)

