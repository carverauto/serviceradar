load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("//build:integration_tests.bzl", "requires_shared_fixture")

# //integration_tests/edge_record:vertical_slice_test -- unify-sweep-results-proto task 0.12,
# "FIRST GREEN VERTICAL SLICE". Drives ONE committed bulk SweepObservationBatchV1 fixture through
# the REAL composed path:
#
#   record -> agent spool -> mTLS gRPC -> gateway -> JetStream PubAck
#          -> EventWriter -> idempotent CNPG transaction -> query
#
# using real production binaries as OS subprocesses -- the serviceradar_agent_gateway and
# serviceradar_core_elx Mix releases (elixir_release outputs, started via their own `bin/<name>
# start`, mirroring how docker-compose.yml deploys them as separate services) and the real
# go/cmd/agent binary in its normal push-mode entry point -- plus an embedded, JetStream-enabled
# NATS broker and a synthetic mTLS PKI generated at test runtime (no committed fixtures needed).
#
# `integration_test` makes the guarded wildcard select it, matching integration_tests/srql's
# pattern; `requires_shared_fixture()` is the independent opt-in gate (without
# --//build:enable_integration_tests this target is @platforms//:incompatible). This is a Go test
# rather than the Rust rust_test srql uses because the composed path is cross-language (Go agent +
# two Elixir releases): describe_run_base.rs is what lets a Go process resolve the SAME typed
# SERVICERADAR_ENV=ci fixture identity every other language's integration lane resolves internally.
go_test(
    name = "vertical_slice_test",
    size = "large",
    srcs = [
        "agentproc.go",
        "certs.go",
        "certs_selfcheck_test.go",
        "fixture.go",
        "fixture_selfcheck_test.go",
        "natsjwt.go",
        "natsjwt_selfcheck_test.go",
        "releases.go",
        "vertical_slice_test.go",
    ],
    data = [
        "//build:run_id_file",
        "//elixir/serviceradar_agent_gateway:release_tar",
        "//elixir/serviceradar_core_elx:release_tar",
        "//go/cmd/agent",
        "//rust/integration-db:describe_run_base",
    ],
    importpath = "github.com/carverauto/serviceradar/integration_tests/edge_record",
    tags = ["integration_test"],
    target_compatible_with = requires_shared_fixture(),
    # `size = "large"` (default timeout 900s per rules_go/bazel size conventions) because this
    # target extracts two Mix release tarballs, boots two real BEAM VMs, and runs six sequential
    # acceptance groups against them -- materially slower than an in-process unit test.
    x_defs = {
        "github.com/carverauto/serviceradar/integration_tests/edge_record.gatewayReleaseTarRlocation": "$(rlocationpath //elixir/serviceradar_agent_gateway:release_tar)",
        "github.com/carverauto/serviceradar/integration_tests/edge_record.coreReleaseTarRlocation": "$(rlocationpath //elixir/serviceradar_core_elx:release_tar)",
        "github.com/carverauto/serviceradar/integration_tests/edge_record.agentBinaryRlocation": "$(rlocationpath //go/cmd/agent)",
        "github.com/carverauto/serviceradar/integration_tests/edge_record.describeRunBaseRlocation": "$(rlocationpath //rust/integration-db:describe_run_base)",
    },
    deps = [
        "//go/pkg/edge/edgerecord",
        "//go/pkg/edge/projection",
        "//go/pkg/edge/sender",
        "//go/pkg/edge/spool",
        "//proto/edge/v1:edgev1",
        "@com_github_nats_io_jwt_v2//:jwt",
        "@com_github_nats_io_nats_go//:nats_go",
        "@com_github_nats_io_nats_go//jetstream",
        "@com_github_nats_io_nats_server_v2//server",
        "@com_github_nats_io_nkeys//:nkeys",
        "@io_bazel_rules_go//go/runfiles",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
