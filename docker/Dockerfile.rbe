# syntax=docker/dockerfile:1

# Custom RBE executor image based on Ubuntu 24.04 (glibc 2.39) with development tooling.
# This image provides a hermetic build environment for BuildBuddy RBE.
FROM --platform=linux/amd64 ubuntu:24.04

# Set non-interactive frontend for apt to prevent prompts
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-lc"]

# 1. Install basic setup tools, repository handling, and common dependencies
# 2. Setup PostgreSQL official repo for version 18
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        file \
        gnupg \
        lsb-release \
        wget \
        software-properties-common \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && sh -c 'echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] http://apt.postgresql.org/pub/repos/apt noble-pgdg main" > /etc/apt/sources.list.d/pgdg.list' \
    # Docker CE official repo. arch=amd64 is required here: the arm64 foreign
    # architecture added below makes apt fetch an arm64 index for every repo
    # that does not pin an arch, which fails 'apt-get update'.
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && sh -c 'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list' \
    # No `dpkg --add-architecture arm64` and no ports.ubuntu.com sources. They existed only
    # to install the :arm64 cross libraries removed above, and they cost more than their
    # bytes: a foreign architecture makes apt fetch an arm64 index for every repo that does
    # not pin one, which is why the Docker CE list above pins arch=amd64 and why ubuntu.sources
    # needed the `Architectures: amd64` awk rewrite. All three are gone together.
    && apt-get update && apt-get install -y --no-install-recommends \
        # Build Tools & Compilers
        build-essential \
        gcc \
        g++ \
        # NO aarch64 cross-gcc. hermetic-llvm cross-compiles aarch64 with its own clang and
        # its own glibc 2.28 headers/sysroot; the host cross-gcc is not merely unused, it was
        # actively harmful -- cc-rs prefers a target-specific CC_<triple>, so the ENV pointing
        # at it made every cc-rs crate build aarch64 with gcc and clang's CFLAGS.
        # NO clang / llvm / llvm-dev / lld. hermetic-llvm (the `llvm` bazel_dep) downloads
        # its own clang and ld.lld and every cc action resolves to those --
        # external/llvm++llvm_toolchain_minimal+.../bin/clang++ ... -fuse-ld=lld. Nothing in
        # //.bazelrc or //MODULE.bazel names a host compiler or linker any more.
        #
        # `lld` used to be justified by `use_ld = "lld"` on the buildbuddy gcc_toolchain; that
        # toolchain tag is gone. These four packages were 619 MB of /usr/lib/llvm-18.
        #
        # gcc/g++ below STAY: mix/Bundlex compile Elixir NIFs with the system cc, outside
        # Bazel's cc toolchain.
        make \
        cmake \
        bison \
        flex \
        gperf \
        pkg-config \
        # Container Tools
        skopeo \
        iptables \
        # Docker CE. Required by BuildBuddy's Firecracker guest init when an action
        # sets test.init-dockerd: it LookPath's BOTH `docker` and `dockerd` and returns
        # an error if either is missing, which exits init(1) and panics the guest kernel
        # ("Attempted to kill init!"). Do not drop these.
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin \
        # Database / Libs
        # NOT postgresql-server-dev-18: it Depends on clang-19 and llvm-19-dev for
        # PostgreSQL's JIT, which is a second complete LLVM (/usr/lib/llvm-19, 408 MB) that
        # nothing here compiles against. The CNPG extension layers that genuinely need the
        # PGXS headers take the .deb as a declared Bazel input instead
        # (@postgresql_server_dev_18_deb//file, see //docker/images/cnpg_image.bzl), so the
        # image copy was redundant as well as enormous. libpq-dev alone covers the headers.
        libpq-dev \
        libssl-dev \
        # OTP's erts/configure probes tgetent in -ltinfo/-lncurses/-lcurses/-ltermcap and
        # aborts with "No curses library functions found" without a linkable one. This used
        # to arrive transitively via llvm-dev (LLVM links terminfo), so removing LLVM took it
        # out and broke `rules_erlang` building OTP 28.1 from source -- which had been coasting
        # on a remote cache hit and only rebuilt once the container image changed the action
        # key. Declared explicitly now, because OTP needs it and a compiler package is not a
        # legitimate way to acquire it.
        #
        # The other four dev packages llvm-dev pulled -- libxml2-dev, libz3-dev, libicu-dev,
        # libffi-dev -- are deliberately NOT restored: those were LLVM's own (Z3 for the
        # static analyzer, libxml2 for Windows manifests) and nothing here compiles against
        # them.
        libncurses-dev \
        zlib1g-dev \
        liblz4-dev \
        libzstd-dev \
        libgmp-dev \
        libev-dev \
        libbpf-dev \
        linux-tools-common \
        linux-tools-generic \
        protobuf-compiler \
        libprotobuf-dev \
        # Utils
        git \
        patch \
        unzip \
        rsync \
        tar \
        m4 \
        perl \
        # RPM Building on Debian
        rpm \
        createrepo-c \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install libssl1.1 runtime for binaries that still target OpenSSL 1.1.
RUN curl -fsSL http://security.ubuntu.com/ubuntu/pool/main/o/openssl/libssl1.1_1.1.1f-1ubuntu2.24_amd64.deb -o /tmp/libssl1.1.deb \
    && dpkg -i /tmp/libssl1.1.deb \
    && rm /tmp/libssl1.1.deb

RUN ln -sf /usr/sbin/iptables /usr/bin/iptables

# Fail the image build rather than the microVM if Docker went missing. The guest
# init resolves these against its own hardcoded PATH, not the image ENV, so they
# must live under /usr/bin (where the docker-ce packages install them).
RUN docker --version && dockerd --version && docker buildx version \
    && test -x /usr/bin/docker && test -x /usr/bin/dockerd

# Note: do NOT ship /etc/docker/daemon.json here. The Firecracker guest init
# overwrites it from MMDS on every boot; registry mirrors and insecure registries
# are configured on the executor via --executor.firecracker_vm_docker_* flags.

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Provide the common RHEL-style lib64 path expected by some build scripts.
RUN ln -s /usr/lib/x86_64-linux-gnu /usr/lib64

# Ubuntu 24.04 defaults to GCC 13+, so we do not need the 'ln -sf' hacks 
# that were required for Oracle Linux gcc-toolset-13.

# Set Environment Variables
# Note: On Ubuntu, Postgres libraries are usually in standard paths or /usr/lib/postgresql/18/lib
ENV XDG_RUNTIME_DIR=/run/user/0 \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH \
    # pkg-config lookup paths
    # NO CC_/CXX_/AR_/CARGO_TARGET_*_LINKER HERE. Compiler config is all done in the Hermetic LLVM toolchain in MODULE.bazel.
    # The PKG_CONFIG_*_aarch64 and AARCH64_*_OPENSSL_* vars are gone with the arm64 cross
    # libraries they pointed at -- those paths no longer exist in this image, and openssl-sys
    # builds a vendored OpenSSL from source regardless (the `vendored` feature short-circuits
    # OPENSSL_DIR entirely).
    PKG_CONFIG_PATH=/usr/lib/postgresql/18/lib/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig


RUN mkdir -p /run/user/0 && chmod 700 /run/user/0

# Install syft for SBOM generation
ARG SYFT_VERSION=1.38.0
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | \
    sh -s -- -b /usr/local/bin v${SYFT_VERSION} \
    && syft version

# Install cosign for container signing/attestation
ARG COSIGN_VERSION=2.4.1
RUN curl -sSfL https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64 \
    -o /usr/local/bin/cosign \
    && chmod +x /usr/local/bin/cosign \
    && cosign version

# Force the legacy (x_tables) iptables backend for dockerd.
#
# Ubuntu 24.04 selects iptables-nft, but BuildBuddy's Firecracker guest kernel has no
# nf_tables support -- see the DOCKER_INSECURE_NO_IPTABLES_RAW comment in goinit, which
# applies that workaround only on non-amd64 because their amd64 image already avoids nft.
# On the nft backend dockerd cannot program the bridge, so it never starts serving
# /var/run/docker.sock and the guest's `docker ps` readiness poll spins until BuildBuddy
# gives up with "docker init timed out after 30s".
#
# This cannot be fixed through /etc/docker/daemon.json: the guest init overwrites that
# file from MMDS on every boot, so the backend has to be baked into the image.
#
# Kept late in the file deliberately: it depends only on the `iptables` package from the
# first layer, and placing it here avoids invalidating the expensive rustup/bpf-linker
# layer on rebuild.
RUN update-alternatives --set iptables /usr/sbin/iptables-legacy \
    && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy

# Assert the switch took, so a silent alternatives change cannot reintroduce the 30s
# timeout, which surfaces far from its cause. Check the backend iptables reports
# ("v1.8.10 (legacy)"
RUN iptables --version | grep -q '(legacy)' \
    && ip6tables --version | grep -q '(legacy)'

# Assert that docker works.
RUN docker --version && dockerd --version \
    && test -x /usr/bin/docker && test -x /usr/bin/dockerd

# Set up work directory
RUN mkdir -p /workspace

WORKDIR /workspace

# Important: Do not set ENTRYPOINT or CMD as BuildBuddy will provide commands
