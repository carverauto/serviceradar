# The last image to go multi-arch, and the one that needed real work rather than a base
# image. Three packages in its closure resolved an architecture from the build host:
# ex_dtls and ex_libsrt were pinned to the executor's gcc because pkg-config gave them no
# OpenSSL directories (//third_party/openssl is the sysroot that replaced that), and vix
# loads its own NIF during `mix compile`, so it needs the executor's artefact to build and
# the target's to ship (_HOST_NIF_APPS in //build:mix_app.bzl). The ten precompiled Membrane
# OS deps were the fourth, fixed in Bundlex itself.
declare_multiarch_image_index(
    name = "core_elx_image_multiarch",
    image = ":core_elx_image_amd64",
)

# elixir agent-gateway -------------------------------------------------------

# The two OpenSSL debs the gateway overlays, selected per target architecture.
#
# Aliases rather than a select on `deb_packages` directly: that macro builds its genrule command
# by string-formatting $(location) for each package at LOADING time, where a select is not
# iterable. Wrapping each label keeps the list static and defers the choice to analysis, which
# is the same device :agent_netprobe uses for the netprobe binary.
alias(
    name = "agent_gateway_openssl_deb",
    actual = select({
        "//build/platforms:target_linux_arm64": "@debian_openssl_arm64_deb//file",
        "//conditions:default": "@debian_openssl_amd64_deb//file",
    }),
)

alias(
    name = "agent_gateway_libssl3_deb",
    actual = select({
        "//build/platforms:target_linux_arm64": "@debian_libssl3_arm64_deb//file",
        "//conditions:default": "@debian_libssl3_amd64_deb//file",
    }),
)

# First Elixir image to go multi-arch. The release itself was the hard part and is solved
# upstream of here: //elixir/serviceradar_agent_gateway:release_tar embeds an arm64 ERTS and
# arm64 OTP applications via include_erts, so this file only has to stop pinning the two
# amd64-only layers wrapped around it -- the base and the OpenSSL debs.
declare_elixir_release_container_with_debs_amd64(
    name = "agent_gateway_image_amd64",
    base = select({
        "//build/platforms:target_linux_arm64": "@ubuntu_noble_linux_arm64_v8//:ubuntu_noble_linux_arm64_v8",
        "//conditions:default": "@ubuntu_noble_linux_amd64//:ubuntu_noble_linux_amd64",
    }),
    cmd = ["start"],
    deb_packages = [
        ":agent_gateway_openssl_deb",
        ":agent_gateway_libssl3_deb",
    ],
    entrypoint = ["/app/bin/serviceradar_agent_gateway"],
    env = {
        "HOME": "/app",
        "PATH": "/app/bin:/usr/local/bin:/usr/bin:/bin",
        "MIX_ENV": "prod",
    },
    image_title = "serviceradar-agent-gateway",
    local_repo_tag = "registry.carverauto.dev/serviceradar/serviceradar-agent-gateway:local",
    release_tar = "//elixir/serviceradar_agent_gateway:release_tar",
    workdir = "/app",
)

declare_multiarch_image_index(
    name = "agent_gateway_image_multiarch",
    image = ":agent_gateway_image_amd64",
)

# The netprobe the agent image ships, selected per target architecture.
#
# //rust/netprobe:netprobe under the release platform is a glibc build, which is why this
# image used to carry the sgerrand alpine-pkg-glibc APK and a hand-made /lib64/ld-linux
# symlink. That APK is x86_64-only by design and has no aarch64 build in any release, so a
# glibc netprobe makes an arm64 agent image impossible. The musl filegroups below are static
# (asserted by //rust/netprobe:static_linkage_test for both architectures), which drops the
# glibc dependency entirely.
#
# An alias rather than a select() inside `files`, because there the label is the dict KEY.
alias(
    name = "agent_netprobe",
    actual = select({
        "//build/platforms:target_linux_arm64": "//rust/netprobe:netprobe_linux_aarch64_musl",
        "//conditions:default": "//rust/netprobe:netprobe_linux_x86_64_musl",
    }),
)

