# bun (React SSR) and cosign are third-party binaries baked into the web-ng image, so each
# needs its own arm64 pin. Aliases rather than a select() passed to the macro: both reach
# file_layer_amd64, which uses `src` as a dict KEY, and a select is unhashable at loading
# time. Same device as :agent_gateway_openssl_deb and :agent_netprobe.
alias(
    name = "web_ng_bun",
    actual = select({
        "//build/platforms:target_linux_arm64": "@bun_linux_aarch64//:bun",
        "//conditions:default": "@bun_linux_amd64//:bun",
    }),
)

alias(
    name = "web_ng_cosign",
    actual = select({
        "//build/platforms:target_linux_arm64": "@cosign_linux_arm64//file",
        "//conditions:default": "@cosign_linux_amd64//file",
    }),
)

declare_web_ng_release_container_amd64(
    name = "web_ng_image_amd64",
    base = select({
        "//build/platforms:target_linux_arm64": "@ubuntu_noble_linux_arm64_v8//:ubuntu_noble_linux_arm64_v8",
        "//conditions:default": "@ubuntu_noble_linux_amd64//:ubuntu_noble_linux_amd64",
    }),
    base_image_name = "web_ng_image_base_amd64",
    bun_src = ":web_ng_bun",
    cmd = ["start"],
    cosign_src = ":web_ng_cosign",
    env = {
        "HOME": "/app",
        "PATH": "/app/bin:/usr/local/bin:/usr/bin:/bin",
        "PHX_SERVER": "true",
        "MIX_ENV": "prod",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    },
    exposed_ports = ["4000/tcp"],
    extra_tars = [
        ":sshca_signer_layer_amd64",
    ],
    image_title = "serviceradar-web-ng",
    local_repo_tag = "registry.carverauto.dev/serviceradar/serviceradar-web-ng:local",
    release_tar = "//elixir/web-ng:release_tar",
    target_compatible_with = [],
    workdir = "/app",
)

# The first Elixir image in the index, and the one that forced //build:mix_app.bzl to learn
# the target triple. Every architecture-keyed artefact in this release used to be resolved
# from the BUILD HOST: adbc and lazy_html downloaded a prebuilt keyed on
# `:erlang.system_info(:system_architecture)`, and mdex_native did the same through
# rustler_precompiled -- so an arm64 image shipped x86-64 .so files that failed to dlopen at
# runtime with a misleading ENOENT. mix_app now exports TARGET_ARCH/VENDOR/OS/ABI, stages
# //third_party/precompiled_nifs as a declared input, and asserts every emitted .so matches
# the target's ELF e_machine before the action can succeed.
declare_multiarch_image_index(
    name = "web_ng_image_multiarch",
    image = ":web_ng_image_amd64",
)

