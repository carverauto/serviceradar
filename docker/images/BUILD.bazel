# --- Multi-arch verification -------------------------------------------------
#
# Asserts that each index below carries a genuinely native binary per advertised platform.
# Declaring the index targets is not sufficient on its own: an image whose base or rootfs is
# pinned to one architecture still produces an index with two entries, and the arm64 half is
# then our aarch64 binaries on an x86-64 userland, labelled amd64. That state built cleanly
# and nothing in the graph objected, which is why this is a test rather than a review note.
_MULTIARCH_INDEXES = [
    "agent_gateway_image_multiarch",
    "agent_image_multiarch",
    "bmp_collector_image_multiarch",
    "cert_generator_image_multiarch",
    "config_updater_image_multiarch",
    "core_elx_image_multiarch",
    "datasvc_image_multiarch",
    "faker_image_multiarch",
    "flow_collector_image_multiarch",
    "k8s_inventory_image_multiarch",
    "log_collector_image_multiarch",
    "rperf_client_image_multiarch",
    "tools_image_multiarch",
    "trapd_image_multiarch",
    "trivy_sidecar_image_multiarch",
    "web_ng_image_multiarch",
]

go_test(
    name = "multiarch_index_test",
    size = "enormous",
    srcs = ["multiarch_index_test.go"],
    data = [":{}".format(idx) for idx in _MULTIARCH_INDEXES],
    env = {
        "MULTIARCH_INDEXES": ",".join(_MULTIARCH_INDEXES),
    } | {
        idx: "$(rootpath :{})".format(idx)
        for idx in _MULTIARCH_INDEXES
    },
    target_compatible_with = ["@platforms//os:linux"],
)
