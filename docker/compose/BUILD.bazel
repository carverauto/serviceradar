"""Expose compose assets to Bazel targets."""

load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "compose_analytics_profile_test",
    size = "small",
    srcs = ["compose_analytics_profile_test.py"],
    data = [
        "analytics-head-init.sql",
        "//:docker-compose.yml",
    ],
)

exports_files(
    glob(
        [
            "entrypoint-*.sh",
            "*.conf",
            "*.docker.json",
            "*.docker.toml",
            "*.mtls.json",
            "*.sh",
            "*.ts",
            "*.rs",
        ],
        allow_empty = True,
        exclude = ["Dockerfile.*"],
    ),
)

exports_files([
    "tools-profile.sh",
    "tools-entrypoint.sh",
    "tools-motd.txt",
])
