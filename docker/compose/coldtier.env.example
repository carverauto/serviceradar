# Cold-tier enablement for the compose core-elx service (DEV TOOLING).
# OpenSpec add-tiered-telemetry-offload — design D11: the cold tier is opt-in
# only; the default compose stack must never see these variables.
#
# Usage:
#   1. cp docker/compose/coldtier.env.example docker/compose/coldtier.env
#   2. Create a docker-compose.override.yml next to docker-compose.yml:
#        services:
#          core-elx:
#            env_file:
#              - ./docker/compose/coldtier.env
#   3. docker compose --profile coldtier up -d
#
# Variable names are the exact ones consumed by the ServiceRadar.ColdTier
# block in elixir/serviceradar_core/config/runtime.exs. All *_PASSWORD /
# *_KEY vars also accept a <NAME>_FILE variant pointing at a mounted file.

SERVICERADAR_COLD_TIER_ENABLED=true

# --- Object store (compose `minio` service, profile coldtier) ---------------
# Endpoint is the in-network address as seen from core-elx AND from the head's
# DuckDB httpfs: host:port, no scheme. MinIO needs path-style URLs and speaks
# plain HTTP in this stack.
SERVICERADAR_COLD_TIER_BUCKET_URL=s3://serviceradar-cold
SERVICERADAR_COLD_TIER_S3_ENDPOINT=minio:9000
SERVICERADAR_COLD_TIER_S3_REGION=us-east-1
SERVICERADAR_COLD_TIER_S3_URL_STYLE=path
SERVICERADAR_COLD_TIER_S3_USE_SSL=false
# Must match SR_COLDTIER_MINIO_USER / SR_COLDTIER_MINIO_PASSWORD (compose
# defaults shown).
SERVICERADAR_COLD_TIER_S3_ACCESS_KEY_ID=serviceradar
SERVICERADAR_COLD_TIER_S3_SECRET_ACCESS_KEY=serviceradarcold

# --- Analytics head (compose `cold-head` service, profile coldtier) ---------
# Must match SR_COLDTIER_HEAD_USER / SR_COLDTIER_HEAD_PASSWORD /
# SR_COLDTIER_HEAD_DATABASE (compose defaults shown).
SERVICERADAR_COLD_TIER_HEAD_HOST=cold-head
SERVICERADAR_COLD_TIER_HEAD_PORT=5432
SERVICERADAR_COLD_TIER_HEAD_DATABASE=serviceradar
SERVICERADAR_COLD_TIER_HEAD_USERNAME=serviceradar
SERVICERADAR_COLD_TIER_HEAD_PASSWORD=serviceradarcoldhead

# --- Primary, as seen FROM the head (postgres_fdw hot branch + exports) -----
# The head dials the compose CNPG service by its network alias `cnpg`.
SERVICERADAR_COLD_TIER_PRIMARY_HOST=cnpg
SERVICERADAR_COLD_TIER_PRIMARY_PORT=5432
SERVICERADAR_COLD_TIER_PRIMARY_DATABASE=serviceradar
# The design's read-only role is `cold_reader` (SELECT-only on registry
# tables + manifest; CONNECTION LIMIT 2-4). For quick local hacking you can
# reuse the app user instead: username `serviceradar`, password from
#   docker compose exec cnpg cat /etc/serviceradar/cnpg/serviceradar-password
# NOTE: the compose primary's pg_hba.conf enforces hostssl +
# clientcert=verify-full, so the FDW SERVER options on the head must carry
# sslmode/sslrootcert/sslcert/sslkey pointing at the cert-data mount
# (/etc/serviceradar/certs in the cold-head container).
SERVICERADAR_COLD_TIER_PRIMARY_FDW_USERNAME=cold_reader
SERVICERADAR_COLD_TIER_PRIMARY_FDW_PASSWORD=change-me

# --- Optional tuning (defaults in runtime.exs) -------------------------------
#SERVICERADAR_COLD_EXPORT_LAG_HOURS=48
#SERVICERADAR_COLD_QUARANTINE_ATTEMPTS=5
#SERVICERADAR_COLD_RUN_CHUNK_BUDGET=24
#SERVICERADAR_COLD_WINDOW_LOGS_DAYS=365
#SERVICERADAR_COLD_WINDOW_TRACES_DAYS=365
#SERVICERADAR_COLD_WINDOW_OTEL_METRICS_DAYS=365
#SERVICERADAR_COLD_WINDOW_OTEL_METRIC_POINTS_DAYS=365
#SERVICERADAR_COLD_WINDOW_TIMESERIES_DAYS=365
#SERVICERADAR_COLD_WINDOW_EVENTS_DAYS=365
#SERVICERADAR_COLD_WINDOW_FLOWS_DAYS=365

# Primary volume capacity for the disk-pressure monitor. In Helm this is
# projected from cnpg.storageSize as SERVICERADAR_CNPG_STORAGE_SIZE; in
# compose the CNPG PVC has no fixed declared size, so set an explicit byte
# budget here or the 70/85/95% pressure alerts cannot fire (review F34).
#SERVICERADAR_COLD_TIER_PRIMARY_VOLUME_BYTES=64424509440
