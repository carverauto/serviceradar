# Analytics-store enablement for compose core-elx / web-ng (DEV TOOLING).
# OpenSpec add-analytics-store-drivers. Default compose stays timescale;
# this file is opt-in.
#
# Usage:
#   1. cp docker/compose/analytics.env.example docker/compose/analytics.env
#   2. docker-compose.override.yml:
#        services:
#          core-elx:
#            env_file: [./docker/compose/analytics.env]
#            environment:
#              SERVICERADAR_ANALYTICS_STORE_DRIVER: hybrid
#          web-ng:
#            env_file: [./docker/compose/analytics.env]
#            environment:
#              SERVICERADAR_ANALYTICS_STORE_DRIVER: hybrid
#   3. S3:        docker compose --profile analytics up -d
#      filesystem: docker compose --profile analytics-fs up -d
#
# Do not mix this bucket with CNPG barman backups.

SERVICERADAR_ANALYTICS_STORE_DRIVER=hybrid
SERVICERADAR_ANALYTICS_STORE_TABLES=timeseries_metrics
SERVICERADAR_ANALYTICS_STORE_HOT_WINDOW_DAYS=30
# Optional archive expiry; blank retains Parquet until explicitly configured.
SERVICERADAR_ANALYTICS_STORE_PARQUET_RETENTION_DAYS=

# --- S3 (profile `analytics`, compose `minio`) --------------------------------
SERVICERADAR_ANALYTICS_STORE_STORAGE=s3
SERVICERADAR_ANALYTICS_STORE_S3_BUCKET_URL=s3://serviceradar-analytics
SERVICERADAR_ANALYTICS_STORE_S3_ENDPOINT=minio:9000
SERVICERADAR_ANALYTICS_STORE_S3_REGION=us-east-1
SERVICERADAR_ANALYTICS_STORE_S3_URL_STYLE=path
SERVICERADAR_ANALYTICS_STORE_S3_USE_SSL=false
SERVICERADAR_ANALYTICS_STORE_S3_ACCESS_KEY_ID=serviceradar
SERVICERADAR_ANALYTICS_STORE_S3_SECRET_ACCESS_KEY=serviceradaranalytics

# --- Head (compose `analytics-head` / `analytics-head-fs`) --------------------
SERVICERADAR_ANALYTICS_STORE_HEAD_HOST=analytics-head
SERVICERADAR_ANALYTICS_STORE_HEAD_PORT=5432
SERVICERADAR_ANALYTICS_STORE_HEAD_DATABASE=serviceradar
SERVICERADAR_ANALYTICS_STORE_HEAD_USERNAME=serviceradar
SERVICERADAR_ANALYTICS_STORE_HEAD_PASSWORD=serviceradaranalytics
SERVICERADAR_ANALYTICS_STORE_POOL_SIZE=4

# --- Filesystem (profile `analytics-fs` only; comment S3 block above) ---------
# SERVICERADAR_ANALYTICS_STORE_STORAGE=filesystem
# SERVICERADAR_ANALYTICS_STORE_FILESYSTEM_PATH=/var/lib/serviceradar/analytics
