# Multi-stage build to include ServiceRadar CLI
FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o srctl ./go/cmd/cli

# Runtime stage
FROM alpine:3.20

# Install runtime dependencies
RUN apk add --no-cache jq openssl

# Copy the CLI binary (plus deprecated serviceradar-cli symlink)
COPY --from=builder /src/srctl /usr/local/bin/srctl
RUN chmod +x /usr/local/bin/srctl \
    && ln -s srctl /usr/local/bin/serviceradar-cli

COPY docker/compose/update-config.sh /update-config.sh
RUN chmod +x /update-config.sh

CMD ["/update-config.sh"]