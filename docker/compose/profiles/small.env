# JetStream sizing profile: small (the default).
#
# Selected by SERVICERADAR_NATS_PROFILE (small, medium or large) and loaded
# through `env_file` by every Compose service that sizes a JetStream stream,
# KV bucket or object store, and by NATS itself. Every size is explicit so the
# budget below is exactly what the services reserve.
#
# Compose runs one NATS server, so every stream reserves its full max_bytes on
# it. The sum of every counted size MUST stay at or below 85% of
# max_file_store; //go/pkg/nats/jetstreambudget:jetstreambudget_test enforces
# that for each profile. The EventWriter fallbacks are not counted: they are
# never larger than the collector sizes they stand in for.
#
# max_file_store is a reservation ceiling, not an allocation: the Docker host
# needs at least this much free disk for the nats-data volume.
#
# Sizes are bytes (1 GiB = 1073741824). To change one size for one service, set
# the variable in that service's `environment`, which takes precedence over
# this file.

# NATS server: jetstream.max_file_store (NATS size syntax, G = 10^9 bytes).
SERVICERADAR_NATS_MAX_FILE_STORE=30G

# datasvc: KV bucket and object store.
SERVICERADAR_JS_KV_SERVICERADAR_DATASVC_MAX_BYTES=1073741824
SERVICERADAR_JS_KV_SERVICERADAR_DATASVC_REPLICAS=1
SERVICERADAR_JS_OBJ_SERVICERADAR_OBJECTS_MAX_BYTES=4294967296
SERVICERADAR_JS_OBJ_SERVICERADAR_OBJECTS_REPLICAS=1

# otel log-collector: events.
SERVICERADAR_JS_EVENTS_MAX_BYTES=2147483648
SERVICERADAR_JS_EVENTS_REPLICAS=1

# flow-collector: flows.
SERVICERADAR_JS_FLOWS_MAX_BYTES=3221225472
SERVICERADAR_JS_FLOWS_REPLICAS=1

# bmp-collector: ARANCINI_CAUSAL.
SERVICERADAR_JS_ARANCINI_CAUSAL_MAX_BYTES=2147483648
SERVICERADAR_JS_ARANCINI_CAUSAL_REPLICAS=1

# core EventWriter: streams it owns (one replica each).
SERVICERADAR_JS_METRICS_MAX_BYTES=1073741824
SERVICERADAR_JS_K8S_INVENTORY_MAX_BYTES=1073741824
SERVICERADAR_JS_ANALYTICS_PREDICTIONS_MAX_BYTES=1073741824
SERVICERADAR_JS_MTR_RESULTS_MAX_BYTES=1073741824
SERVICERADAR_JS_SCAN_RESULTS_MAX_BYTES=268435456
SERVICERADAR_JS_TRIVY_REPORTS_MAX_BYTES=1073741824

# core EventWriter: fallback shape of the shared streams, used only while no
# collector has claimed the stream. Not counted in the budget.
SERVICERADAR_JS_EVENTS_FALLBACK_MAX_BYTES=2147483648
SERVICERADAR_JS_EVENTS_FALLBACK_REPLICAS=1
SERVICERADAR_JS_FLOWS_FALLBACK_MAX_BYTES=1073741824
SERVICERADAR_JS_FLOWS_FALLBACK_REPLICAS=1
SERVICERADAR_JS_ARANCINI_CAUSAL_FALLBACK_MAX_BYTES=1073741824
SERVICERADAR_JS_ARANCINI_CAUSAL_FALLBACK_REPLICAS=1

# core notifications: NOTIFICATIONS.
SERVICERADAR_JS_NOTIFICATIONS_MAX_BYTES=1073741824

# core: threat-intel raw payload object store.
SERVICERADAR_OTX_RAW_MAX_BUCKET_BYTES=1073741824

# web-ng: plugin object store and fieldsurvey object store.
PLUGIN_STORAGE_JS_MAX_BUCKET_BYTES=2147483648
PLUGIN_STORAGE_JS_REPLICAS=1
FIELD_SURVEY_JS_MAX_BUCKET_BYTES=1073741824
