# gazelle:ignore

load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

# The reference implementation of //config/SEMANTICS.md. Kept separate from the generated
# types so a schema change and an engine change cannot arrive in one indistinguishable diff.
rust_library(
    name = "validator",
    srcs = [
        "src/credentials.rs",
        "src/lib.rs",
        "src/text.rs",
    ],
    crate_name = "serviceradar_config_validator",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + ["//config/proto_bindings/rust:config_schema"],
)

# The gate. Inputs are the COMPILED binaries because that is what a runtime loads; validating
# the .textproto sources would be checking a different artifact.
rust_test(
    name = "file_phase_test",
    srcs = ["src/file_phase_test.rs"],
    crate_root = "src/file_phase_test.rs",
    data = [
        "//config/environments:ci_binpb",
        "//config/environments:demo_binpb",
        "//config/environments:localhost_binpb",
        "//config/environments:saas_binpb",
        "//config/rules:ruleset_binpb",
    ],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        ":validator",
        "//config/proto_bindings/rust:config_schema",
    ],
)

# The committed source and the canonical text of the binary built from it. Both are declared
# inputs; the point of the test is that they are read from different places.
rust_test(
    name = "round_trip_test",
    srcs = [
        "src/round_trip_test.rs",
        "src/utils_tests.rs",
    ],
    crate_root = "src/round_trip_test.rs",
    data = [
        "//config/environments:ci.textproto",
        "//config/environments:ci_canonical",
        "//config/environments:demo.textproto",
        "//config/environments:demo_canonical",
        "//config/environments:localhost.textproto",
        "//config/environments:localhost_canonical",
        "//config/environments:saas.textproto",
        "//config/environments:saas_canonical",
    ],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [":validator"],
)

rust_test(
    name = "credential_shape_test",
    srcs = [
        "src/credential_shape_test.rs",
        "src/utils_tests.rs",
    ],
    crate_root = "src/credential_shape_test.rs",
    data = [
        "//config/environments:ci_canonical",
        "//config/environments:demo_canonical",
        "//config/environments:localhost_canonical",
        "//config/environments:saas_canonical",
    ],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [":validator"],
)
