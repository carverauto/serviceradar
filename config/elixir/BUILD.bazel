# gazelle:ignore

load("@rules_elixir//:elixir_library.bzl", "elixir_library")
load("@rules_elixir//:elixir_tests.bzl", "ex_unit_tests")

# The Elixir implementation of //config/SEMANTICS.md, and the third consumer of the shared
# conformance vectors. Decision 9 requires it to be callable from config/runtime.exs, before the
# application tree starts, so it depends on nothing but the generated schema modules.
elixir_library(
    name = "validator",
    app_name = "serviceradar_config_validator",
    srcs = glob(["lib/**/*.ex"]),
    visibility = ["//visibility:public"],
    deps = [
        "//config/proto:config_schema",
        "@hexpm//:protobuf",
        "@rules_elixir//elixir",
    ],
)

# BLOCKED, and deliberately excluded rather than left red: validator_vector_test.exs needs the
# compiled .binpb artifacts as `data`, and ex_unit_tests cannot stage a GENERATED data file.
# rules_elixir private/ex_unit_test.bzl:51 copies each input with `src = s.path`, which for a
# generated file is `bazel-out/<cfg>/bin/...` and does not exist relative to the test's working
# directory. Source files work only because `path == short_path` for them. The fix is
# `src = s.short_path` (and the same for `dst`); pinned commit is 832a95b4.
#
# The property tests below need no data and run today, so the Elixir engine IS covered; what is
# missing is the cross-language vector comparison. Restore by deleting the glob exclude and
# adding the //config/rules and //config/environments binpb targets to `data`.
ex_unit_tests(
    name = "unit_tests",
    srcs = glob(
        ["test/**/*_test.exs"],
        exclude = ["test/validator_vector_test.exs"],
    ),
    config_loader = "//build:elixir_test_config_loader.exs",
    data = ["test/support_paths.exs"],
    test_helper = "test/test_helper.exs",
    deps = [
        ":validator",
        "@hexpm//:stream_data",
    ],
)
