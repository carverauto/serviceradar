# ServiceRadar environment configuration: ci
#
# GROUND TRUTH. This file is authored and reviewed here; a build action compiles it to a
# binary message that every implementation loads. Do not edit the generated .binpb.
#
# NO SECRETS. Passwords, private keys and certificate material are resolved by
# SecretManager. A build-time check rejects credential-shaped values in this file.

kind: ENVIRONMENT_KIND_CI

database {
  # The fixture's PUBLISHED address, not its in-cluster one.
  #
  # This name has to resolve in the network namespace of the BUILD ACTION, and that namespace
  # does not serve cluster.local. Measured, in the run that failed: connecting to
  # srql-fixture-rw.srql-fixtures.svc.cluster.local returned EAI_NONAME ("Name or service not
  # known") while the same step fetched https://srql-fixture-ca.serviceradar.cloud over public
  # DNS. Its resolver answers for the internet and not for the cluster.
  #
  # Removing Firecracker did not change that and was never going to: `dockerNetwork: bridge`
  # gives the action its own namespace under OCI isolation too. The microVM was one reason the
  # namespace was isolated, not the reason it exists.
  #
  # srql-fixture-rw-ext (//k8s/srql-fixtures/services.yaml) is a MetalLB LoadBalancer on
  # 23.138.124.18:5432, published as this name by ExternalDNS. It is a SAN on
  # srql-fixture-server-tls, so verify-full holds against it with no server-name override.
  #
  # What this buys, exactly: the NAME resolves from anywhere, because it is in public DNS.
  # The ADDRESS is a MetalLB IP announced on the cluster's L2 -- reachable from the cluster and
  # the LAN, not from the open internet (//k8s/srql-fixtures/ca-bundle.yaml records the same
  # about :443 on this IP, which is why the CA bundle is published through the shared Envoy
  # gateway instead). The runner is inside the cluster, so a route was never what it lacked.
  # A workstation still needs SRQL_FIXTURE_HOST pointed at the LAN NodePort.
  #
  # THE RULE, which this file broke and //k8s/buildbuddy/values-workflows.yaml already states
  # for the cache endpoint: a CI path names an endpoint that does not depend on the runner's
  # network topology. It has now broken twice on that -- SRQL_FIXTURE_CA_URL named
  # srql-fixture-ca-incluster.srql-fixtures.svc.cluster.local, and this host.
  host: "srql-fixture.serviceradar.cloud"
  port: 5432
  database: "srql_fixture"

  # Identities. Only the password is secret.
  #
  # These are the roles the shared fixture actually has -- `srql` is the application role from
  # srql-test-db-credentials, `srql_hydra` the admin from srql-test-admin-credentials. An
  # earlier revision named `srql_test` for both, which exists on no fixture; PostgreSQL reports
  # that as `role "srql_test" does not exist`, which reads like a missing GRANT rather than a
  # name nothing ever created. Verify before changing:
  #
  #   kubectl get secret srql-test-db-credentials -n srql-fixtures -o jsonpath='{.data.username}' | base64 -d
  connecting_role: "srql"
  owning_role: "srql"

  # `srql` deliberately lacks CREATEDB, so the per-run database is created by the admin role.
  # Its password is database.admin_password.
  admin_role: "srql_hydra"

  # Typed, so it cannot go missing and silently degrade to a plaintext fallback.
  tls_mode: TLS_MODE_VERIFY_FULL

  # The fixture certificate carries DNS SANs and no IP SANs, so verification must be performed
  # against a name even when the connection is made by address. Equal to `host` here, and
  # deliberately still stated: a caller that reaches the fixture by NodePort or by the
  # in-cluster service overrides `host` and keeps a name the certificate actually carries.
  tls_server_name: "srql-fixture.serviceradar.cloud"

  # The cert-manager issuer behind the fixture, published by //k8s/srql-fixtures/ca-bundle.yaml.
  # Named rather than copied because the issuer rotates: a stored PEM is correct until it is
  # not, which is what a BuildBuddy SRQL_TEST_DATABASE_CA_CERT secret did.
  ca_bundle_url: "http://srql-fixture-ca-incluster.srql-fixtures.svc.cluster.local/ca.crt"

  search_path: "platform, ag_catalog"
  pool_size: 10
  queue_target_ms: 500
  queue_interval_ms: 1000
  ownership_timeout_ms: 60000
}

nats {
  url: "nats://nats.serviceradar.svc.cluster.local:4222"
  server_name: "nats"
}

core {
  address: "serviceradar-core:50052"
  api_url: "http://serviceradar-core:8090"
  security_mode: SECURITY_MODE_MTLS
  server_name: "serviceradar-core"
}

dgraph {
  # Deployed environments share one Dgraph cluster address for now; only localhost differs.
  host: "dgraph.serviceradar.svc.cluster.local"
  port: 9080
  tls_mode: DGRAPH_TLS_MODE_VERIFY_CA
}
