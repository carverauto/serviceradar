# gazelle:ignore

load("@rules_elixir//:elixir_library.bzl", "elixir_library")
load("@rules_elixir//:elixir_tests.bzl", "ex_unit_tests")

# ConfigManager, Elixir. Mirrors //config/manager_config/{rust,go}: the same one variable, the
# same source-from-kind mapping, the same identity check, and loading that validates.
#
# Decision 9 requires it to be callable from config/runtime.exs, before the application tree
# starts, so it depends on nothing but the generated schema modules and the validator.
elixir_library(
    name = "manager",
    app_name = "serviceradar_config_manager",
    srcs = glob(["lib/**/*.ex"]),
    visibility = ["//visibility:public"],
    deps = [
        "//config/proto:config_schema",
        "//config/validator/elixir:validator",
        "@hexpm//:protobuf",
        "@rules_elixir//elixir",
    ],
)

# The rule set these tests use is built in code rather than read from //config/rules: they are
# about what the manager DOES with a rule set, not about the committed one's contents. That the
# committed rules accept every committed instance is asserted by //config/validator/elixir.
ex_unit_tests(
    name = "unit_tests",
    srcs = glob(["test/**/*_test.exs"]),
    config_loader = "//build:elixir_test_config_loader.exs",
    data = ["test/support_fixtures.exs"],
    test_helper = "test/test_helper.exs",
    deps = [":manager"],
)
