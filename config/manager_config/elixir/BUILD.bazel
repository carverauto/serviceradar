# gazelle:ignore

load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_elixir//:elixir_library.bzl", "elixir_library")
load("@rules_elixir//:elixir_tests.bzl", "ex_unit_tests")
load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")

# ConfigManager, Elixir. Mirrors //config/manager_config/{rust,go}: the same one variable, the
# same source-from-kind mapping, the same identity check, and loading that validates.
#
# Decision 9 requires it to be callable from config/runtime.exs, before the application tree
# starts, so it depends on nothing but the generated schema modules and the validator.
elixir_library(
    name = "manager",
    app_name = "serviceradar_config_manager",
    srcs = glob(["lib/**/*.ex"]),
    # The embedded rule set, read at COMPILE time by ServiceradarConfig.Rules so a release
    # carries no runtime dependency on the file. :ruleset_drift_test keeps it byte-identical to
    # protoc's output for //config/rules:ruleset.textproto.
    data = ["priv/ruleset.binpb"],
    visibility = ["//visibility:public"],
    deps = [
        "//config/proto:config_schema",
        "//config/manager_validator/elixir:validator",
        "@hexpm//:protobuf",
        "@rules_elixir//elixir",
    ],
)

# The rule set these tests use is built in code rather than read from //config/rules: they are
# about what the manager DOES with a rule set, not about the committed one's contents. That the
# committed rules accept every committed instance is asserted by //config/manager_validator/elixir.
ex_unit_tests(
    name = "unit_tests",
    srcs = glob(["test/**/*_test.exs"]),
    config_loader = "//build:elixir_test_config_loader.exs",
    data = ["test/support_fixtures.exs"],
    test_helper = "test/test_helper.exs",
    deps = [":manager"],
)

# The embedded copy must equal protoc's output for the committed textproto. Same pattern and same
# reason as //config/proto:binding_drift_*_test.
diff_test(
    name = "ruleset_drift_test",
    file1 = "//config/rules:ruleset_binpb",
    file2 = "priv/ruleset.binpb",
)

# Write-back for the committed copies of generated artifacts.
#
# The copies exist so `go build` / `mix` reach them without Bazel, and the diff test beside them
# makes the two impossible to disagree. Refreshing them is THIS target's job: nobody reaches into
# bazel-out, which is a per-configuration path the tree deliberately hides (//.bazelrc sets
# --experimental_convenience_symlinks=clean), so any absolute path found by hand encodes the
# platform and compilation mode it happened to be built with.
#
#     bazel run //config/manager_config/elixir:update_ruleset
write_source_files(
    name = "update_ruleset",
    files = {"priv/ruleset.binpb": "//config/rules:ruleset_binpb"},
)
