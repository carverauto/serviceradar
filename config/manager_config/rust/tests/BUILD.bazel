load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The whole test surface in one target, matching what `cargo test` runs.
#
# `package_name` is required on every all_crate_deps(cargo_only = True) call here: it otherwise
# resolves against the package it is called from, and there is no Cargo.toml at
# config/manager_config/rust/tests.
#
# The tests/ tree mirrors src/ and every module is registered from lib_tests.rs, so this single
# target covers the tree and a file cannot be added without being wired in. Under cargo, the same
# lib_tests.rs is picked up automatically as an integration test, so the two builds run the same
# 26 tests rather than each having their own idea of the suite.
rust_test(
    name = "manager_integration_test",
    srcs = glob(["**/*.rs"]),
    crate_root = "lib_tests.rs",
    edition = "2024",
    deps = all_crate_deps(
        package_name = "config/manager_config/rust",
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [
        "//config/manager_config/rust:manager",
        "//config/proto_bindings/rust:config_schema",
    ],
)
