# gazelle:ignore

load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "bazel-*",
        ],
    ),
    visibility = ["//visibility:public"],
)

# ConfigManager. Loading and validation are one operation on purpose: there is no entry point
# that returns a value without having checked it (Decision 12).
rust_library(
    name = "manager",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "serviceradar_config_manager",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//config/proto_bindings/rust:config_schema",
        "//config/manager_validator/rust:validator",
    ],
)
