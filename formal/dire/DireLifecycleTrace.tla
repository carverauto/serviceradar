------------------------- MODULE DireLifecycleTrace -------------------------
(***************************************************************************)
(* Trace validation for DireLifecycle. A trace module (formal/dire/traces,  *)
(* generated by ServiceRadar.DireLifecycleTrace from an integration test    *)
(* that drives the real code) EXTENDS this module and defines TheLog: the   *)
(* full model state after every step. TraceNext pins every variable to the  *)
(* next logged state and requires the model's Next to allow that transition.*)
(*                                                                          *)
(* A matched trace reaches its last state, which violates TraceIncomplete;  *)
(* its tlc_test therefore expects violation:TraceIncomplete. A trace the    *)
(* model does not allow stops early with no violation, and the test fails.  *)
(***************************************************************************)
EXTENDS DireLifecycle, TLC

CONSTANT TraceLog

VARIABLE ti

traceVars == <<vars, ti>>

Logged(i) ==
    /\ status = TraceLog[i].status
    /\ reason = TraceLog[i].reason
    /\ owner = TraceLog[i].owner
    /\ ipOf = TraceLog[i].ipOf
    /\ audit = TraceLog[i].audit
    /\ work = TraceLog[i].work
    /\ act = TraceLog[i].act

LoggedNext(i) ==
    /\ status' = TraceLog[i].status
    /\ reason' = TraceLog[i].reason
    /\ owner' = TraceLog[i].owner
    /\ ipOf' = TraceLog[i].ipOf
    /\ audit' = TraceLog[i].audit
    /\ work' = TraceLog[i].work
    /\ act' = TraceLog[i].act

TraceInit ==
    /\ ti = 1
    /\ Init
    /\ Logged(1)

TraceNext ==
    /\ ti < Len(TraceLog)
    /\ ti' = ti + 1
    /\ LoggedNext(ti + 1)
    /\ Next

TraceIncomplete == ti < Len(TraceLog)

=============================================================================
