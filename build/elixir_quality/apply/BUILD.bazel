load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "apply_lib",
    srcs = ["main.go"],
    importpath = "github.com/carverauto/serviceradar/build/elixir_quality/apply",
    visibility = ["//visibility:private"],
)

# Pure Go, so it cross-compiles on the Linux executors for whatever machine runs `bazel run`.
go_binary(
    name = "apply",
    embed = [":apply_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "apply_test",
    srcs = ["main_test.go"],
    embed = [":apply_lib"],
)
