# Platform definitions for ServiceRadar multi-arch builds
#
# NAMED BY CPU (x86_64/aarch64), NOT BY GOARCH (amd64/arm64), AND THAT IS NOT A STYLE CHOICE.
#
# //.bazelrc sets --experimental_platform_in_output_dir, which derives the output directory
# from the platform's NAME. rules_go ships @rules_go//go/toolchain:linux_amd64 and
# :linux_arm64, so a platform of ours by the same name puts two genuinely different
# configurations in one bazel-out directory. Bazel reports that as hundreds of lines of
#
#   ERROR: file 'external/llvm++llvm+llvm-project/libcxx/_objs/libcxx/random.pic.o'
#          is generated by these conflicting actions:
#          ... Configuration: 80858a22..., 0f7e5357...
#
# whose only difference is `platforms: [//build/platforms:linux_amd64],
# [@@rules_go+//go/toolchain:linux_amd64]`. It stayed hidden while nothing built the LLVM
# runtimes from source under both; the NIFs asking for a static C++ runtime is what made
# both configurations want @llvm//libcxx.
#
# The musl platforms below were already named this way, so this also makes the set
# consistent. Any new platform here must not collide with a dependency's.

# This setting no longer decides cc toolchain resolution -- hermetic-llvm reads libc off the
# target platform via @llvm//constraints/libc, so there is one compiler and nothing to race.
# It survives because the `target_linux_*_musl` config_settings below are what //rust/netprobe
# selects its aya/procfs deps and its link flags on.
#
# THE DEFAULT IS STILL LOAD-BEARING, and its absence was a real bug worth recording. A
# constraint_setting with no default leaves platforms that never mention it with NO value for
# it -- and a toolchain that says nothing about libc then matches BOTH glibc and musl
# platforms, because a platform carrying EXTRA constraints still satisfies a toolchain asking
# for fewer. That is how :linux_x86_64_musl matched the old //build/toolchains:rbe_cc_toolchain
# (x86_64, linux), linked the "musl" build against @buildbuddy_toolchain's glibc, and left
# which one won down to registration order rather than to anything declared.
constraint_setting(
    name = "linux_libc",
    default_constraint_value = ":linux_glibc",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "linux_musl",
    constraint_setting = ":linux_libc",
    visibility = ["//visibility:public"],
)

# Every platform that does not say otherwise. Never write this into a platform's
# constraint_values -- it is the default, so it applies automatically; naming it is only useful
# on a TOOLCHAIN, to declare "glibc only" and stop it matching musl platforms.
constraint_value(
    name = "linux_glibc",
    constraint_setting = ":linux_libc",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_linux_x86_64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":linux_musl",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_linux_aarch64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":linux_musl",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    visibility = ["//visibility:public"],
)

# THREE libc-ish constraints, because two rulesets each own one and they are NOT
# interchangeable. Dropping any one of them produces a build that looks fine and is wrong.
#
#   @llvm//constraints/libc:musl              picks the musl C toolchain
#   @rules_rs//rs/platforms/constraints:musl  picks the musl RUST toolchain
#   :linux_musl                               our own; drives the target_linux_*_musl
#                                             config_settings //rust/netprobe selects on
#
# hermetic-llvm has no musl toolchain to select: it declares one cc toolchain per (exec,
# target) pair, all constrained on cpu and os alone, and reads libc off the TARGET platform.
# rules_rs does the same for Rust but through its OWN constraint_setting, which defaults to
# glibc. Carrying only the LLVM value therefore linked a musl binary against the
# x86_64-unknown-linux-gnu libstd, and ld.lld reported it as undefined open64/fstat64/
# lseek64/stat64/mmap64/readdir64 -- glibc LFS symbols musl does not define. That is the same
# failure shape as the toolchain race documented on :linux_libc above, one layer up.
#
# pie:off is required because rustc forces -no-pie on musl targets.
platform(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":linux_musl",
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
        "@rules_rs//rs/platforms/constraints:musl",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_aarch64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":linux_musl",
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
        "@rules_rs//rs/platforms/constraints:musl",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "darwin_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "darwin_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    visibility = ["//visibility:public"],
)

# No `linux_pkg_local` platform. It existed to force RPM packaging into its own target
# platform by carrying `@rules_pkg//pkg:not_compatible` -- satisfying, rather than passing, the
# compatibility gate on rules_pkg's LEGACY make_rpm binary. That gate never applied here:
# //build/packaging/package_rules.bzl passes `srcs=` to pkg_rpm, which selects pkg_rpm_pfg, the
# toolchain-based implementation. The rpm targets are simply
# `target_compatible_with = ["@platforms//os:linux"]`, which //build/rbe:rbe_platform satisfies.
#
# Its only user was the release workflow, where `--platforms` OVERRODE the
# rbe_platform that --config=ci sets, giving the packaging step a private configuration: every
# binary shared with the container images was built twice per release, and the .rpm shipped a
# DIFFERENT build of the agent than the image did. Verified before removal by building both
# ways -- the binaries differ only in 14 embedded `bazel-out/<platform>-opt/...` path strings
# (an artifact of --experimental_platform_in_output_dir) and in nothing else.

# No `rbe_linux_amd64` / `rbe_linux_arm64`. The RBE platform is //build/rbe:rbe_platform, which
# is what //.bazelrc names in build:remote_base for --host_platform, --platforms and
# --extra_execution_platforms.
#
# The pair was live for eight days. b43a887d03 (2025-09-21) added them to the ROOT //BUILD.bazel
# and pointed build:remote at both, `--extra_execution_platforms=//:rbe_linux_amd64,
# //:rbe_linux_arm64` -- and the arm64 one was HONEST then: `Arch: arm64` against
# gcr.io/flame-public/rbe-ubuntu22-04, a real request for arm64 remote execution on BuildBuddy
# Cloud. d2bba552f2 (2025-09-29, "agent now building on remote executor and custom image")
# repointed the profile at our own executor image and dropped the --extra_execution_platforms
# line with no replacement. Nothing has named either target in the ~10.5 months since.
#
# They were maintained anyway, which is the part worth recording. 14ad8cb4c8 (2026-03-07)
# rewrote rbe_linux_arm64's `Arch: arm64` into `Arch: amd64` and added the comment
# "Cross-compiles linux/arm64 targets on the amd64 BuildBuddy executor pool" -- five months
# after the platform was already unreachable. No build ever executed that configuration, so the
# comment recorded an intention, not a tested route, while the declaration itself said an action
# runs on aarch64 hardware and should be dispatched to an amd64 executor. And both carried a
# copy of the rbe-executor tag, two of seven in the repo that have to move together; these two
# were the freshest of the set (v1.0.25.1 against v1.0.24.3 in k8s/buildbuddy/values.yaml)
# despite being the only two that could not affect a build.
#
# feb6ccfa56 (2026-08-09) removed the sibling `rbe_linux_el9` as an orphan and reasoned in its
# message about exactly this failure mode; that sweep was scoped by the string "el9", so these
# two -- six lines away in this file -- were never looked at.

platform(
    name = "darwin_exec",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)
