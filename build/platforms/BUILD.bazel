# Platform definitions for ServiceRadar multi-arch builds

# THE DEFAULT IS LOAD-BEARING, and its absence was a real bug.
#
# A constraint_setting with no default leaves platforms that never mention it with NO value for
# it -- and a toolchain that says nothing about libc then matches BOTH glibc and musl platforms.
# That is how //build/platforms:linux_x86_64_musl (x86_64, linux, linux_musl) matched
# //build/toolchains:rbe_cc_toolchain, which asks only for (x86_64, linux): a platform carrying
# EXTRA constraints still satisfies a toolchain asking for fewer. The "musl" build therefore
# linked with @buildbuddy_toolchain's glibc toolchain, and which one won came down to
# registration order rather than to anything declared.
#
# Giving the setting a default and an explicit :linux_glibc value makes the two mutually
# exclusive, so resolution is decided by the constraints instead of by list order. This mirrors
# rules_rust's own cross_compile_musl example, whose `linker` constraint_setting declares
# `default_constraint_value = ":unknown"` alongside `:musl` for exactly this reason.
constraint_setting(
    name = "linux_libc",
    default_constraint_value = ":linux_glibc",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "linux_musl",
    constraint_setting = ":linux_libc",
    visibility = ["//visibility:public"],
)

# Every platform that does not say otherwise. Never write this into a platform's
# constraint_values -- it is the default, so it applies automatically; naming it is only useful
# on a TOOLCHAIN, to declare "glibc only" and stop it matching musl platforms.
constraint_value(
    name = "linux_glibc",
    constraint_setting = ":linux_libc",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_linux_x86_64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":linux_musl",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_linux_aarch64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":linux_musl",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    visibility = ["//visibility:public"],
)

# EXPERIMENT: the two `@llvm//constraints/...` values below are for hermetic-llvm.
#
# They are inert for every toolchain registered in //MODULE.bazel -- none of those
# constrain on @llvm//constraints/libc:variant or :pie -- so the musl build is unchanged
# until a build opts in with --extra_toolchains=@llvm//toolchain:...
#
# They are needed because hermetic-llvm has no musl TOOLCHAIN. It declares one cc toolchain
# per (exec, target) pair and picks libc from the target platform, which is the structural
# fix for the resolution races documented on :linux_libc above. pie:off is required because
# rustc forces -no-pie on musl targets.
platform(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":linux_musl",
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_aarch64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":linux_musl",
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    visibility = ["//visibility:public"],
)

# No `linux_pkg_local` platform. It existed to force RPM packaging into its own target
# platform by carrying `@rules_pkg//pkg:not_compatible` -- satisfying, rather than passing, the
# compatibility gate on rules_pkg's LEGACY make_rpm binary. That gate never applied here:
# //build/packaging/package_rules.bzl passes `srcs=` to pkg_rpm, which selects pkg_rpm_pfg, the
# toolchain-based implementation. The rpm targets are simply
# `target_compatible_with = ["@platforms//os:linux"]`, which //build/rbe:rbe_platform satisfies.
#
# Its only user was //.forgejo/workflows/release.yml, where `--platforms` OVERRODE the
# rbe_platform that --config=ci sets, giving the packaging step a private configuration: every
# binary shared with the container images was built twice per release, and the .rpm shipped a
# DIFFERENT build of the agent than the image did. Verified before removal by building both
# ways -- the binaries differ only in 14 embedded `bazel-out/<platform>-opt/...` path strings
# (an artifact of --experimental_platform_in_output_dir) and in nothing else.

# Remote execution platforms for BuildBuddy
platform(
    name = "rbe_linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    exec_properties = {
        "container-image": "docker://registry.carverauto.dev/serviceradar/rbe-executor:v1.0.24.3",
        "OSFamily": "linux",
        "Arch": "amd64",
        "dockerNetwork": "host",
        "Pool": "default",
        # Firecracker microVM size (see #4752/#4755). Rustc+ld and pure-Go
        # GoLink need headroom above the historical ~2.5Gi default.
    },
    visibility = ["//visibility:public"],
)

platform(
    name = "rbe_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    exec_properties = {
        "container-image": "docker://registry.carverauto.dev/serviceradar/rbe-executor:v1.0.24.3",
        "OSFamily": "linux",
        # Cross-compiles linux/arm64 targets on the amd64 BuildBuddy executor pool.
        "Arch": "amd64",
        "dockerNetwork": "host",
        "Pool": "default",
    },
    visibility = ["//visibility:public"],
)

platform(
    name = "darwin_exec",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)
