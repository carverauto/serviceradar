genquery(
    name = "web_ng_db_target_query",
    # Every web-ng database target BazelCI runs in one invocation, and the target that
    # provisions their clones.
    expression = "tests(//elixir/web-ng:networks_live_db_test) + tests(//elixir/web-ng:topology_atlas_db_test) + //elixir/web-ng:plugin_config_cli_db_test + //rust/integration-db:provision_generation_web_ng",
    opts = ["--output=xml"],
    scope = [
        "//elixir/web-ng:networks_live_db_test",
        "//elixir/web-ng:plugin_config_cli_db_test",
        "//elixir/web-ng:topology_atlas_db_test",
        "//rust/integration-db:provision_generation_web_ng",
    ],
)

genquery(
    name = "web_ng_lane_target_query",
    # deps() of the suite, not a hardcoded pair of lanes. The suite lists every
    # ex_unit_test in //elixir/web-ng, so a manual target a workflow runs by
    # name still shows up in this query and its file counts as routed.
    expression = "kind(ex_unit_test, deps(//elixir/web-ng:web_ng_lane_scope))",
    opts = ["--output=xml"],
    scope = ["//elixir/web-ng:web_ng_lane_scope"],
)

