# Opt-in switch for tests that talk to the shared CNPG fixture.
#
# These tests run real DDL against a database several pull requests share. Nothing may run
# them by accident, and the guard must be visible at the target rather than buried in a
# .bazelrc nobody reads -- so it is declared per target as:
#
#     target_compatible_with = integration_test_only(),
#
# and enabled per invocation as:
#
#     bazel test //... --test_tag_filters=integration_test --//build:enable_integration_tests
#
# Without the flag those targets are INCOMPATIBLE: a wildcard skips them and says so, and
# naming one explicitly is a hard error that names the target. Compare `manual`, which
# silently vanished from wildcards and gave no hint why.
bool_flag(
    name = "enable_integration_tests",
    build_setting_default = False,
)

config_setting(
    name = "integration_tests_enabled",
    flag_values = {":enable_integration_tests": "True"},
)

# The run correlation id for one integration lifecycle.
#
# Six separate Bazel invocations (sweep, prepare template, migrate, provision, test, teardown)
# must agree on one disposable database name and must not collide with a concurrent run. They
# share no process, so the id comes from the caller and is repeated on every invocation:
#
#     bazel test ... --//build:run_id=$(uuidgen | tr -d - | tr 'A-Z' 'a-z')
#
# There is deliberately NO default. A constant fallback name is what allowed two runs against
# one fixture to share a database and drop each other's data. See //build:run_id.bzl.
string_flag(
    name = "run_id",
    build_setting_default = "",
)

# The base database name as a file, so no step reads it from ambient environment.
run_id_file(
    name = "run_id_file",
    run_id = ":run_id",
)

load("@rules_elixir//:mix_payloads.bzl", "mix_payloads")

# Inputs every Mix compile in this repository needs. Resolved as a toolchain (registered in
# //MODULE.bazel), so neither the ~15 first-party call sites nor the 269 generated Hex stubs
# repeat any of it.
mix_payloads(
    name = "payloads",
    # The Hex package manager itself, as a Mix archive. Not used to fetch anything -- every
    # dependency is already a Bazel repository and mix runs with --no-deps-check -- but Mix
    # refuses to resolve a project without it, aborting with "Could not find an SCM for
    # dependency" even for a dev-only dep nothing would compile.
    archives = ["@hex//:archive"],
    # A NIF that compiles C++ and links no C++ runtime builds clean, then fails dlopen on its
    # first unresolved symbol.
    cxx_static_runtime = "@llvm//runtimes/cxxstdlib:static_runtime_lib",
    elixir_make_nifs = ["//third_party/precompiled_nifs:elixir_make_nifs"],
    elixir_make_nifs_target = ["//third_party/precompiled_nifs:elixir_make_nifs_target"],
    openssl_sysroot = "//third_party/openssl:sysroot_tar",
    precompiled_nifs = ["//third_party/precompiled_nifs:precompiled_nifs"],
    precompiled_os_deps = ["//third_party/membrane:precompiled_os_deps"],
)

toolchain(
    name = "mix_payloads",
    toolchain = ":payloads",
    toolchain_type = "@rules_elixir//:mix_payloads_toolchain_type",
)
