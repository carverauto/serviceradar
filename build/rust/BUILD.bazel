toolchain(
    name = "linux_x86_64_musl_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//build/platforms:linux_musl",
    ],
    target_settings = ["//build/platforms:target_linux_x86_64_musl"],
    toolchain = "@rust_linux_x86_64__x86_64-unknown-linux-musl__stable_tools//:rust_toolchain",
    toolchain_type = "@rules_rust//rust:toolchain",
)

toolchain(
    name = "linux_aarch64_musl_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "//build/platforms:linux_musl",
    ],
    target_settings = ["//build/platforms:target_linux_aarch64_musl"],
    toolchain = "@rust_linux_x86_64__aarch64-unknown-linux-musl__stable_tools//:rust_toolchain",
    toolchain_type = "@rules_rust//rust:toolchain",
)
