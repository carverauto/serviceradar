{
  "enabled": false,
  "agent_id": "default-agent",
  "bumblebee_bin": "/usr/local/bin/bumblebee",
  "command_template": [
    "{bumblebee_bin}",
    "scan",
    "--profile",
    "deep",
    "--findings-only",
    "--exposure-catalog",
    "{catalog_path}",
    "--max-duration",
    "{scan_timeout}",
    "--root",
    "{root_path}"
  ],
  "catalog_path": "/var/lib/serviceradar/bumblebee/catalog/current",
  "catalog_snapshot_ref": "",
  "spool_dir": "/var/lib/serviceradar/bumblebee/spool",
  "tmp_dir": "/var/lib/serviceradar/bumblebee/tmp",
  "scan_timeout": "10m",
  "include_home_roots": true,
  "include_root": true,
  "explicit_roots": [],
  "exclude_roots": [],
  "ecosystems": [],
  "max_findings": 1000,
  "max_output_bytes": 33554432
}
