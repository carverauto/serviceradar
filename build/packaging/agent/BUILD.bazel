load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")
load("//build/packaging:package_rules.bzl", "serviceradar_package_from_config")
load("//build/packaging:packages.bzl", "PACKAGES")

package(default_visibility = ["//visibility:public"])

exports_files([
    "bin/serviceradar-agent",
    "systemd/serviceradar-agent.service",
])

serviceradar_package_from_config(
    name = "agent",
    config = PACKAGES["agent"],
)

# netprobe is no longer bundled here: it is carved out of the base agent and
# delivered as a signed pushed-artifact add-on (migrate-netprobe-to-native-addon
# §1.4; build/native_addons/addon_inventory.bzl: netprobe_addon_bundle).
pkg_files(
    name = "agent_release_runtime_files",
    srcs = [
        "//go/cmd/agent",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
    renames = {
        "//go/cmd/agent": "serviceradar-agent",
    },
)

pkg_tar(
    name = "agent_release_runtime_archive",
    srcs = [":agent_release_runtime_files"],
    extension = "tar.gz",
    package_dir = "/",
)

# netprobe carved out (delivered as a pushed-artifact add-on). rdp-adapter is a
# separate optional binary still bundled here pending its own add-on migration.
pkg_files(
    name = "agent_rdp_release_runtime_files",
    srcs = [
        "//go/cmd/agent",
        "//rust/rdp-adapter:rdp_adapter_ironrdp_connector_experimental",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
    renames = {
        "//go/cmd/agent": "serviceradar-agent",
        "//rust/rdp-adapter:rdp_adapter_ironrdp_connector_experimental": "serviceradar-rdp-adapter",
    },
)

pkg_tar(
    name = "agent_rdp_release_runtime_archive",
    srcs = [":agent_rdp_release_runtime_files"],
    extension = "tar.gz",
    package_dir = "/",
)
