load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//build/packaging:agent_packages.bzl", "declare_linux_agent_packages")

package(default_visibility = ["//visibility:public"])

exports_files([
    "bin/serviceradar-agent",
    "config/agent.json",
    "config/checkers/sweep/sweep.json",
    "scripts/postinstall.sh",
    "scripts/preremove.sh",
    "systemd/50-serviceradar-shared-runtime.conf",
    "systemd/serviceradar-agent.service",
])

declare_linux_agent_packages(["amd64"])

# rules_pkg RPM intermediate names are package-scoped, so architectures require
# separate Bazel packages. Public aliases preserve the installer target surface.
alias(
    name = "agent_arm64_deb",
    actual = "//build/packaging/agent/arm64:agent_arm64_deb",
)

alias(
    name = "agent_arm64_rpm",
    actual = "//build/packaging/agent/arm64:agent_arm64_rpm",
)

alias(
    name = "agent_release_runtime_linux_arm64_archive",
    actual = "//build/packaging/agent/arm64:agent_release_runtime_linux_arm64_archive",
)

# Stage the built agent RPM outside the output tree, for manual delivery to a
# lab host. Same rationale and same script as
# //build/native_addons:stage_netprobe_addon: the RPM is a declared input
# consumed through runfiles, so this never hand-resolves a bazel-out path.
#
#   bazel run //build/packaging/agent:stage_agent_rpm -- /tmp/agent.rpm
sh_binary(
    name = "stage_agent_rpm",
    srcs = ["//build/native_addons:stage_addon_bundle.sh"],
    data = [":agent_rpm"],
    env = {
        "BUNDLE_RUNFILE": "$(rootpath :agent_rpm)",
    },
)

sh_binary(
    name = "stage_agent_arm64_deb",
    srcs = ["//build/native_addons:stage_addon_bundle.sh"],
    data = [":agent_arm64_deb"],
    env = {
        "BUNDLE_RUNFILE": "$(rootpath :agent_arm64_deb)",
    },
)

# netprobe is no longer bundled here: it is carved out of the base agent and
# delivered as a signed pushed-artifact add-on (migrate-netprobe-to-native-addon
# §1.4; build/native_addons/addon_inventory.bzl: netprobe_addon_bundle).
