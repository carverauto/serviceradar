
apiVersion: v1
kind: Config
clusters:
  - name: carverauto
    cluster:
      server: https://10.0.2.4:6443
      certificate-authority-data: 
contexts:
  - name: carverauto
    context:
      cluster: carverauto
      user: carverauto-oidc
current-context: carverauto
users:
  - name: carverauto-oidc
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1
        command: kubectl
        args:
          - oidc-login
          - get-token
          - --oidc-issuer-url=https://auth.carverauto.dev/application/o/kubernetes-cluster/
          - --oidc-client-id=kubernetes-cluster
          - --oidc-extra-scope=email
          - --oidc-extra-scope=profile
          - --oidc-extra-scope=groups
          - --oidc-extra-scope=offline_access
          - --authentication-timeout-sec=
