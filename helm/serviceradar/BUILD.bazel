load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# Read by //:agent_release_key_consistency_test, which asserts the agentReleasePublicKey in both
# files matches the key embedded in the agent binary.
#
# BOTH are listed even though values.yaml already resolves today -- it does so only incidentally,
# because it appears in the `values` filegroup's srcs below, which makes it a target as a side
# effect. Relying on that would make this test break the moment someone reorganises a filegroup
# that has nothing to do with it. values-demo.yaml appears in no rule and does not resolve at all
# without this.
exports_files([
    "values.yaml",
    "values-demo.yaml",
])

# The chart files an Elixir test reads directly.
#
# elixir/serviceradar_core/test/serviceradar/observability/anomaly_config_seeder_test.exs
# resolves both at MODULE level via Path.expand("../../../../../helm/serviceradar/...",
# __DIR__). It is a drift guard: ServiceRadar.Observability.AnomalyConfigSeeder takes its
# first-boot defaults from SERVICERADAR_ANOMALY_* / SERVICERADAR_CAPACITY_FORECAST_* env
# vars, so values.yaml has to declare the blocks and templates/core.yaml has to wire the
# variables through. Adding a knob to the seeder and forgetting the chart would otherwise
# ship silent defaults.
#
# Module-level reads, so no ExUnit tag can skip them -- unstaged, the test file fails to load
# at all rather than failing an assertion.
filegroup(
    name = "values",
    srcs = [
        "templates/core.yaml",
        "values.yaml",
    ],
)

py_test(
    name = "flow_collector_strategy_migration_test",
    srcs = ["flow_collector_strategy_migration_test.py"],
    data = [
        "templates/flow-collector.yaml",
        "templates/flow-collector-strategy-migration-job.yaml",
    ],
)

# Keeps core.migrations.expectedVersion in step with the migrations the repo
# actually ships. The value is what the `wait-migrations` init container compares
# the database's high-water mark against, so a stale value silently restores the
# existence-only behaviour it replaced.
py_test(
    name = "migrations_expected_version_test",
    srcs = ["migrations_expected_version_test.py"],
    data = [
        "templates/web.yaml",
        "values.yaml",
        "//elixir/serviceradar_core:migrations",
    ],
)

py_test(
    name = "web_ng_public_url_test",
    srcs = ["web_ng_public_url_test.py"],
    data = [
        "templates/_helpers.tpl",
        "templates/agent-gateway.yaml",
        "templates/core.yaml",
        "templates/web.yaml",
        "values.yaml",
    ],
)
