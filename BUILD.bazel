###############################################################################
# Agent release trust anchor consistency test
###############################################################################
# The release-signing PUBLIC key is committed in three places -- the file embedded in the agent
# binary and the two chart values the control plane reads. Nothing else compares them:
# scripts/verify-agent-release-key-stamp.sh checks the agent's copy against the signing SECRET,
# which says nothing about the charts. A drift there publishes releases that agents refuse to
# install while every gate stays green.
#
# `data` must list every file the test reads; a missing entry fails under the sandbox only, which
# is exactly the environment CI uses.
# Same class of bug as the agent release key below, caught the hard way: the Cosign public key
# that verifies first-party Wasm plugins was set only in the demo overlay, so every other Helm
# install rendered no key env var and could not import a single plugin. This asserts the key is
# present -- not merely consistent -- everywhere it is embedded.
py_test(
    name = "first_party_plugin_cosign_key_consistency_test",
    size = "small",
    srcs = ["first_party_plugin_cosign_key_consistency_test.py"],
    data = [
        "//docs:cosign.pub",
        "//elixir/web-ng:config/config.exs",
        "//helm/serviceradar:values.yaml",
        "//helm/serviceradar:values-demo.yaml",
    ],
)

# Fails when the committed schema baseline falls too far behind the migrations on disk, or when
# its recorded checksum no longer matches its own SQL file. Nothing detected either before: the
# only consumer of `included_through` / `schema_sha256` was startup_migrations.ex, so the
# baseline sat 118 migrations behind silently. That matters more now that the fixture template
# and the developer migrate task bootstrap from it, not just service startup.
#
# A DRIFT check, not schema-diff validation. It does not prove the baseline reproduces what a
# full migration replay produces -- see the module docstring.
py_test(
    name = "schema_baseline_freshness_test",
    size = "small",
    srcs = ["schema_baseline_freshness_test.py"],
    data = [
        "//elixir/serviceradar_core:migrations",
        "//elixir/serviceradar_core:priv/repo/baseline/metadata.json",
        "//elixir/serviceradar_core:priv/repo/baseline/platform_schema.sql",
    ],
)

