###############################################################################
# Gazelle
###############################################################################
# gazelle:prefix github.com/carverauto/serviceradar
# gazelle:exclude .claude
# gazelle:exclude .gomodcache
# gazelle:exclude _build
# gazelle:exclude dist
# gazelle:exclude elixir
# gazelle:exclude js
# gazelle:exclude release-artifacts
# gazelle:exclude target
# gazelle:exclude rust
# gazelle:exclude rust/rperf-client
# gazelle:exclude cmd/ebpf
# gazelle:exclude go/pkg/agent/testdata
#
# third_party is generated and vendored, never hand-authored, so Gazelle has no business
# rewriting it. It historically walked into the vendored crate tree and tried to generate
# proto_library rules for .proto files shipped inside crates, some of which hold more than
# one proto package -- which Gazelle cannot express, making a repo-wide `-mode=diff`
# non-zero for reasons no first-party change could fix.
# gazelle:exclude third_party
#
# Two proto directories that hold UPSTREAM schemas, not Go packages of ours. Gazelle's
# proto language wants to own them and gets both wrong:
#
#   proto/cri          generates rules with importpath k8s.io/cri-api/pkg/apis/runtime/v1
#   google/protobuf    generates a second google.golang.org/protobuf/.../wrapperspb, which
#                      collides with the real well-known type
# gazelle:exclude proto/cri
# gazelle:exclude google/protobuf

gazelle(
    name = "gazelle",
)

