load("@bazel_gazelle//:def.bzl", "gazelle")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

###############################################################################
# Gazelle
###############################################################################
# gazelle:prefix github.com/carverauto/serviceradar
# gazelle:exclude .claude
# gazelle:exclude .gomodcache
# gazelle:exclude _build
# gazelle:exclude dist
# gazelle:exclude elixir
# gazelle:exclude js
# gazelle:exclude release-artifacts
# gazelle:exclude target
# gazelle:exclude rust
# gazelle:exclude rust/rperf-client
# gazelle:exclude cmd/ebpf
# gazelle:exclude go/pkg/agent/testdata
#
# third_party is generated and vendored, never hand-authored, so Gazelle has no business
# rewriting it. It historically walked into the vendored crate tree and tried to generate
# proto_library rules for .proto files shipped inside crates, some of which hold more than
# one proto package -- which Gazelle cannot express, making a repo-wide `-mode=diff`
# non-zero for reasons no first-party change could fix.
# gazelle:exclude third_party
#
# Two proto directories that hold UPSTREAM schemas, not Go packages of ours. Gazelle's
# proto language wants to own them and gets both wrong:
#
#   proto/cri          generates rules with importpath k8s.io/cri-api/pkg/apis/runtime/v1
#   google/protobuf    generates a second google.golang.org/protobuf/.../wrapperspb, which
#                      collides with the real well-known type
# gazelle:exclude proto/cri
# gazelle:exclude google/protobuf

gazelle(
    name = "gazelle",
)

###############################################################################
# exports_files
###############################################################################
exports_files([
    ".bazelrc",
    ".github/workflows/external-wasm-plugin.yml",
    ".github/workflows/image-security.yml",
    ".github/workflows/native-addons.yml",
    ".github/workflows/publish-oci.yml",
    ".github/workflows/release.yml",
    ".github/workflows/source-security.yml",
    ".github/workflows/wasm-plugins.yml",
    "MODULE.bazel",
    "VERSION",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/config.toml",
    ".tool-versions",
    "elixir/.credo.base.exs",
    "elixir/.credo.ex_dna.exs",
    "elixir/.credo.jump_checks.exs",
    "elixir/.credo.ex_slop.exs",
    "k8s/argocd/applications/demo-prod.yaml",
    "buildbuddy.yaml",
    "buildbuddy_setup_fixture_env.sh",
    "docker-compose.yml",
    "openspec/changes/parallelize-core-integration-tests/benchmark.md",
])

###############################################################################
# RUST RELEASE MODE OPTIMIZATION
###############################################################################
config_setting(
    name = "release",
    values = {
        "compilation_mode": "opt",
    },
)

###############################################################################
# CI DOCKER AUTHENTICATION
###############################################################################
sh_binary(
    name = "buildbuddy_setup_docker_auth",
    srcs = ["buildbuddy_setup_docker_auth.sh"],
)

###############################################################################
# CI INTEGRATION-FIXTURE CREDENTIALS
#
# Same credential carve-out as the docker auth target above: a sandboxed test action must not
# fetch cluster secrets itself, so they reach the Bazel CLIENT's environment before `bazel test`
# starts. Reads DSNs from the srql-fixtures K8s secrets when the caller has cluster access,
# otherwise from pre-set workflow DSN secrets. The CA is always fetched live (cert-manager
# Secret or SRQL_FIXTURE_CA_URL), never from a stored PEM.
###############################################################################
sh_binary(
    name = "buildbuddy_setup_fixture_env",
    srcs = ["buildbuddy_setup_fixture_env.sh"],
)

# NOTE: there is deliberately no `rbe_platform` here. The RBE platform is
# //build/rbe:rbe_platform, which is what //.bazelrc names for --host_platform,
# --platforms and --extra_execution_platforms.
#
# A second definition used to sit here with the same executor image but the
# OPPOSITE compiler constraint (@bazel_tools//tools/cpp:clang, against gcc in
# //build/rbe:BUILD). Nothing referenced it -- every reference in the repo,
# including .bazelrc, points at //build/rbe -- and `rdeps` returned only the
# target itself. It was removed rather than reconciled, because a platform that
# claims clang for an image whose toolchain is /usr/bin/gcc is worse than absent:
# it is the first thing you would reach for when making the toolchain hermetic,
# and it lies about what the executor has.

alias(
    name = "cwalk",
    actual = "//third_party/cwalk:cwalk",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "swiftlint_lint",
    srcs = ["//scripts:swiftlint_bazel.sh"],
    args = [
        "$(location .swiftlint.yml)",
    ],
    data = [
        ".swiftlint.yml",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "images",
    actual = "//docker/images:images",
    visibility = ["//visibility:public"],
)

alias(
    name = "push",
    actual = "//docker/images:push_all",
    visibility = ["//visibility:public"],
)
