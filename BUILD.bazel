load("@bazel_gazelle//:def.bzl", "gazelle")
load("@platforms//host:extension.bzl", "host_platform")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

###############################################################################
# Gazelle
###############################################################################
# gazelle:prefix github.com/carverauto/serviceradar
# gazelle:exclude .claude
# gazelle:exclude .gomodcache
# gazelle:exclude _build
# gazelle:exclude dist
# gazelle:exclude elixir
# gazelle:exclude js
# gazelle:exclude release-artifacts
# gazelle:exclude target
# gazelle:exclude rust
# gazelle:exclude rust/rperf-client
# gazelle:exclude cmd/ebpf
# gazelle:exclude go/pkg/agent/testdata
#
# third_party is generated and vendored, never hand-authored, so Gazelle has no business
# rewriting it. Without this exclusion Gazelle walked into //third_party/crates -- the
# crates_vendor output -- and tried to generate proto_library rules for .proto files that
# ship inside vendored crates (prost-build fixtures, tonic-health, spiffe, prometheus).
# Two of those directories hold more than one proto package, which Gazelle cannot express,
# so it errored:
#
#   third_party/crates/prost-build-0.14.4/src/fixtures/alphabet: directory contains
#   multiple proto packages. Gazelle can only generate a proto_library for one package.
#
# That made a repo-wide `-mode=diff` non-zero for reasons no first-party change can fix,
# which is why the drift check used to be scoped to changed Go directories instead. It also
# put 13 vendored BUILD files in the diff. scripts/vendor.sh owns that tree; regenerate it
# there, do not let Gazelle edit it.
# gazelle:exclude third_party
#
# Three proto directories that hold UPSTREAM schemas, not Go packages of ours. Gazelle's
# proto language wants to own them and gets all three wrong:
#
#   proto/cri          generates rules with importpath k8s.io/cri-api/pkg/apis/runtime/v1
#   google/protobuf    generates a second google.golang.org/protobuf/.../wrapperspb, which
#                      collides with the real well-known type
#   proto/dgraph       hand-written. //proto/dgraph:proto_dgraph is named to match the
#                      Cargo crate and carries strip_import_prefix = "proto" so Bazel and
#                      Cargo agree on prost import paths. Excluding only the nested
#                      proto/dgraph/proto directory is NOT enough: that orphans the parent
#                      rule in Gazelle's view and it DELETES the proto_library outright,
#                      leaving rust_prost_library(proto = ":proto_dgraph") dangling and the
#                      build broken. Exclude the whole directory.
# gazelle:exclude proto/cri
# gazelle:exclude proto/dgraph
# gazelle:exclude google/protobuf

gazelle(
    name = "gazelle",
)

