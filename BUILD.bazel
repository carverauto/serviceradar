###############################################################################
# Cache proxy consistency test
###############################################################################
py_test(
    name = "buildbuddy_cache_proxy_config_test",
    size = "small",
    srcs = ["buildbuddy_cache_proxy_config_test.py"],
    data = [
        ".bazelrc",
        "Makefile",
        "buildbuddy.yaml",
        "k8s/buildbuddy/values-cache-proxy.yaml",
    ],
)

###############################################################################
# RUST RELEASE MODE OPTIMIZATION
###############################################################################
config_setting(
    name = "release",
    values = {
        "compilation_mode": "opt",
    },
)

###############################################################################
# CI DOCKER AUTHENTICATION
###############################################################################
sh_binary(
    name = "buildbuddy_setup_docker_auth",
    srcs = ["buildbuddy_setup_docker_auth.sh"],
)

###############################################################################
# CI INTEGRATION-FIXTURE CREDENTIALS
#
# Same credential carve-out as the docker auth target above: a test action cannot fetch
# these itself (remote executor, no kubeconfig, sandboxed), so they must reach the bazel
# CLIENT's environment before `bazel test` runs. Reads the srql-fixtures K8s secrets when
# the caller has cluster access, otherwise trusts pre-set BuildBuddy workflow secrets.
###############################################################################
sh_binary(
    name = "buildbuddy_setup_fixture_env",
    srcs = ["buildbuddy_setup_fixture_env.sh"],
)

# NOTE: there is deliberately no `rbe_platform` here. The RBE platform is
# //build/rbe:rbe_platform, which is what //.bazelrc names for --host_platform,
# --platforms and --extra_execution_platforms.
#
# A second definition used to sit here with the same executor image but the
# OPPOSITE compiler constraint (@bazel_tools//tools/cpp:clang, against gcc in
# //build/rbe:BUILD). Nothing referenced it -- every reference in the repo,
# including .bazelrc, points at //build/rbe -- and `rdeps` returned only the
# target itself. It was removed rather than reconciled, because a platform that
# claims clang for an image whose toolchain is /usr/bin/gcc is worse than absent:
# it is the first thing you would reach for when making the toolchain hermetic,
# and it lies about what the executor has.

alias(
    name = "cwalk",
    actual = "//third_party/cwalk:cwalk",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "swiftlint_lint",
    srcs = ["//scripts:swiftlint_bazel.sh"],
    args = [
        "$(location .swiftlint.yml)",
    ],
    data = [
        ".swiftlint.yml",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "images",
    actual = "//docker/images:images",
    visibility = ["//visibility:public"],
)

alias(
    name = "push",
    actual = "//docker/images:push_all",
    visibility = ["//visibility:public"],
)
