py_binary(
    name = "integration_benchmark_harness_hash",
    srcs = ["ci_heavy_gate_contract_test.py"],
    args = ["--hash-integration-benchmark"],
    data = [
        "buildbuddy.yaml",
        "//rust/integration-db:BUILD.bazel",
        "//rust/integration-db:src/bin/observe_connections.rs",
        "//rust/integration-db:src/connection_observer.rs",
    ],
    main = "ci_heavy_gate_contract_test.py",
    # This target shares its source with the remotely executed contract test. Disabling
    # bytecode output keeps the no-remote execution transition from claiming the same .pyc.
    precompile = "disabled",
    tags = ["no-remote"],
)

py_test(
    name = "agent_release_key_consistency_test",
    size = "small",
    srcs = ["agent_release_key_consistency_test.py"],
    # Proper labels, not paths: both directories are their own packages, so
    # "go/pkg/agent/release_signing_key.txt" is rejected as a label in THIS package. The
    # cache-proxy test above can use bare paths only because k8s/buildbuddy has no BUILD file.
    data = [
        "//go/pkg/agent:release_signing_key.txt",
        "//helm/serviceradar:values.yaml",
        "//helm/serviceradar:values-demo.yaml",
    ],
)

