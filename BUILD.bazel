    name = "swiftlint_lint",
    srcs = ["//scripts:swiftlint_bazel.sh"],
    args = [
        "$(location .swiftlint.yml)",
    ],
    data = [
        ".swiftlint.yml",
    ],
    visibility = ["//visibility:public"],
)

