load("@bazel_gazelle//:def.bzl", "gazelle")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@platforms//host:extension.bzl", "host_platform")

###############################################################################
# Gazelle
###############################################################################
# gazelle:prefix github.com/carverauto/serviceradar
# gazelle:exclude .claude
# gazelle:exclude .gomodcache
# gazelle:exclude _build
# gazelle:exclude dist
# gazelle:exclude elixir
# gazelle:exclude js
# gazelle:exclude release-artifacts
# gazelle:exclude target
# gazelle:exclude rust
# gazelle:exclude rust/rperf-client
# gazelle:exclude cmd/ebpf
# gazelle:exclude go/pkg/agent/testdata

gazelle(
    name = "gazelle",
)

###############################################################################
# exports_files
###############################################################################
exports_files([
    ".forgejo/workflows/external-wasm-plugin.yml",
    ".forgejo/workflows/image-security.yml",
    ".forgejo/workflows/native-addons.yml",
    ".forgejo/workflows/release.yml",
    ".forgejo/workflows/source-security.yml",
    ".forgejo/workflows/wasm-plugins.yml",
    "VERSION",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/config.toml",
    ".tool-versions",
    "elixir/.credo.base.exs",
    "elixir/.credo.ex_dna.exs",
    "elixir/.credo.jump_checks.exs",
    "elixir/.credo.ex_slop.exs",
    "k8s/argocd/applications/demo-prod.yaml",
])

###############################################################################
# RUST RELEASE MODE OPTIMIZATION
###############################################################################
config_setting(
    name = "release",
    values = {
        "compilation_mode": "opt",
    },
)

###############################################################################
# CI DOCKER AUTHENTICATION
###############################################################################
sh_binary(
    name = "buildbuddy_setup_docker_auth",
    srcs = ["buildbuddy_setup_docker_auth.sh"],
)

###############################################################################
# CI INTEGRATION-FIXTURE CREDENTIALS
#
# Same credential carve-out as the docker auth target above: a test action cannot fetch
# these itself (remote executor, no kubeconfig, sandboxed), so they must reach the bazel
# CLIENT's environment before `bazel test` runs. Reads the srql-fixtures K8s secrets when
# the caller has cluster access, otherwise trusts pre-set BuildBuddy workflow secrets.
###############################################################################
sh_binary(
    name = "buildbuddy_setup_fixture_env",
    srcs = ["buildbuddy_setup_fixture_env.sh"],
)

###############################################################################
# Custom RBE platform executor image
###############################################################################
platform(
    name = "rbe_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:clang",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "dockerNetwork": "host",
        "container-image": "docker://registry.carverauto.dev/serviceradar/rbe-executor:v1.0.24.1",
    },
    visibility = ["//visibility:public"],
)

alias(
    name = "cwalk",
    actual = "//third_party/cwalk:cwalk",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "swiftlint_lint",
    srcs = ["//scripts:swiftlint_bazel.sh"],
    args = [
        "$(location .swiftlint.yml)",
    ],
    data = [
        ".swiftlint.yml",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "images",
    actual = "//docker/images:images",
    visibility = ["//visibility:public"],
)

alias(
    name = "push",
    actual = "//docker/images:push_all",
    visibility = ["//visibility:public"],
)
