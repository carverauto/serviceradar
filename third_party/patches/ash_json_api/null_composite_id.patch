               primary_key_fields
               |> Enum.zip(values)
               |> Enum.reduce(filter, fn {key, value}, filter ->
-                Map.put(filter, key, value)
+                Map.put(filter, key, AshJsonApi.Resource.decode_primary_key_part(value))
