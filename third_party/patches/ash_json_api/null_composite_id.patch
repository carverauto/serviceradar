Encode a null composite JSON:API id part as U+001F.

AshJsonApi.Resource.encode_primary_key/1 stringifies every composite key part.
A null part (otel_metrics.span_id, timeseries_metrics_hourly.device_id) raises
Protocol.UndefinedError and the index page fails. A null part is the single
character U+001F. Text that already starts with U+001F is prefixed with a
second U+001F, so null stays distinct from "" and from every real string.
Every other part stays to_string/1, so existing ids are unchanged. The path
decoder reverses the same mapping.

--- a/lib/ash_json_api/resource/resource.ex
+++ b/lib/ash_json_api/resource/resource.ex
@@ -767,6 +767,17 @@
   @deprecated "See AshJsonApi.Resource.Info.routes/1"
   defdelegate routes(resource, domains), to: AshJsonApi.Resource.Info
 
+  @null_primary_key_part <<0x1F>>
+
+  @doc """
+  Encodes a record id.
+
+  A single key that is null encodes as nil. A composite id joins each part
+  with the resource delimiter. A null part is the single character U+001F.
+  Text that already starts with U+001F is prefixed with a second U+001F, so
+  null stays distinct from `""` and from every real string. Every other part
+  is `to_string/1`, so ids that contain no null part stay unchanged.
+  """
   def encode_primary_key(%resource{} = record) do
     case primary_key_fields(resource) do
       [] ->
@@ -788,12 +799,29 @@
         [_ | concatenated_keys] =
           keys
           |> Enum.reverse()
-          |> Enum.reduce([], fn key, acc -> [delimiter, to_string(Map.get(record, key)), acc] end)
+          |> Enum.reduce([], fn key, acc ->
+            [delimiter, encode_primary_key_part(Map.get(record, key)), acc]
+          end)
 
         IO.iodata_to_binary(concatenated_keys)
     end
   end
 
+  @doc false
+  def encode_primary_key_part(nil), do: @null_primary_key_part
+
+  def encode_primary_key_part(value) do
+    case to_string(value) do
+      <<0x1F, _::binary>> = text -> <<0x1F, 0x1F, text::binary>>
+      text -> text
+    end
+  end
+
+  @doc false
+  def decode_primary_key_part(@null_primary_key_part), do: nil
+  def decode_primary_key_part(<<0x1F, 0x1F, rest::binary>>), do: rest
+  def decode_primary_key_part(value), do: value
+
   def route(resource, domains, criteria \\ %{}) do
     resource
     |> routes(domains)
--- a/lib/ash_json_api/controllers/helpers.ex
+++ b/lib/ash_json_api/controllers/helpers.ex
