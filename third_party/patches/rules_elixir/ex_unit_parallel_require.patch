ex_unit_test: load test srcs with one Kernel.ParallelCompiler.require call.

`elixir -r` per file is a sequential Code.require_file, so large targets spent
about a minute compiling test files one at a time. elixir_opts keep their own
ordered `-r` and still load first. Applied after ex_unit_erl_libs.patch.

--- a/private/ex_unit_test.bzl
+++ b/private/ex_unit_test.bzl
@@ -81,6 +81,55 @@ def _runfiles_erl_libs_entry(info):
         return "$TEST_SRCDIR/" + parent[3:]
     return "$TEST_SRCDIR/$TEST_WORKSPACE/" + parent
 
+def _parallel_require_script(ctx):
+    """Write an .exs that loads every test file with one ParallelCompiler call, or None.
+
+    `elixir -r FILE` is a sequential Code.require_file per file, so a target with a few
+    hundred test files spent about a minute compiling them one after another before the
+    first test ran. `mix test` loads test files through Kernel.ParallelCompiler.require
+    instead, and so does this. Files compile concurrently and in no fixed order, so a test
+    file must not use, at compile time, a module that another test file defines: the
+    load fails with "module ... is not available". Shared helpers belong in test/support
+    or in a helper loaded through elixir_opts, as they already must under `mix test`.
+
+    `elixir -pr` is the CLI spelling of that call, but it takes ONE wildcard pattern, and
+    a wildcard cannot name an arbitrary list of files across directories. So the call is
+    written out here, with the same outcome handling `-pr` has: diagnostics are printed by
+    the compiler and a failed load exits non-zero.
+
+    elixir_opts are not part of this. They are emitted ahead of it with their own `-r`, in
+    order, because test files depend on them (a test helper has to start ExUnit before any
+    `use ExUnit.Case` compiles).
+    """
+    if not ctx.files.srcs:
+        return None
+    paths = []
+    for s in ctx.files.srcs:
+        p = _package_relative_path(ctx, _staged_path(s))
+        # A JSON string is an Elixir string literal, escapes included, except that Elixir
+        # interpolates `#{`. No real test path contains it; refuse rather than emit a literal
+        # that names a different file.
+        if "#{" in p:
+            fail("ex_unit_test cannot pass test file path {} to ParallelCompiler".format(p))
+        paths.append(json.encode(p))
+    output = ctx.actions.declare_file(ctx.label.name + ".require_srcs.exs")
+    ctx.actions.write(
+        output = output,
+        content = """\
+# Generated by ex_unit_test. Loads the test files in parallel, as `mix test` does.
+case Kernel.ParallelCompiler.require(
+       [
+         {files}
+       ],
+       return_diagnostics: true
+     ) do
+  {{:ok, _, _}} -> :ok
+  {{:error, _, _}} -> exit({{:shutdown, 1}})
+end
+""".format(files = ",\n         ".join(paths)),
+    )
+    return output
+
 def _impl(ctx):
     # TEST_TMPDIR, not TEST_UNDECLARED_OUTPUTS_DIR.
     #
@@ -153,6 +202,8 @@ def _impl(ctx):
     # $TEST_SRCDIR and $TEST_WORKSPACE expand when the test starts.
     erl_libs_export = 'export ERL_LIBS="{}"'.format(":".join(erl_libs_entries))
 
+    require_srcs = _parallel_require_script(ctx)
+
     (erlang_home, _, erlang_runfiles) = erlang_dirs(ctx)
     (elixir_home, elixir_runfiles) = elixir_dirs(ctx, short_path = True)
 
@@ -224,10 +275,10 @@ rm test.log
             env = env,
             setup = ctx.attr.setup,
             elixir_opts = " ".join([shell.quote(opt) for opt in ctx.attr.elixir_opts]),
-            srcs_args = " \\\n    ".join([
-                "-r {}".format(_package_relative_path(ctx, _staged_path(s)))
-                for s in ctx.files.srcs
-            ]),
+            # Runfiles path, not the staged copy: the generated file is not in srcs or data.
+            srcs_args = '-r "$TEST_SRCDIR/$TEST_WORKSPACE/{}"'.format(
+                require_srcs.short_path,
+            ) if require_srcs else "",
         )
     else:
         fail("not implemented")
@@ -243,7 +294,10 @@ rm test.log
     runfiles = erlang_runfiles.merge(elixir_runfiles)
     runfiles = runfiles.merge_all(
         [
-            ctx.runfiles(ctx.files.srcs + ctx.files.data + erl_libs_files + direct_files),
+            ctx.runfiles(
+                ctx.files.srcs + ctx.files.data + erl_libs_files + direct_files +
+                ([require_srcs] if require_srcs else []),
+            ),
         ] + [
             tool[DefaultInfo].default_runfiles
             for tool in ctx.attr.tools
