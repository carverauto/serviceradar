ex_unit_test: name directory apps on ERL_LIBS instead of copying them.

A per-target _deps tree is a unique artifact, so a unit-test cache miss
re-uploads the whole dependency closure. Directory apps already have
<app>/ebin beside priv; Erlang accepts a colon-separated ERL_LIBS.

--- a/private/ex_unit_test.bzl
+++ b/private/ex_unit_test.bzl
@@ -46,6 +46,41 @@
         return path_join("external", p.removeprefix("../"))
     return p
 
+def _runfiles_erl_libs_entry(info):
+    """Shell fragment for an app Erlang can see without a per-test copy, or None.
+
+    ERL_LIBS is a colon-separated list of directories scanned for <app>/ebin.
+    mix_app already emits that layout (`<target>/<app>/ebin` next to `priv`).
+    Copying it into a private `<test>_deps` tree makes a unique tree artifact per
+    test target, so a cache miss re-uploads every dependency file even when the
+    bytes are already in CAS. Measured on one unit shard: 17550 files, ~605MB,
+    ~15 minutes, almost all of it upload.
+
+    A dependency that is not already in that layout (individual .beam files, or
+    headers that have to sit in include/ beside ebin/) still needs staging.
+    mix_app publishes headers on ErlangAppInfo.include instead of next to ebin,
+    so any app with headers is staged; -include_lib would not see them otherwise.
+    """
+    if info.include:
+        return None
+    if len(info.beam) != 1:
+        return None
+    ebin = info.beam[0]
+    if not ebin.is_directory:
+        return None
+    suffix = "/{}/ebin".format(info.app_name)
+    if not ebin.short_path.endswith(suffix):
+        return None
+    parent = ebin.short_path[:-len(suffix)]
+    for priv in info.priv:
+        if priv.short_path != path_join(parent, info.app_name, "priv"):
+            return None
+    # short_path for an external repo starts with `../<repo>`. Under TEST_SRCDIR
+    # that repo is a sibling of the main workspace, not `../` relative to it.
+    if parent.startswith("../"):
+        return "$TEST_SRCDIR/" + parent[3:]
+    return "$TEST_SRCDIR/$TEST_WORKSPACE/" + parent
+
 def _impl(ctx):
     # TEST_TMPDIR, not TEST_UNDECLARED_OUTPUTS_DIR.
