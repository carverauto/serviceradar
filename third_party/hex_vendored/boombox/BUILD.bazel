load("@serviceradar//build:mix_app.bzl", "mix_app")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "deps/**",
            "tmp/**",
        ],
    ),
)

# The vendored boombox, compiled by Mix inside a hermetic Bazel action.
#
# This is NOT the Hex package. @hex_boombox is deliberately unbuildable here: it reaches
# for Membrane.Hackney.Source, and hackney was dropped because it pulls h2, which collides
# with grpcbox's chatterbox (same h2_* modules) during `mix release`. This copy has that
# source removed -- see the comment in mix.exs and internal_bin/storage_endpoints.ex.
#
# serviceradar_core_elx declares it as
# {:boombox, path: "../../third_party/hex_vendored/boombox"}, resolved against its own
# directory -- so Mix reads this same tree that Bazel compiles. There used to be a second,
# byte-identical copy at elixir/serviceradar_core_elx/vendor/boombox purely to satisfy the
# Mix path dep; it was removed when this moved here. Do not reintroduce one: it was a
# patched Hex package maintained by hand in two places, with nothing enforcing that the
# copy Mix read and the copy Bazel compiled stayed in sync.
mix_app(
    name = "erlang_app",
    srcs = [":srcs"],
    app_name = "boombox",
    mix_env = "prod",
    deps = [
        "@rules_elixir//elixir",
        "@hex_image//:erlang_app",
        "@hex_membrane_core//:erlang_app",
        "@hex_membrane_ffmpeg_swresample_plugin//:erlang_app",
        "@hex_membrane_ffmpeg_swscale_plugin//:erlang_app",
        "@hex_membrane_http_adaptive_stream_plugin//:erlang_app",
        "@hex_membrane_ivf_plugin//:erlang_app",
        "@hex_membrane_mp4_plugin//:erlang_app",
        "@hex_membrane_ogg_plugin//:erlang_app",
        "@hex_membrane_realtimer_plugin//:erlang_app",
        "@hex_membrane_rtmp_plugin//:erlang_app",
        "@hex_membrane_rtp_aac_plugin//:erlang_app",
        "@hex_membrane_rtp_format//:erlang_app",
        "@hex_membrane_rtp_h264_plugin//:erlang_app",
        "@hex_membrane_rtp_h265_plugin//:erlang_app",
        "@hex_membrane_rtp_opus_plugin//:erlang_app",
        "@hex_membrane_rtp_plugin//:erlang_app",
        "@hex_membrane_rtsp_plugin//:erlang_app",
        "@hex_membrane_srt_plugin//:erlang_app",
        "@hex_membrane_stream_plugin//:erlang_app",
        "@hex_membrane_transcoder_plugin//:erlang_app",
        "@hex_membrane_vpx_plugin//:erlang_app",
        "@hex_membrane_wav_plugin//:erlang_app",
        "@hex_membrane_webrtc_plugin//:erlang_app",
    ],
)
