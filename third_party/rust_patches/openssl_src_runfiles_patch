+    if let Ok(p) = env::var("RULES_RUST_OPENSSL_SRC_DIR") {
+        if !p.is_empty() {
+            let path = PathBuf::from(p);
+            if path.is_dir() {
+                return path;
+            }
+            if let Some(parent) = path.parent() {
+                return parent.to_path_buf();
+            }
+        }
+    }
+    // No env!("CARGO_MANIFEST_DIR") fallback. `env!` is evaluated at COMPILE time, so it
+    // bakes the absolute path of the sandbox that built this crate straight into the
+    // rlib -- which rules_rs's process wrapper now rejects outright:
+    //
+    //     compiled Rust output libopenssl_src-*.rlib embeds the absolute working
+    //     directory /buildbuddy-execroot
+    //
+    // That check is right: a path from one machine's execroot frozen into a build
+    // artifact is exactly the non-determinism that wrecks cache hit rates, and the
+    // baked value was stale here anyway -- it is why RULES_RUST_OPENSSL_SRC_DIR exists.
+    //
+    // Reading CARGO_MANIFEST_DIR at RUNTIME instead would compile, but it is wrong: this
+    // function is called from openssl-sys' build script, so the runtime value is
+    // openssl-sys' manifest directory rather than this crate's. Failing loudly beats
+    // silently pointing at the wrong tree.
+    panic!(
+        "openssl-src: RULES_RUST_OPENSSL_SRC_DIR is unset. Under Bazel the vendored \
