 use std::process::Command;
 
 pub fn source_dir() -> PathBuf {
+    // Under Bazel the crate's baked CARGO_MANIFEST_DIR points at a stale sandbox, so
+    // honor RULES_RUST_OPENSSL_SRC_DIR (an absolute $(location) into the vendored
+    // openssl/ source, expanded from ${pwd}). A dir is used directly; a marker file
+    // resolves to its parent.
+    if let Ok(p) = env::var("RULES_RUST_OPENSSL_SRC_DIR") {
+        if !p.is_empty() {
+            let path = PathBuf::from(p);
+            if path.is_dir() {
+                return path;
+            }
+            if let Some(parent) = path.parent() {
+                return parent.to_path_buf();
+            }
+        }
+    }
     Path::new(env!("CARGO_MANIFEST_DIR")).join("openssl")
 }
 
