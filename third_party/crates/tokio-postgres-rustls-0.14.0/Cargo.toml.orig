[package]
name = "tokio-postgres-rustls"
description = "Rustls integration for tokio-postgres"
version = "0.14.0"
authors = ["Jasper Hugo <jasper@jasperhugo.com>"]
repository = "https://github.com/jbg/tokio-postgres-rustls"
edition = "2024"
license = "MIT"
readme = "README.md"

[features]
default = []
aws-lc-rs = ["rustls/aws_lc_rs", "tokio-rustls/aws_lc_rs"]
native-certs = ["dep:rustls-native-certs"]
ring = ["rustls/ring", "tokio-rustls/ring"]
webpki-roots = ["dep:webpki-roots"]

[dependencies]
rustls-native-certs = { version = "0.8", default-features = false, optional = true }
rustls = { version = "0.23", default-features = false }
sha2 = { version = "0.11", default-features = false }
tokio = { version = "1", default-features = false }
tokio-postgres = { version = "0.7", default-features = false, features = [
  "runtime",
] }
tokio-rustls = { version = "0.26", default-features = false }
webpki-roots = { version = "1", default-features = false, optional = true }
x509-cert = { version = "0.2", default-features = false, features = ["std"] }

[dev-dependencies]
bollard = "0.19"
env_logger = { version = "0.11", default-features = false }
futures-util = { version = "0.3", default-features = false }
tokio = { version = "1", default-features = false, features = ["macros", "rt", "time"] }
tokio-postgres = { version = "0.7", default-features = false, features = [
  "runtime",
] }
rustls = { version = "0.23", default-features = false, features = [
  "std",
  "logging",
  "tls12",
  "ring",
] }
