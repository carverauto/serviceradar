[package]
name = "cri-api"
version = "0.2.0"
license = "Apache-2.0"
authors = ["wuheng <wuheng@iscas.ac.cn>"]
categories = ["api-bindings"]
description = "Bindings Kubernetes CRI"
edition = "2021"
keywords = ["client", "kubernetes", "k8s", "cri"]
repository = "https://gitee.com/edgeai-steward/cri-api"
readme = "README.md"

[dependencies]
tonic = { version = "0.12.3", default-features = false, features = ["prost", "server", "codegen"]}
prost = { version = "0.13.4" }
serde = { version = "1.0.217", default-features = false, features = ["derive"] }

[build-dependencies]
tonic-build = {version = "0.12.3", default-features = false, features = ["prost"]}

