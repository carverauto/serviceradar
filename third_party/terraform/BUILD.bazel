package(default_visibility = ["//visibility:public"])

config_setting(
    name = "darwin_arm64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
)

config_setting(
    name = "linux_amd64",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)

alias(
    name = "terraform",
    actual = select({
        ":darwin_arm64": "@terraform_cli_darwin_arm64//:terraform",
        ":linux_amd64": "@terraform_cli_linux_amd64//:terraform",
    }),
)
