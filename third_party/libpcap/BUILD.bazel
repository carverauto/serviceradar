load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "libpcap_amd64_files",
    srcs = [
        "@ubuntu_noble_libdbus_1_3_amd64_deb//file",
        "@ubuntu_noble_libibverbs1_amd64_deb//file",
        "@ubuntu_noble_libnl_3_200_amd64_deb//file",
        "@ubuntu_noble_libnl_route_3_200_amd64_deb//file",
        "@ubuntu_noble_libpcap0_8_dev_amd64_deb//file",
        "@ubuntu_noble_libpcap0_8t64_amd64_deb//file",
    ],
    outs = [
        "linux_amd64/libdbus-1.so",
        "linux_amd64/libdbus-1.so.3",
        "linux_amd64/libibverbs.so",
        "linux_amd64/libibverbs.so.1",
        "linux_amd64/libnl-3.so",
        "linux_amd64/libnl-3.so.200",
        "linux_amd64/libnl-route-3.so",
        "linux_amd64/libnl-route-3.so.200",
        "linux_amd64/libpcap.so",
        "linux_amd64/libpcap.so.0.8",
    ],
    cmd = """
set -euo pipefail
out_dir="$(@D)/linux_amd64"
root="$(@D)/libpcap_amd64_root"
rm -rf "$${out_dir}" "$${root}"
mkdir -p "$${out_dir}" "$${root}"
dpkg-deb -x "$(location @ubuntu_noble_libpcap0_8_dev_amd64_deb//file)" "$${root}"
dpkg-deb -x "$(location @ubuntu_noble_libpcap0_8t64_amd64_deb//file)" "$${root}"
dpkg-deb -x "$(location @ubuntu_noble_libdbus_1_3_amd64_deb//file)" "$${root}"
dpkg-deb -x "$(location @ubuntu_noble_libibverbs1_amd64_deb//file)" "$${root}"
dpkg-deb -x "$(location @ubuntu_noble_libnl_3_200_amd64_deb//file)" "$${root}"
dpkg-deb -x "$(location @ubuntu_noble_libnl_route_3_200_amd64_deb//file)" "$${root}"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libdbus-1.so.3" "$${out_dir}/libdbus-1.so.3"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libdbus-1.so.3" "$${out_dir}/libdbus-1.so"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libibverbs.so.1" "$${out_dir}/libibverbs.so.1"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libibverbs.so.1" "$${out_dir}/libibverbs.so"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libnl-3.so.200" "$${out_dir}/libnl-3.so.200"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libnl-3.so.200" "$${out_dir}/libnl-3.so"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libnl-route-3.so.200" "$${out_dir}/libnl-route-3.so.200"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libnl-route-3.so.200" "$${out_dir}/libnl-route-3.so"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libpcap.so" "$${out_dir}/libpcap.so"
cp -L "$${root}/usr/lib/x86_64-linux-gnu/libpcap.so.0.8" "$${out_dir}/libpcap.so.0.8"
""",
)

