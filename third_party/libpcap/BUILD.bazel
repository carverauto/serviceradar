        "@ubuntu_noble_libnl_route_3_200_arm64_deb//file",
        "@ubuntu_noble_libpcap0_8_dev_arm64_deb//file",
        "@ubuntu_noble_libpcap0_8t64_arm64_deb//file",
    ],
    outs = [
        "linux_arm64/libdbus-1.so",
        "linux_arm64/libdbus-1.so.3",
        "linux_arm64/libibverbs.so",
        "linux_arm64/libibverbs.so.1",
        "linux_arm64/libnl-3.so",
        "linux_arm64/libnl-3.so.200",
        "linux_arm64/libnl-route-3.so",
        "linux_arm64/libnl-route-3.so.200",
        "linux_arm64/libpcap.so",
        "linux_arm64/libpcap.so.0.8",
    ],
    cmd = """
set -euo pipefail
out_dir="$(@D)/linux_arm64"
root="$(@D)/libpcap_arm64_root"
rm -rf "$${out_dir}" "$${root}"
mkdir -p "$${out_dir}" "$${root}"
dpkg-deb -x "$(location @ubuntu_noble_libpcap0_8_dev_arm64_deb//file)" "$${root}"
dpkg-deb -x "$(location @ubuntu_noble_libpcap0_8t64_arm64_deb//file)" "$${root}"
