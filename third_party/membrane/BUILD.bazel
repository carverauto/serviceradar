"""Precompiled Membrane OS dependencies, pinned in //MODULE.bazel."""

package(default_visibility = ["//visibility:public"])

# The archives Bundlex would otherwise fetch from github.com during `mix deps.compile`.
#
# //build:mix_app.bzl stages these into BUNDLEX_LOCAL_PRECOMPILED_DIR for any package that
# depends on bundlex, and //third_party/patches/bundlex makes Bundlex prefer that directory
# over the network. Matching is by URL basename, so a file only has to be present here for
# the corresponding download to be skipped.
#
# Keep in sync with the `membrane_precompiled_*` http_file rules in //MODULE.bazel: an
# archive declared there but missing here is silently downloaded at build time again.
filegroup(
    name = "precompiled_os_deps",
    srcs = [
        "@membrane_precompiled_fdk_aac//file",
        "@membrane_precompiled_ffmpeg//file",
        "@membrane_precompiled_lame//file",
        "@membrane_precompiled_libvpx//file",
        "@membrane_precompiled_mad//file",
        "@membrane_precompiled_opus//file",
        "@membrane_precompiled_portaudio//file",
        "@membrane_precompiled_sdl2//file",
        "@membrane_precompiled_srt//file",
        "@membrane_precompiled_srtp//file",
    ],
)
