load("@rules_rust//crate_universe:defs.bzl", "crate", "crates_vendor")

# Single locally vendored crate universe that replaces the @rust_crates
# crates.from_cargo splicing extension (openspec: migrate-bazel-rust-crate-vendoring).
#
# Manifest-based (not a curated packages list) so the vendored graph is identical to
# the one resolved by //:Cargo.lock — one prost/tonic/tokio, no duplicate-crate type
# clash. Consumers load //third_party/crates:defs.bzl and keep their existing
# all_crate_deps()/crate_deps([...]) calls unchanged.
#
# Regenerate with: scripts/vendor.sh  (runs the vendor target AND re-applies the
# openssl-src / pq-src source patches, which crates_vendor local mode does not apply).
# Do NOT run `bazel run //third_party:crates_vendor` directly — it leaves those two
# crates unpatched and their from-source C builds will fail.
crates_vendor(
    name = "crates_vendor",
    mode = "local",
    cargo_config = "//:.cargo/config.toml",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    vendor_path = "crates",
    repository_name = "rust_crates",
    annotations = {
        # openssl-sys: perl wrapper + point the build at the vendored openssl-src
        # runfiles/readme. openssl-sys now builds a from-source (vendored) OpenSSL for
        # libpq (pq-sys bundled), so the build is portable. The Cargo.lock version is
        # openssl-src 300.6.1+3.6.3, but crates_vendor sanitizes '+' to '-' in the
        # package path, so the label is openssl-src-300.6.1-3.6.3. Update these labels
        # if that pin changes.
        "openssl-sys": [crate.annotation(
            additive_build_file_content = """
load("@bazel_skylib//rules:write_file.bzl", "write_file")

write_file(
    name = "workspace_perl_tool",
    out = "perl-wrapper.sh",
    content = [
        "#!/usr/bin/env bash",
        "set -euo pipefail",
        'exec perl "$@"',
    ],
    is_executable = True,
)
""",
            build_script_data = [
                ":workspace_perl_tool",
                "//third_party/crates/openssl-src-300.6.1-3.6.3:openssl_src_runfiles",
                "//third_party/crates/openssl-src-300.6.1-3.6.3:openssl_src_readme",
                "//third_party/crates/openssl-src-300.6.1-3.6.3:openssl_src_version_marker",
            ],
            build_script_env = {
                "OPENSSL_SRC_PERL": "$(execpath :workspace_perl_tool)",
                # Absolute $(location) into the vendored openssl/ source. The patched
                # openssl-src source_dir() reads this (a marker file) and uses its
                # parent as the OpenSSL source root — robust against the crate's stale
                # baked CARGO_MANIFEST_DIR under Bazel sandboxing.
                "RULES_RUST_OPENSSL_SRC_DIR": "$(location //third_party/crates/openssl-src-300.6.1-3.6.3:openssl_src_version_marker)",
            },
        )],
        # openssl-src: expose its source tree as filegroups and declare the source
        # patch. NOTE: crates_vendor local mode does NOT apply annotation `patches` to
        # the on-disk vendored source — scripts/vendor.sh re-applies this patch after
        # `bazel run //third_party:crates_vendor`. The declaration is kept here as the
        # source of truth (and would apply on the remote/repository path). The patch
        # fixes source_dir() (stale baked CARGO_MANIFEST_DIR under Bazel) and strips
        # Configure's `-no-canonical-prefixes`. Patch label is repo-absolute.
        "openssl-src": [crate.annotation(
            additive_build_file_content = """
filegroup(
    name = "openssl_src_runfiles",
    srcs = glob(
        allow_empty = True,
        include = ["**"],
        exclude = [
            "**/* *",
            ".tmp_git_root/**/*",
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "WORKSPACE.bazel",
        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "openssl_src_readme",
    srcs = ["README.md"],
    visibility = ["//visibility:public"],
)

# A single stable file INSIDE the openssl/ C-source dir. Its $(location) parent is
# the OpenSSL source root, which the patched source_dir() uses to locate the source.
filegroup(
    name = "openssl_src_version_marker",
    srcs = ["openssl/VERSION.dat"],
    visibility = ["//visibility:public"],
)
""",
            patch_args = ["-p1"],
            # crate.annotation requires patch labels to be repo-absolute (start with @).
            patches = ["@//third_party/rust_patches:openssl_src_runfiles_patch"],
        )],
    },
    tags = ["manual"],
)
