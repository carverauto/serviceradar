"""Declare a whole Hex dependency closure from data, as one module extension.

Upstream rules_erlang offers `hex_archive`, a repository rule, and expects the
root module to call it once per package. That does not scale to an application
closure: an Ash/Phoenix app resolves to a few hundred packages, so MODULE.bazel
grows a couple of thousand lines of generated boilerplate, and every package has
to be named a second time in a `use_repo` call to be visible at all.

`hex_packages_extension` takes the closure as *data* -- typically a generated
list living next to the generated BUILD stubs -- and returns a module extension
that declares one `hex_archive` per package plus a single hub repository of
aliases. The root module then needs two lines:

    hex_ext = use_extension("//third_party/hex:extensions.bzl", "hex")
    use_repo(hex_ext, "hexpm")

and packages are depended on as `@hexpm//:<app>` instead of
`@hex_<app>//:erlang_app`.

Note what does *not* have to change: repositories generated by a single module
extension share a repo mapping and can see each other under the names the
extension gave them. A generated stub inside `@hex_ash` that refers to
`@hex_ecto//:erlang_app` keeps resolving, so only the root module's own labels
move to the hub. Those stubs can equally refer to the module that defines the
extension -- `@serviceradar//third_party/hex_vendored/...` for a shadowed
package -- for the same reason.

This is a factory, not an extension with tags. Tag classes would put the package
list back into MODULE.bazel one `hex.package(...)` block at a time, which is the
problem being solved. Passing the list in Starlark keeps it in a generated file
that a code generator owns end to end.
"""

load("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")
load("//:hex_archive.bzl", "hex_archive")

def hex_pkg(name, version, sha256, build_file, package_name = None):
    """A Hex package to fetch from hex.pm.

    Args:
        name: the OTP application name. Also the hub alias and, prefixed, the
            spoke repository name.
        version: the package version, as in mix.lock.
        sha256: the OUTER tarball checksum -- the last field of a mix.lock
            entry, not the inner one. hex_archive downloads the outer tarball.
        build_file: a `Label` for the BUILD file to overlay on the package.
            Must be a Label, not a string: this is resolved in the repository
            that *calls* the factory, and a bare string would resolve against
            rules_erlang instead of the module holding the stubs.
        package_name: the name on hex.pm, when it differs from the application
            name (`chatterbox` ships as `ts_chatterbox`). Defaults to `name`.

    Returns:
        An opaque struct for `hex_packages_extension`.
    """
    return struct(
        kind = "hex",
        name = name,
        package_name = package_name or name,
        version = version,
        sha256 = sha256,
        build_file = build_file,
    )

def git_pkg(name, remote, commit, build_file, patches = [], patch_args = ["-p1"]):
    """A package pinned from git rather than resolved from hex.pm.

    Mix supports this and mix.lock records it as a non-`:hex` entry, so a
    generator reading the lock cannot produce it. Declaring it here rather than
    directly in MODULE.bazel keeps it inside the same hub namespace, so
    consumers cannot tell -- and need not care -- how a package was obtained.

    Args:
        name: the OTP application name.
        remote: the git remote to clone.
        commit: the full commit SHA to pin.
        build_file: a `Label` for the BUILD file to overlay. See `hex_pkg`.
        patches: labels of patches to apply after checkout.
        patch_args: arguments for the patch tool; git-formatted patches need -p1.

    Returns:
        An opaque struct for `hex_packages_extension`.
    """
    return struct(
        kind = "git",
        name = name,
        remote = remote,
        commit = commit,
        build_file = build_file,
        patches = patches,
        patch_args = patch_args,
    )

def _hub_impl(repository_ctx):
    lines = [
        "# Generated by @rules_erlang//bzlmod:hex_packages.bzl -- do not edit.",
        "#",
        "# One alias per package in the closure. Depending on @hexpm//:<app> rather than",
        "# the spoke repository directly is what keeps the root MODULE.bazel to a single",
        "# use_repo: only this hub has to be exported from the extension.",
        "",
        'package(default_visibility = ["//visibility:public"])',
        "",
    ]
    for app in sorted(repository_ctx.attr.aliases):
        lines.append("alias(")
        lines.append('    name = "{}",'.format(app))
        lines.append('    actual = "@{}//:erlang_app",'.format(repository_ctx.attr.aliases[app]))
        lines.append(")")
        lines.append("")
    repository_ctx.file("BUILD.bazel", "\n".join(lines), executable = False)

_hex_hub = repository_rule(
    implementation = _hub_impl,
    attrs = {
        "aliases": attr.string_dict(
            doc = "application name -> spoke repository name",
        ),
    },
)

def hex_packages_extension(packages = [], hub_name = "hexpm", repo_prefix = "hex_"):
    """Build a module extension declaring every package in `packages`.

    Args:
        packages: `hex_pkg` / `git_pkg` structs, in any order.
        hub_name: name of the generated hub repository. This is the only
            repository the root module has to `use_repo`.
        repo_prefix: prefix for spoke repository names. Generated BUILD stubs
            refer to their siblings by these names, so a generator emitting the
            stubs and the caller of this factory must agree on it.

    Returns:
        A module extension.
    """

    def _impl(module_ctx):
        aliases = {}
        for pkg in packages:
            repo = repo_prefix + pkg.name
            if pkg.name in aliases:
                fail("duplicate package '{}': a Bazel repository name is global, so the ".format(pkg.name) +
                     "closure must already agree on one version per package")
            if pkg.kind == "hex":
                hex_archive(
                    name = repo,
                    package_name = pkg.package_name,
                    version = pkg.version,
                    sha256 = pkg.sha256,
                    build_file = pkg.build_file,
                )
            else:
                git_repository(
                    name = repo,
                    remote = pkg.remote,
                    commit = pkg.commit,
                    build_file = pkg.build_file,
                    patches = pkg.patches,
                    patch_args = pkg.patch_args,
                )
            aliases[pkg.name] = repo

        _hex_hub(name = hub_name, aliases = aliases)

        # Every spoke is content-addressed (sha256, or a pinned commit), so a
        # second evaluation cannot produce a different result. Marking that
        # keeps a few hundred repositories out of MODULE.bazel.lock.
        return module_ctx.extension_metadata(
            root_module_direct_deps = [hub_name],
            root_module_direct_dev_deps = [],
            reproducible = True,
        )

    return module_extension(implementation = _impl)
