load("@serviceradar//build:mix_app.bzl", "mix_app")

package(default_visibility = ["//visibility:public"])

# Generated by scripts/gen_hex_bazel.exs -- do not edit by hand.
#
# A Hex package is a Mix project. Compiling it with Mix -- rather than invoking
# elixirc from the execroot -- is what makes mix.exs (elixirc_paths, :compilers),
# Mix.Project introspection, and cwd-relative compile-time file reads work.
# See //build:mix_app.bzl.
filegroup(
    name = "sources",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
    ),
)

mix_app(
    name = "erlang_app",
    srcs = [":sources"],
    hdrs = glob(
        ["include/**/*.hrl"],
        allow_empty = True,
    ),
    app_name = "ash_admin",
    deps = [
        "@hex_ash//:erlang_app",
        "@hex_ash_phoenix//:erlang_app",
        "@hex_cinder//:erlang_app",
        "@hex_gettext//:erlang_app",
        "@hex_jason//:erlang_app",
        "@hex_phoenix//:erlang_app",
        "@hex_phoenix_html//:erlang_app",
        "@hex_phoenix_live_view//:erlang_app",
        "@hex_phoenix_view//:erlang_app",
        "@rules_elixir//elixir",
    ],
)
