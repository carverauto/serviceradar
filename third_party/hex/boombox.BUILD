load("@serviceradar//build:mix_app.bzl", "mix_app")

package(default_visibility = ["//visibility:public"])

# Generated by scripts/gen_hex_bazel.exs -- do not edit by hand.
#
# A Hex package is a Mix project. Compiling it with Mix -- rather than invoking
# elixirc from the execroot -- is what makes mix.exs (elixirc_paths, :compilers),
# Mix.Project introspection, and cwd-relative compile-time file reads work.
# See //build:mix_app.bzl.
filegroup(
    name = "sources",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
    ),
)

mix_app(
    name = "erlang_app",
    srcs = [":sources"],
    hdrs = glob(
        ["include/**/*.hrl"],
        allow_empty = True,
    ),
    app_name = "boombox",
    deps = [
        "@hex_image//:erlang_app",
        "@hex_membrane_core//:erlang_app",
        "@hex_membrane_ffmpeg_swresample_plugin//:erlang_app",
        "@hex_membrane_ffmpeg_swscale_plugin//:erlang_app",
        "@hex_membrane_http_adaptive_stream_plugin//:erlang_app",
        "@hex_membrane_ivf_plugin//:erlang_app",
        "@hex_membrane_mp4_plugin//:erlang_app",
        "@hex_membrane_ogg_plugin//:erlang_app",
        "@hex_membrane_realtimer_plugin//:erlang_app",
        "@hex_membrane_rtmp_plugin//:erlang_app",
        "@hex_membrane_rtp_aac_plugin//:erlang_app",
        "@hex_membrane_rtp_format//:erlang_app",
        "@hex_membrane_rtp_h264_plugin//:erlang_app",
        "@hex_membrane_rtp_h265_plugin//:erlang_app",
        "@hex_membrane_rtp_opus_plugin//:erlang_app",
        "@hex_membrane_rtp_plugin//:erlang_app",
        "@hex_membrane_rtsp_plugin//:erlang_app",
        "@hex_membrane_srt_plugin//:erlang_app",
        "@hex_membrane_stream_plugin//:erlang_app",
        "@hex_membrane_transcoder_plugin//:erlang_app",
        "@hex_membrane_vpx_plugin//:erlang_app",
        "@hex_membrane_wav_plugin//:erlang_app",
        "@hex_membrane_webrtc_plugin//:erlang_app",
        "@rules_elixir//elixir",
    ],
)
