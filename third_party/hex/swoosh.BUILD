load("@serviceradar//build:mix_app.bzl", "mix_app")

package(default_visibility = ["//visibility:public"])

# Generated by scripts/gen_hex_bazel.exs -- do not edit by hand.
#
# A Hex package is a Mix project. Compiling it with Mix -- rather than invoking
# elixirc from the execroot -- is what makes mix.exs (elixirc_paths, :compilers),
# Mix.Project introspection, and cwd-relative compile-time file reads work.
# See //build:mix_app.bzl.
filegroup(
    name = "sources",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
    ),
)

mix_app(
    name = "erlang_app",
    srcs = [":sources"],
    hdrs = glob(
        ["include/**/*.hrl"],
        allow_empty = True,
    ),
    app_name = "swoosh",
    deps = [
        "@hex_bandit//:erlang_app",
        "@hex_cowboy//:erlang_app",
        "@hex_finch//:erlang_app",
        "@hex_gen_smtp//:erlang_app",
        "@hex_idna//:erlang_app",
        "@hex_jason//:erlang_app",
        "@hex_mime//:erlang_app",
        "@hex_plug//:erlang_app",
        "@hex_req//:erlang_app",
        "@hex_telemetry//:erlang_app",
        "@rules_elixir//elixir",
    ],
)
