load("@rules_elixir//:mix_app.bzl", "mix_app")
load("@serviceradar//build:hex_compile_env.bzl", "HEX_COMPILE_ENV_CONFIG")

package(default_visibility = ["//visibility:public"])

# Generated by //third_party/hex:stubs -- do not edit by hand.
#
# A Hex package is a Mix project. Compiling it with Mix rather than invoking elixirc from the
# execroot is what makes mix.exs (elixirc_paths, :compilers), Mix.Project introspection, and
# cwd-relative compile-time file reads work.
filegroup(
    name = "sources",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
    ),
)

mix_app(
    name = "erlang_app",
    app_name = "ash_ai",
    srcs = [":sources"],
    hdrs = glob(
        ["include/**/*.hrl"],
        allow_empty = True,
    ),
    extra_config = HEX_COMPILE_ENV_CONFIG,
    deps = [
        "@hex_ash//:erlang_app",
        "@hex_ash_json_api//:erlang_app",
        "@hex_ash_oban//:erlang_app",
        "@hex_ash_phoenix//:erlang_app",
        "@hex_ash_postgres//:erlang_app",
        "@hex_igniter//:erlang_app",
        "@hex_open_api_spex//:erlang_app",
        "@hex_plug//:erlang_app",
        "@hex_req_llm//:erlang_app",
        "@rules_elixir//elixir",
    ],
)
