load("@serviceradar//build:mix_app.bzl", "mix_app")

package(default_visibility = ["//visibility:public"])

# Generated by scripts/gen_hex_bazel.exs -- do not edit by hand.
#
# A Hex package is a Mix project. Compiling it with Mix -- rather than invoking
# elixirc from the execroot -- is what makes mix.exs (elixirc_paths, :compilers),
# Mix.Project introspection, and cwd-relative compile-time file reads work.
# See //build:mix_app.bzl.
filegroup(
    name = "sources",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
    ),
)

mix_app(
    name = "erlang_app",
    srcs = [":sources"],
    hdrs = glob(
        ["include/**/*.hrl"],
        allow_empty = True,
    ),
    app_name = "membrane_transcoder_plugin",
    deps = [
        "@hex_membrane_aac_fdk_plugin//:erlang_app",
        "@hex_membrane_aac_format//:erlang_app",
        "@hex_membrane_aac_plugin//:erlang_app",
        "@hex_membrane_core//:erlang_app",
        "@hex_membrane_ffmpeg_swresample_plugin//:erlang_app",
        "@hex_membrane_ffmpeg_swscale_plugin//:erlang_app",
        "@hex_membrane_funnel_plugin//:erlang_app",
        "@hex_membrane_h264_ffmpeg_plugin//:erlang_app",
        "@hex_membrane_h264_format//:erlang_app",
        "@hex_membrane_h265_ffmpeg_plugin//:erlang_app",
        "@hex_membrane_h265_format//:erlang_app",
        "@hex_membrane_h26x_plugin//:erlang_app",
        "@hex_membrane_mp3_lame_plugin//:erlang_app",
        "@hex_membrane_mp3_mad_plugin//:erlang_app",
        "@hex_membrane_mpegaudio_format//:erlang_app",
        "@hex_membrane_opus_format//:erlang_app",
        "@hex_membrane_opus_plugin//:erlang_app",
        "@hex_membrane_timestamp_queue//:erlang_app",
        "@hex_membrane_vp8_format//:erlang_app",
        "@hex_membrane_vpx_plugin//:erlang_app",
        "@rules_elixir//elixir",
    ],
)
