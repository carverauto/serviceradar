load("@serviceradar//build:mix_app.bzl", "mix_app")

package(default_visibility = ["//visibility:public"])

# Generated by scripts/gen_hex_bazel.exs -- do not edit by hand.
#
# A Hex package is a Mix project. Compiling it with Mix -- rather than invoking
# elixirc from the execroot -- is what makes mix.exs (elixirc_paths, :compilers),
# Mix.Project introspection, and cwd-relative compile-time file reads work.
# See //build:mix_app.bzl.
filegroup(
    name = "sources",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
    ),
)

mix_app(
    name = "erlang_app",
    srcs = [":sources"],
    hdrs = glob(
        ["include/**/*.hrl"],
        allow_empty = True,
    ),
    app_name = "membrane_rtsp_plugin",
    deps = [
        "@hex_ex_sdp//:erlang_app",
        "@hex_membrane_aac_plugin//:erlang_app",
        "@hex_membrane_core//:erlang_app",
        "@hex_membrane_h26x_plugin//:erlang_app",
        "@hex_membrane_rtp_aac_plugin//:erlang_app",
        "@hex_membrane_rtp_h264_plugin//:erlang_app",
        "@hex_membrane_rtp_h265_plugin//:erlang_app",
        "@hex_membrane_rtp_opus_plugin//:erlang_app",
        "@hex_membrane_rtp_plugin//:erlang_app",
        "@hex_membrane_rtsp//:erlang_app",
        "@hex_membrane_tcp_plugin//:erlang_app",
        "@hex_membrane_udp_plugin//:erlang_app",
        "@rules_elixir//elixir",
    ],
)
