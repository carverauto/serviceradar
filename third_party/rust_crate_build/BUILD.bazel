"""BUILD snippets appended to generated crate packages.

These used to be `additive_build_file_content` string blobs inside crate.annotation tags
in //MODULE.bazel. As files they are reviewable as Bazel code rather than as an escaped
string, and -- the reason they moved -- `additive_build_file` takes a LABEL, which a
Cargo.toml annotation can carry. The content form could not leave MODULE.bazel.
"""

package(default_visibility = ["//visibility:public"])

exports_files(["openssl_src_additive.BUILD"])
