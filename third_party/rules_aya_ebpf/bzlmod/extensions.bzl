"""Fetch the pinned toolchain inputs and declare the toolchains over them.

Three things have to agree for an aya eBPF build to work, and all three are
pinned here by version + sha256:

  * a **nightly** rustc/cargo -- `-Z build-std` is nightly-only;
  * the **rust-src** component -- `bpfel-unknown-none` is tier 3 and ships no
    precompiled `core`, so build-std compiles it from source;
  * **bpf-linker** -- the LLVM-based linker that emits BPF bytecode and BTF.
    Upstream's release binaries statically bundle LLVM, which is what lets this
    be a single pinned file instead of a hermetic LLVM toolchain.

The nightly date is not a free choice: it has to be one that compiles the aya
version in use. Bumping it also means re-vendoring, because `-Z build-std`
resolves the std workspace's own crates.io dependencies alongside the program's.
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# nightly-2026-08-05 is rustc 1.99.0-nightly (1ed2df61a), on **LLVM 22.1.8**.
#
# That LLVM major is the binding constraint, not the date. bpf-linker consumes the
# bitcode rustc emits, and LLVM bitcode is backward- but not forward-compatible, so
# rustc's LLVM must not exceed bpf-linker's. bpf-linker 0.10.4 bundles LLVM 22.1.7.
#
# rust-lang/rust#158734 moved rustc to LLVM 23 on 2026-08-05, so this is the LAST
# nightly that can be used until bpf-linker ships an LLVM 23 build. Do not bump the
# date past it on the assumption that newer is better: nightly-2026-08-08 is LLVM
# 23.1.0 and fails to link.
DEFAULT_NIGHTLY_DATE = "2026-08-05"

# rustup-dist component archives for the execution platform, plus the
# arch-independent sources. Validated together against aya-ebpf 0.1.1.
DEFAULT_NIGHTLY_COMPONENTS = {
    "rustc": "a20c82439bff4a21873e88b6a14d836285ba79a4e9196d602af2b4ff1ddf2c8b",
    "cargo": "fe5f7e032778e3ecb543c23a254f2862a5ce2682daff281fdaeb6fd0f2c02d5c",
    # Host std, needed to compile proc-macro crates such as aya-ebpf-macros.
    "rust_std": "d1fa3abf0ba340bd055a6de89786a3b9510bb5ab43efe433836b21d729a52c44",
    "rust_src": "b03bfe0cc73b77d00e57cdfe895fa1bbcb0b6cfad236eaae4294ebe55aca6526",
}

DEFAULT_BPF_LINKER_VERSION = "0.10.4"

DEFAULT_BPF_LINKER_SHA256 = "4dda77daab6c5f120a468e6d3ede2498f5bd47ece712172cfb7290176d93d015"

# 0.10.4 ported its own build to Bazel, split debuginfo into a separate asset, and
# switched the release archives from .tar.gz to .tar.zst. Overridable so pinning an
# older bpf-linker stays possible.
DEFAULT_BPF_LINKER_ARCHIVE_EXTENSION = "tar.zst"

# Only linux-x86_64 is wired up today. Upstream publishes darwin builds of every
# input (rustup-dist components and bpf-linker alike), so adding a platform is
# adding a row here plus its sha256s -- the rules and the object are unchanged,
# because compiling for bpfel is cross-compilation from wherever you happen to be.
_EXEC_PLATFORMS = {
    "linux_x86_64": struct(
        rust_triple = "x86_64-unknown-linux-gnu",
        bpf_linker_triple = "x86_64-unknown-linux-musl",
        constraints = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    ),
}

_COMPONENT_BUILD_FILE = """\
package(default_visibility = ["//visibility:public"])

exports_files(["install.sh"])

filegroup(
    name = "all",
    srcs = glob(["**"]),
)
"""

_BPF_LINKER_BUILD_FILE = """\
package(default_visibility = ["//visibility:public"])

exports_files(["bpf-linker"])
"""

def _component_repo_name(platform, component):
    return "aya_ebpf_{}_{}".format(platform, component)

def _hub_build_file(platforms):
    lines = [
        "# Generated by @rules_aya_ebpf//bzlmod:extensions.bzl -- do not edit.",
        "",
        'load("@rules_aya_ebpf//:toolchain.bzl", "aya_ebpf_toolchain")',
        "",
        'package(default_visibility = ["//visibility:public"])',
        "",
    ]
    for name in sorted(platforms):
        platform = _EXEC_PLATFORMS[name]
        installers = ", ".join([
            '"@{}//:install.sh"'.format(_component_repo_name(name, component))
            for component in ["rustc", "cargo", "rust_std", "rust_src"]
        ])
        components = ", ".join([
            '"@{}//:all"'.format(_component_repo_name(name, component))
            for component in ["rustc", "cargo", "rust_std", "rust_src"]
        ])
        lines += [
            "aya_ebpf_toolchain(",
            '    name = "{}_toolchain",'.format(name),
            "    installers = [{}],".format(installers),
            "    components = [{}],".format(components),
            '    bpf_linker = "@{}//:bpf-linker",'.format(_component_repo_name(name, "bpf_linker")),
            '    host_triple = "{}",'.format(platform.rust_triple),
            ")",
            "",
            "toolchain(",
            '    name = "{}",'.format(name),
            # Constrains the EXECUTION platform: these are the machines whose
            # binaries these are. The target platform is unconstrained -- the
            # emitted object is bpfel bytecode either way.
            "    exec_compatible_with = [{}],".format(
                ", ".join(['"{}"'.format(c) for c in platform.constraints]),
            ),
            '    toolchain = ":{}_toolchain",'.format(name),
            '    toolchain_type = "@rules_aya_ebpf//:toolchain_type",',
            ")",
            "",
        ]
    return "\n".join(lines)

def _hub_impl(repository_ctx):
    repository_ctx.file(
        "BUILD.bazel",
        _hub_build_file(repository_ctx.attr.platforms),
        executable = False,
    )

_hub = repository_rule(
    implementation = _hub_impl,
    attrs = {"platforms": attr.string_list()},
)

def _impl(module_ctx):
    nightly_date = DEFAULT_NIGHTLY_DATE
    components = dict(DEFAULT_NIGHTLY_COMPONENTS)
    bpf_linker_version = DEFAULT_BPF_LINKER_VERSION
    bpf_linker_sha256 = DEFAULT_BPF_LINKER_SHA256
    bpf_linker_extension = DEFAULT_BPF_LINKER_ARCHIVE_EXTENSION

    # Last tag wins and the root module is evaluated last, so a consumer can move
    # the pins without every module in the graph having to agree.
    for mod in module_ctx.modules:
        for tag in mod.tags.nightly:
            nightly_date = tag.date
            components = {
                "rustc": tag.rustc_sha256,
                "cargo": tag.cargo_sha256,
                "rust_std": tag.rust_std_sha256,
                "rust_src": tag.rust_src_sha256,
            }
        for tag in mod.tags.bpf_linker:
            bpf_linker_version = tag.version
            bpf_linker_sha256 = tag.sha256
            bpf_linker_extension = tag.archive_extension

    for name in _EXEC_PLATFORMS:
        platform = _EXEC_PLATFORMS[name]
        for component in ["rustc", "cargo", "rust_std"]:
            archive = "{}-nightly-{}".format(
                component.replace("_", "-"),
                platform.rust_triple,
            )
            http_archive(
                name = _component_repo_name(name, component),
                build_file_content = _COMPONENT_BUILD_FILE,
                sha256 = components[component],
                strip_prefix = archive,
                urls = ["https://static.rust-lang.org/dist/{}/{}.tar.xz".format(nightly_date, archive)],
            )

        # rust-src carries no target triple: it is the std sources.
        http_archive(
            name = _component_repo_name(name, "rust_src"),
            build_file_content = _COMPONENT_BUILD_FILE,
            sha256 = components["rust_src"],
            strip_prefix = "rust-src-nightly",
            urls = ["https://static.rust-lang.org/dist/{}/rust-src-nightly.tar.xz".format(nightly_date)],
        )

        http_archive(
            name = _component_repo_name(name, "bpf_linker"),
            build_file_content = _BPF_LINKER_BUILD_FILE,
            sha256 = bpf_linker_sha256,
            urls = ["https://github.com/aya-rs/bpf-linker/releases/download/v{}/bpf-linker-{}.{}".format(
                bpf_linker_version,
                platform.bpf_linker_triple,
                bpf_linker_extension,
            )],
        )

    _hub(name = "aya_ebpf_toolchains", platforms = _EXEC_PLATFORMS.keys())

    return module_ctx.extension_metadata(
        root_module_direct_deps = ["aya_ebpf_toolchains"],
        root_module_direct_dev_deps = [],
        reproducible = True,
    )

nightly = tag_class(attrs = {
    "date": attr.string(default = DEFAULT_NIGHTLY_DATE),
    "rustc_sha256": attr.string(default = DEFAULT_NIGHTLY_COMPONENTS["rustc"]),
    "cargo_sha256": attr.string(default = DEFAULT_NIGHTLY_COMPONENTS["cargo"]),
    "rust_std_sha256": attr.string(default = DEFAULT_NIGHTLY_COMPONENTS["rust_std"]),
    "rust_src_sha256": attr.string(default = DEFAULT_NIGHTLY_COMPONENTS["rust_src"]),
})

bpf_linker = tag_class(attrs = {
    "version": attr.string(default = DEFAULT_BPF_LINKER_VERSION),
    "sha256": attr.string(default = DEFAULT_BPF_LINKER_SHA256),
    "archive_extension": attr.string(default = DEFAULT_BPF_LINKER_ARCHIVE_EXTENSION),
})

aya_ebpf = module_extension(
    implementation = _impl,
    tag_classes = {
        "nightly": nightly,
        "bpf_linker": bpf_linker,
    },
)
