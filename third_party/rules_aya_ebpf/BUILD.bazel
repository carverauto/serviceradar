load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# The toolchain that can build an aya eBPF program: a nightly Rust toolchain
# with the std sources, plus a bpf-linker.
#
# Resolution happens on the EXECUTION platform, not the target platform. That
# distinction is the whole reason this is a toolchain: the object is always a
# Linux kernel artifact, but the machine that compiles it need not be Linux --
# building for `bpfel-unknown-none` is cross-compilation, and upstream publishes
# every input for darwin as well. Register a darwin toolchain and a Mac builds
# the same object.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "ebpf_object",
    srcs = ["ebpf_object.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//private:ebpf_object"],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//private:toolchain"],
)
