module(
    name = "rules_aya_ebpf",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.10")

# The pinned toolchain is an implementation detail of the ruleset: a consumer
# writes `bazel_dep(name = "rules_aya_ebpf")` and calls `ebpf_object(...)`, and
# never has to know that building an aya program needs a nightly rustc, the
# std sources, and a specific LLVM-bundling linker.
#
# Override the pins from the root module with the same tag classes; the root
# module's tags are evaluated last and win.
aya_ebpf = use_extension("//bzlmod:extensions.bzl", "aya_ebpf")
use_repo(aya_ebpf, "aya_ebpf_toolchains")

register_toolchains("@aya_ebpf_toolchains//:all")
