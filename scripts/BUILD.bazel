sh_test(
    name = "release_publish_contracts_test",
    timeout = "short",
    srcs = ["test-release-publish-contracts.sh"],
    data = [
        "check-oci-chart-version-available.sh",
        "cosign_common.sh",
        "cut-release.sh",
        "prune-forgejo-releases.sh",
        "sign-oci-publish.sh",
        "upload-forgejo-release-asset.sh",
        "validate-release-metadata.sh",
        "validate-release-tag.sh",
        "verify-oci-publish.sh",
        "//:.github/workflows/image-security.yml",
        "//:.github/workflows/native-addons.yml",
        "//:.github/workflows/release.yml",
        "//:.github/workflows/source-security.yml",
        "//:.github/workflows/wasm-plugins.yml",
        "//docker/images:image_inventory.bzl",
        "//:k8s/argocd/applications/demo-prod.yaml",
        # Read by the RELEASE_PACKAGES assertions added in 3fd5eac58. The script resolves
        # them through runfiles, so a test only sees them if they are declared here.
        "//build/packaging:packages.bzl",
        "//build/packaging:release_targets.bzl",
    ],
    # `manual` keeps this out of the //... unit sweep. It is not a unit test: it makes
    # literal substring assertions over CI configuration (5 GitHub workflow YAMLs, 9
    # release shell scripts, the image inventory, the ArgoCD app) and exercises no shipped
    # code path. Keep it `manual` after changing a publish workflow. Run it explicitly:
    #
    #   bazel test //scripts:release_publish_contracts_test --test_tag_filters=
    tags = ["manual"],
)

