load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

go_binary(
    name = "bazel-reclaim",
    embed = [":bazel-reclaim_lib"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "bazel-reclaim_lib",
    srcs = [
        "main.go",
        "reclaim.go",
    ],
    importpath = "github.com/carverauto/serviceradar/go/cmd/tools/bazel-reclaim",
    visibility = ["//visibility:private"],
)

go_test(
    name = "bazel-reclaim_test",
    srcs = ["reclaim_test.go"],
    embed = [":bazel-reclaim_lib"],
)

sh_test(
    name = "cli_test",
    timeout = "short",
    srcs = ["cli_test.sh"],
    args = ["$(rootpath :bazel-reclaim)"],
    data = [":bazel-reclaim"],
)
