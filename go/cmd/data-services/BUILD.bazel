load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "data_services_lib",
    srcs = ["main.go"],
    embedsrcs = ["config.json"],
    importpath = "github.com/carverauto/serviceradar/go/cmd/data-services",
    visibility = ["//visibility:private"],
    deps = [
        "//go/pkg/config",
        "//go/pkg/config/bootstrap",
        "//go/pkg/datasvc",
        "//go/pkg/lifecycle",
        "//go/pkg/nats/accounts",
        "//proto",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//stats",
    ],
)

go_binary(
    name = "data_services",
    embed = [":data_services_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "data_services_test",
    srcs = ["main_test.go"],
    embed = [":data_services_lib"],
    deps = [
        "//go/pkg/datasvc",
        "//go/pkg/lifecycle",
        "//go/pkg/models",
        "//proto",
        "@com_github_nats_io_nats_server_v2//server",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//status",
    ],
)
