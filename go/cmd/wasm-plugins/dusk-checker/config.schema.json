{
  "type": "object",
  "properties": {
    "node_address": {
      "type": "string",
      "description": "Dusk node RUES endpoint (for example localhost:8080)"
    },
    "timeout": {
      "type": "string",
      "description": "Total check timeout duration, capped at 8s to stay below the 10s Wasm plugin deadline",
      "default": "8s"
    },
    "websocket_path": {
      "type": "string",
      "description": "RUES WebSocket path",
      "default": "/on"
    },
    "subscription_path": {
      "type": "string",
      "description": "RUES accepted-block subscription path",
      "default": "/on/blocks/accepted"
    }
  },
  "required": [
    "node_address"
  ]
}
