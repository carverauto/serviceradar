{
  "id": "com.carverauto.axis_camera.event_log.display",
  "version": "1.0.0",
  "schema_id": "com.carverauto.axis_camera.event_log",
  "schema_version": "1.0.0",
  "widgets": [
    {
      "type": "summary",
      "title": "message",
      "message": "unmapped.axis_ws_payload.params.notification.topic",
      "source": "log_provider",
      "severity": "severity"
    },
    {
      "type": "badges",
      "fields": [
        { "label": "Provider", "path": "log_provider" },
        { "label": "Log", "path": "log_name" },
        { "label": "Severity", "path": "severity", "tone": "severity" }
      ]
    },
    {
      "type": "facts",
      "fields": [
        { "label": "Time", "path": "time" },
        { "label": "Topic", "path": "unmapped.axis_ws_payload.params.notification.topic" },
        { "label": "Source", "path": "unmapped.axis_ws_payload.params.notification.source" }
      ]
    },
    {
      "type": "timeline",
      "fields": [
        { "label": "Event time", "path": "time" },
        { "label": "Logged time", "path": "metadata.logged_time" }
      ]
    },
    {
      "type": "json_section",
      "title": "AXIS payload",
      "paths": ["unmapped.axis_ws_payload"]
    }
  ]
}
