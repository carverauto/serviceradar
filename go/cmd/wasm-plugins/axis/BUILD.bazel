# gazelle:ignore
#
# This is a TinyGo plugin in its own Go module, compiled to wasip1 by
# //build/wasm_plugins, not by rules_go. Gazelle has no rules_go targets to generate
# here. The plugin SDK is github.com/carverauto/serviceradar-sdk-go v0.3.0.
package(default_visibility = ["//visibility:public"])

exports_files([
    "EXTRACTION_MANIFEST.md",
    "config.schema.json",
    "config.stream.schema.json",
    "display/event_log_activity.display.json",
    "main.go",
    "plugin.stream.yaml",
    "plugin.yaml",
    "schemas/ocsf_event_log_activity.schema.json",
])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = ["dist/**"],
    ),
)
