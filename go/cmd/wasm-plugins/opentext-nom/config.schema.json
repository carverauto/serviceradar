{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["instance_id", "api_url"],
  "properties": {
    "instance_id": {
      "type": "string",
      "title": "OpenText NOM instance ID",
      "description": "Stable identifier for this OpenText Network Operations Management installation.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nnm_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "title": "NNMi origin URL",
      "description": "Optional NNMi HTTPS origin used when OpenText NOM Network Automation is integrated with NNMi. The plugin requests the OAuth token from this host. Omit it to authenticate directly to Network Automation."
    },
    "token_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "title": "OAuth token URL",
      "description": "Optional explicit OAuth password-grant endpoint. When omitted, the plugin derives it from nnm_url (NNMi integration) or api_url (standalone Network Automation)."
    },
    "l2_endpoints": {
      "type": "array",
      "maxItems": 5000,
      "title": "NNMi L2 endpoints",
      "description": "Optional ServiceRadar endpoint MAC/IP values for NNMi attached-switch-port lookup. Ignored when nnm_url is omitted. Never populated from Network Automation switch inventory.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mac": {"type": "string"},
          "ip": {"type": "string"}
        }
      }
    },
    "api_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "title": "Automation wrapper URL",
      "description": "Operator-owned OpenText Network Automation wrapper endpoint."
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "default": [
        {
          "name": "switches",
          "parameters": {"type": "Switch"}
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "parameters"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "parameters": {
            "$ref": "#/$defs/queryParameters"
          }
        }
      }
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000,
      "default": 1000
    },
    "max_rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "default": 25000
    },
    "max_result_bytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 12582912,
      "default": 10485760
    },
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 30
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "default": 2
    },
    "insecure_skip_verify": {
      "type": "boolean",
      "default": false,
      "title": "Skip TLS verification",
      "description": "Disable TLS certificate verification for Network Automation and NNMi. Use only when those hosts present untrusted certificates on a network path you already trust. Off by default."
    }
  },
  "$defs": {
    "queryParameters": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": false,
      "properties": {
        "software": {"type": "string", "minLength": 1, "maxLength": 512},
        "vendor": {"type": "string", "minLength": 1, "maxLength": 512},
        "type": {"type": "string", "minLength": 1, "maxLength": 512},
        "model": {"type": "string", "minLength": 1, "maxLength": 512},
        "family": {"type": "string", "minLength": 1, "maxLength": 512},
        "group": {"type": "string", "minLength": 1, "maxLength": 512},
        "hierarchy": {"type": "string", "minLength": 1, "maxLength": 512},
        "host": {"type": "string", "minLength": 1, "maxLength": 512},
        "ip": {"type": "string", "minLength": 1, "maxLength": 512},
        "realm": {"type": "string", "minLength": 1, "maxLength": 512},
        "vtpdomain": {"type": "string", "minLength": 1, "maxLength": 512},
        "disabled": {"type": "boolean"},
        "pollexcluded": {"type": "boolean"},
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "context": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "dependentRequired": {
        "context": ["ip"]
      }
    }
  }
}
