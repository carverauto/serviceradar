# gazelle:ignore
#
# This TinyGo plugin is compiled to wasip1 by //build/wasm_plugins. The focused
# rules_go target below only guards the emitted signal-schema contract.
load("@io_bazel_rules_go//go:def.bzl", "go_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "config.console.schema.json",
    "config.schema.json",
    "display/resource_event.display.json",
    "main.go",
    "plugin.console.yaml",
    "plugin.yaml",
    "schemas/ocsf_event_log_activity.schema.json",
])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "dist/**",
            "manifest.json",
        ],
    ),
)

go_test(
    name = "signal_schema_test",
    srcs = [
        "signal_schema.go",
        "signal_schema_test.go",
    ],
    data = [
        "display/resource_event.display.json",
        "plugin.yaml",
    ],
    deps = ["//build/wasm_plugins/testsdk:sdk"],
)
