{
  "id": "com.carverauto.proxmox.resource_event.display",
  "version": "1.1.0",
  "schema_id": "com.carverauto.proxmox.resource_event",
  "schema_version": "1.0.0",
  "widgets": [
    {
      "type": "summary",
      "title": "message",
      "message": "unmapped.condition_key",
      "source": "log_provider",
      "severity": "severity"
    },
    {
      "type": "badges",
      "fields": [
        { "label": "Provider", "path": "log_provider" },
        { "label": "Condition", "path": "unmapped.condition_key" },
        { "label": "Level", "path": "unmapped.level" },
        { "label": "Severity", "path": "severity", "tone": "severity" }
      ]
    },
    {
      "type": "facts",
      "fields": [
        { "label": "Time", "path": "time", "format": "timestamp" },
        { "label": "Condition", "path": "unmapped.condition_key" },
        { "label": "Message", "path": "message" }
      ]
    },
    {
      "type": "timeline",
      "fields": [
        { "label": "Event time", "path": "time", "format": "timestamp" },
        { "label": "Logged time", "path": "metadata.logged_time", "format": "timestamp" }
      ]
    },
    {
      "type": "json_section",
      "title": "Proxmox metadata",
      "paths": ["metadata", "unmapped"]
    }
  ]
}
