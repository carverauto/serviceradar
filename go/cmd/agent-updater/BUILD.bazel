load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "agent_updater_lib",
    srcs = ["main.go"],
    importpath = "github.com/carverauto/serviceradar/go/cmd/agent-updater",
    visibility = ["//visibility:private"],
    deps = [
        "//go/pkg/agent",
        "//go/pkg/agent/addon",
        "//go/pkg/agent/updaterflags",
    ],
)

go_binary(
    name = "agent_updater",
    embed = [":agent_updater_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "agent_updater_test",
    srcs = ["main_test.go"],
    embed = [":agent_updater_lib"],
    deps = [
        "//go/pkg/agent/updaterflags",
    ],
)
