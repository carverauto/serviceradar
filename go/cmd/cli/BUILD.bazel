load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cli_lib",
    srcs = ["main.go"],
    importpath = "github.com/carverauto/serviceradar/go/cmd/cli",
    visibility = ["//visibility:private"],
    deps = ["//go/pkg/cli"],
)

go_binary(
    name = "srctl",
    embed = [":cli_lib"],
    visibility = ["//visibility:public"],
)

# srctl for the macOS agent installer. Pure Go, so it cross-compiles on the Linux
# executors; the installer signs it with the agent's Developer ID.
go_binary(
    name = "srctl_darwin_arm64",
    embed = [":cli_lib"],
    goarch = "arm64",
    goos = "darwin",
    pure = "on",
    visibility = ["//visibility:public"],
)
