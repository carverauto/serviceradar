load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cli_lib",
    srcs = ["main.go"],
    importpath = "github.com/carverauto/serviceradar/go/cmd/cli",
    visibility = ["//visibility:private"],
    deps = ["//go/pkg/cli"],
)

go_binary(
    name = "srctl",
    embed = [":cli_lib"],
    visibility = ["//visibility:public"],
)

# Deprecated alias for the pre-rename target label. Remove after the
# serviceradar-cli compatibility symlink window closes (see #4260).
alias(
    name = "cli",
    actual = ":srctl",
    visibility = ["//visibility:public"],
)
