load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "serviceradar-advisory-producer_lib",
    srcs = ["main.go"],
    importpath = "github.com/carverauto/serviceradar/go/cmd/serviceradar-advisory-producer",
    visibility = ["//visibility:private"],
    deps = [
        "//go/pkg/addon",
        "//go/pkg/addon/sdk",
    ],
)

go_binary(
    name = "serviceradar-advisory-producer",
    embed = [":serviceradar-advisory-producer_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "serviceradar-advisory-producer_test",
    srcs = ["main_test.go"],
    embed = [":serviceradar-advisory-producer_lib"],
    deps = ["//go/pkg/addon"],
)
