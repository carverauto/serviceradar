load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@serviceradar_version//:defs.bzl", "FULL_VERSION")

go_library(
    name = "agent_lib",
    srcs = ["main.go"],
    embedsrcs = ["config.json"],
    importpath = "github.com/carverauto/serviceradar/go/cmd/agent",
    visibility = ["//visibility:private"],
    deps = [
        "//go/pkg/agent",
        "//go/pkg/agentgateway",
        "//go/pkg/lifecycle",
        "//go/pkg/logger",
    ],
)

go_binary(
    name = "agent",
    embed = [":agent_lib"],
    visibility = ["//visibility:public"],
    # FULL_VERSION below is NOT a stamp key. It is a Starlark constant from @serviceradar_version,
    # a repository rule that reads the //VERSION source file.
    x_defs = {
        "github.com/carverauto/serviceradar/go/cmd/agent.Version": FULL_VERSION,
    },
)

go_test(
    name = "agent_test",
    srcs = ["main_test.go"],
    data = [":agent"],
    embed = [":agent_lib"],
    env = {
        "SERVICERADAR_TEST_AGENT_BINARY": "$(rootpath :agent)",
        "SERVICERADAR_TEST_AGENT_VERSION": FULL_VERSION,
    },
)

# Windows agent binaries. Pure Go so they cross-compile from the Linux RBE
# executors without a Windows SDK; the goos/goarch transition keeps them
# buildable from any host.
[
    go_binary(
        name = "agent_windows_{}".format(arch),
        embed = [":agent_lib"],
        goarch = arch,
        goos = "windows",
        pure = "on",
        visibility = ["//visibility:public"],
        x_defs = {
            "github.com/carverauto/serviceradar/go/cmd/agent.Version": FULL_VERSION,
        },
    )
    for arch in ("amd64", "arm64")
]

# The signed macOS installer needs the native Apple Silicon telemetry backend.
# This must override the workspace pure-Go default and build against a Darwin SDK.
# The goos/goarch transition makes this target Darwin-compatible even when a
# Linux wildcard build selects it. Native package CI requests it explicitly.
go_binary(
    name = "agent_darwin_arm64",
    embed = [":agent_lib"],
    goarch = "arm64",
    goos = "darwin",
    pure = "off",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
    x_defs = {
        "github.com/carverauto/serviceradar/go/cmd/agent.Version": FULL_VERSION,
    },
)
