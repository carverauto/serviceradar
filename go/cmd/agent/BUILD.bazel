load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@serviceradar_version//:defs.bzl", "FULL_VERSION")

go_library(
    name = "agent_lib",
    srcs = [
        "edge_record_sender.go",
        "main.go",
    ],
    embedsrcs = ["config.json"],
    importpath = "github.com/carverauto/serviceradar/go/cmd/agent",
    visibility = ["//visibility:private"],
    deps = [
        "//go/pkg/agent",
        "//go/pkg/agentgateway",
        "//go/pkg/edge/sender",
        "//go/pkg/edge/spool",
        "//go/pkg/grpc",
        "//go/pkg/lifecycle",
        "//go/pkg/logger",
        "//proto/edge/v1:edgev1",
    ],
)

go_binary(
    name = "agent",
    embed = [":agent_lib"],
    visibility = ["//visibility:public"],
    # FULL_VERSION below is NOT a stamp key. It is a Starlark constant from @serviceradar_version,
    # a repository rule that reads the //VERSION source file.
    x_defs = {
        "github.com/carverauto/serviceradar/go/cmd/agent.Version": FULL_VERSION,
    },
)

go_test(
    name = "agent_test",
    srcs = [
        "edge_record_sender_test.go",
        "main_test.go",
    ],
    data = [":agent"],
    embed = [":agent_lib"],
    env = {
        "SERVICERADAR_TEST_AGENT_BINARY": "$(rootpath :agent)",
        "SERVICERADAR_TEST_AGENT_VERSION": FULL_VERSION,
    },
    deps = [
        "//go/pkg/agent",
        "//go/pkg/logger",
    ],
)
