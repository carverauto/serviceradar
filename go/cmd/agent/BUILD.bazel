load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@serviceradar_version//:defs.bzl", "FULL_VERSION")

go_library(
    name = "agent_lib",
    srcs = ["main.go"],
    embedsrcs = ["config.json"],
    importpath = "github.com/carverauto/serviceradar/go/cmd/agent",
    visibility = ["//visibility:private"],
    deps = [
        "//go/pkg/agent:agent",
        "//go/pkg/agentgateway:agentgateway",
        "//go/pkg/config:config",
        "//go/pkg/config/bootstrap:bootstrap",
        "//go/pkg/edgeonboarding:edgeonboarding",
        "//go/pkg/lifecycle:lifecycle",
        "//go/pkg/logger:logger",
        "//go/pkg/models:models",
        "//proto",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "agent",
    embed = [":agent_lib"],
    # GoLink of the agent is large under pure-Go linking. After #4752 switched
    # BuildBuddy executors to Firecracker isolation, default microVM memory
    # (~2.5Gi) OOMs the linker (signal: killed). Ask for a larger task size.
    exec_properties = {
        "EstimatedCPU": "4",
        "EstimatedMemory": "8Gi",
    },
    visibility = ["//visibility:public"],
    x_defs = {
        "github.com/carverauto/serviceradar/go/pkg/agent.ReleaseSigningPublicKey": "{STABLE_AGENT_RELEASE_PUBLIC_KEY}",
        "github.com/carverauto/serviceradar/go/cmd/agent.Version": FULL_VERSION,
    },
)

go_test(
    name = "agent_test",
    srcs = ["main_test.go"],
    embed = [":agent_lib"],
)
