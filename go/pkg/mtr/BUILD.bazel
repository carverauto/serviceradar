load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mtr",
    srcs = [
        "dns.go",
        "hop.go",
        "mpls.go",
        "options.go",
        "socket.go",
        "socket_darwin.go",
        "socket_linux.go",
        "socket_unsupported.go",
        "tracer.go",
    ],
    importpath = "github.com/carverauto/serviceradar/go/pkg/mtr",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/logger",
    ] + select({
        "@io_bazel_rules_go//go/platform:android": [
            "@org_golang_x_net//icmp",
        ],
        "@io_bazel_rules_go//go/platform:darwin": [
            "@org_golang_x_net//icmp",
        ],
        "@io_bazel_rules_go//go/platform:ios": [
            "@org_golang_x_net//icmp",
        ],
        "@io_bazel_rules_go//go/platform:linux": [
            "@org_golang_x_net//icmp",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "mtr_test",
    srcs = [
        "hop_test.go",
        "mpls_test.go",
        "options_test.go",
        "socket_test.go",
        "tracer_test.go",
    ],
    embed = [":mtr"],
    deps = ["//go/pkg/logger"],
)
