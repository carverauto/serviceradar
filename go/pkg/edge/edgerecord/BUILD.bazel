        "publication_identity.go",
        "recovery.go",
        "semantic.go",
        "sweep_labels.go",
        "uuidv7.go",
        "validate.go",
    ],
    importpath = "github.com/carverauto/serviceradar/go/pkg/edge/edgerecord",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/edge/v1:edgev1",
        "@com_github_klauspost_compress//zstd",
        "@org_golang_google_protobuf//encoding/protowire",
        "@org_golang_google_protobuf//proto",
