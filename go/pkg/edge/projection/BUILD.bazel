load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//build:go_test_inventory_test.bzl", "go_test_inventory_test")

go_library(
    name = "projection",
    srcs = ["projection.go"],
    importpath = "github.com/carverauto/serviceradar/go/pkg/edge/projection",
    visibility = ["//visibility:public"],
    deps = ["//proto/edge/v1:edgev1"],
)

go_test(
    name = "projection_test",
    srcs = ["projection_test.go"],
    embed = [":projection"],
    deps = ["//proto/edge/v1:edgev1"],
)

go_test_inventory_test(
    name = "test_inventory_test",
    srcs = glob(["*_test.go"]),
    target = ":projection_test",
    visibility = ["//visibility:public"],
)
