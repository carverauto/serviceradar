load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sender",
    srcs = ["lane.go"],
    importpath = "github.com/carverauto/serviceradar/go/pkg/edge/sender",
    visibility = ["//visibility:public"],
    deps = [
