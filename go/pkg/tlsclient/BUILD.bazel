load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tlsclient",
    srcs = ["tlsclient.go"],
    importpath = "github.com/carverauto/serviceradar/go/pkg/tlsclient",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_rs_zerolog//:zerolog",
