load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "cpufreq",
    srcs = [
        "collector.go",
        "hostfreq_bridge.h",
        "hostfreq_darwin.cc",
        "hostfreq_darwin.go",
        "hostfreq_darwin.mm",
        "hostfreq_darwin_nocgo.go",
        "hostfreq_other.go",
        # hostfreq_sampler.go and snapshot_clone.go are both //go:build darwin, and both were
        # missing while their siblings above were listed. Build constraints exclude them on
        # Linux, so the images were never affected, but on macOS `go build` compiled the
        # buffered sampler and Bazel did not.
        "hostfreq_sampler.go",
        "perf_linux.go",
        "perf_other.go",
        "snapshot_clone.go",
    ],
    cdeps = select({
        "@platforms//os:macos": [":hostfreq_darwin_cc"],
        "//conditions:default": [],
    }),
    cgo = True,
    clinkopts = select({
        "@io_bazel_rules_go//go/platform:darwin": [
            "-framework Foundation -framework IOKit -framework CoreFoundation -lIOReport",
        ],
        "@io_bazel_rules_go//go/platform:ios": [
            "-framework Foundation -framework IOKit -framework CoreFoundation -lIOReport",
        ],
        "//conditions:default": [],
    }),
    copts = select({
        "@io_bazel_rules_go//go/platform:darwin": [
            "-fobjc-arc",
        ],
        "@io_bazel_rules_go//go/platform:ios": [
            "-fobjc-arc",
        ],
        "//conditions:default": [],
    }),
    cxxopts = select({
        "@io_bazel_rules_go//go/platform:darwin": [
            "-std=c++20 -fobjc-arc -x objective-c++",
        ],
        "@io_bazel_rules_go//go/platform:ios": [
            "-std=c++20 -fobjc-arc -x objective-c++",
        ],
        "//conditions:default": [],
    }),
    importpath = "github.com/carverauto/serviceradar/go/pkg/cpufreq",
    deps = [
        "@com_github_shirou_gopsutil_v3//cpu",
    ] + select({
        "@io_bazel_rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "hostfreq_darwin_cc",
    srcs = ["hostfreq_darwin.cc"],
    hdrs = [
        "hostfreq_bridge.h",
        "hostfreq_darwin.mm",
    ],
    copts = [
        "-std=c++20",
        "-fobjc-arc",
        "-xobjective-c++",
    ],
    linkopts = [
        "-framework",
        "Foundation",
        "-framework",
        "IOKit",
        "-framework",
        "CoreFoundation",
        "-lIOReport",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "cpufreq_test",
    # hostfreq_sampler_test.go is //go:build darwin. Listed unconditionally because rules_go
    # applies build constraints to srcs, the same way //go/pkg/scan lists its
    # mmsghdr_linux_*.go files: it compiles on macOS and is skipped elsewhere. Without it, a
    # Mac developer's `go test` ran the sampler tests and `bazel test` silently did not.
    srcs = [
        "collector_test.go",
        "hostfreq_sampler_test.go",
    ],
    embed = [":cpufreq"],
    deps = [
        "@com_github_shirou_gopsutil_v3//cpu",
    ],
)
