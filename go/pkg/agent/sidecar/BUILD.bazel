load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sidecar",
    srcs = [
        "manager.go",
        "process_unix.go",
        "process_windows.go",
        "status_proto.go",
        "types.go",
    ],
    importpath = "github.com/carverauto/serviceradar/go/pkg/agent/sidecar",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/logger",
        "//proto",
        "@com_github_rs_zerolog//:zerolog",
    ],
)

go_test(
    name = "sidecar_test",
    srcs = [
        "manager_attach_test.go",
        "manager_test.go",
        "status_proto_test.go",
    ],
    embed = [":sidecar"],
    deps = [
        "@com_github_rs_zerolog//:zerolog",
    ],
)
