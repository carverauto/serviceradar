        "aggregator_internal_test.go",
        "aggregator_test.go",
        "client_conversion_test.go",
        "collector_test.go",
        "config_validate_for_agent_test.go",
        "service_deadlock_test.go",
        "service_test.go",
        "v3_client_test.go",
        "walk_test.go",
    ],
    embed = [":snmp"],
    embedsrcs = ["service.go"],
    deps = [
        "//go/pkg/logger",
        "//proto",
        "@com_github_gosnmp_gosnmp//:gosnmp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_mock//gomock",
    ],
