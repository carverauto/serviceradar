load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "snmp",
    srcs = [
        "aggregator.go",
        "client.go",
        "collector.go",
        "config.go",
        "errors.go",
        "interfaces.go",
        "mock_snmp.go",
        "service.go",
        "target_status.go",
        "testing.go",
        "types.go",
    ],
    importpath = "github.com/carverauto/serviceradar/go/pkg/agent/snmp",
    visibility = ["//go/pkg/agent:__pkg__"],
    deps = [
        "//go/pkg/agent/core",
