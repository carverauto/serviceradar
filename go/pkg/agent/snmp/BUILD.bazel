load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "snmp",
    srcs = [
        "aggregator.go",
        "client.go",
        "collector.go",
        "config.go",
        "errors.go",
        "interfaces.go",
        "mock_snmp.go",
        "service.go",
        "target_status.go",
        "testing.go",
        "types.go",
    ],
    importpath = "github.com/carverauto/serviceradar/go/pkg/agent/snmp",
    visibility = ["//go/pkg/agent:__pkg__"],
    deps = [
        "//go/pkg/agent/core",
        "//go/pkg/logger",
        "//go/pkg/models",
        "//proto",
        "@com_github_gosnmp_gosnmp//:gosnmp",
        "@org_uber_go_mock//gomock",
    ],
)

go_test(
    name = "snmp_test",
    srcs = [
        "aggregator_internal_test.go",
        "aggregator_test.go",
        "client_conversion_test.go",
        "collector_test.go",
        "config_validate_for_agent_test.go",
        "service_deadlock_test.go",
        "service_test.go",
        "v3_client_test.go",
        "walk_test.go",
    ],
    data = [":snmpv3_protocol_contract"],
    embed = [":snmp"],
    embedsrcs = ["service.go"],
    deps = [
        "//go/pkg/logger",
        "//proto",
        "@com_github_gosnmp_gosnmp//:gosnmp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_mock//gomock",
    ],
)

# The SNMPv3 security levels and protocols core offers in its forms, with the
# spelling core sends for each. This package's tests, //go/pkg/agent's,
# //go/pkg/mapper's and //elixir/serviceradar_core's all read it, so the names
# core offers and the names the Go side accepts cannot drift apart without one
# of them failing.
filegroup(
    name = "snmpv3_protocol_contract",
    srcs = ["testdata/snmpv3_protocol_contract.json"],
    visibility = [
        "//elixir/serviceradar_core:__pkg__",
        "//go/pkg/agent:__pkg__",
        "//go/pkg/mapper:__pkg__",
    ],
)
