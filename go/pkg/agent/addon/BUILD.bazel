load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "addon",
    srcs = [
        "artifacts.go",
        "credentials.go",
        "manager.go",
        "metric_feed.go",
        "resource_limits_linux.go",
        "resource_limits_other.go",
        "status_proto.go",
        "stream_backoff.go",
        "telemetry_env.go",
        "types.go",
    ],
    importpath = "github.com/carverauto/serviceradar/go/pkg/agent/addon",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/addon",
        "//go/pkg/logger",
        "//proto",
        "//proto/agent/addon/v1:addonpb",
        "@com_github_hashicorp_go_hclog//:go-hclog",
        "@com_github_hashicorp_go_plugin//:go-plugin",
        "@com_github_rs_zerolog//:zerolog",
    ],
)

go_test(
    name = "addon_test",
    srcs = [
        "artifacts_test.go",
        "credentials_test.go",
        "manager_rust_addon_test.go",
        "manager_test.go",
        "metric_feed_test.go",
        "resource_limits_linux_test.go",
        "status_proto_test.go",
        "telemetry_env_test.go",
        "telemetry_test.go",
    ],
    data = ["//go/cmd/serviceradar-sample-addon"],
    embed = [":addon"],
    env = {
        "SERVICERADAR_SAMPLE_ADDON_BIN": "$(rootpath //go/cmd/serviceradar-sample-addon)",
    },
    deps = [
        "//go/pkg/addon",
        "//proto/agent/addon/v1:addonpb",
        "@com_github_rs_zerolog//:zerolog",
    ],
)
