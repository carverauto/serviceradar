# Core-emitted add-on config_json contract fixtures (fj#4383). Generated by
# `cd elixir/serviceradar_core && mix serviceradar.gen.addon_contract_fixtures`
# and decoded with the real agent/add-on decoders by addon_config_contract_test.go
# here and by the Rust contract tests in rust/anomaly-addon, rust/otel-addon
# and rust/workload-identity (via compile_data).
filegroup(
    name = "addonconfig_contract_fixtures",
    srcs = glob(["testdata/addonconfig_contract/*.json"]),
    visibility = ["//visibility:public"],
)

# The two Go files ServiceRadar.Notifications.EdgeCommandContractTest reads at
# runtime to assert that the agent's notify capability, envelope schema, and
# credential injection modes still match what the Elixir manifest validator
# allows. `ex_unit_test` stages only srcs and data, so a test that opens a file
# outside its own project has to have it declared or it fails in the sandbox
# with a bare File.Error - which is what happened.
filegroup(
    name = "notification_contract_srcs",
    srcs = [
        "plugin_runtime.go",
        "plugin_runtime_notify.go",
    ],
    visibility = ["//visibility:public"],
)

go_benchmark(
    name = "agent_bench",
    binary = ":agent_test",
)
