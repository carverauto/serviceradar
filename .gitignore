# Elixir build and dependency output.
# No trailing slash on the deps/_build entries: a trailing slash matches
# directories only, so a *symlink* named deps -- the usual way an extra worktree
# borrows the primary clone's dependency tree -- sails past the rule and gets
# picked up by `git add -A`. One reached staging that way (038d2c24f2), where it
# pointed at an absolute path on one developer's machine and, in the primary
# clone, at itself.
elixir/**/_build
elixir/**/deps
elixir/**/.elixir_ls/
elixir/**/erl_crash.dump
elixir/**/priv/resource_snapshots/
elixir/**/priv/static/assets/

*.pdb

.venv
#.bin
.gemini/
.codex

